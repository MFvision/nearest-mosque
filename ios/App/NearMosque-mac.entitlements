<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Mac app (Mac Catalyst): sandboxed; network for online mosque search, downloads and maps; location
     for prayer times, the Qibla and nearby mosques; the keychain group shared with the widgets. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- Read only the folder the person picks in Settings, Import a pack. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- The app's identity, which the keychain group needs on macOS (signing for the App Store from an
	     ad hoc archive does not always add it, and macOS stops an app without it at launch). -->
	<key>com.apple.application-identifier</key>
	<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>com.apple.developer.team-identifier</key>
	<string>$(DEVELOPMENT_TEAM)</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(APP_BUNDLE_ID).shared</string>
	</array>
	<!-- The Adhan, the iqama and the reminders before the prayer come through a Focus and the Scheduled Summary. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
</dict>
</plist>

          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position sert, sur ce téléphone, aux horaires, à la qibla et aux mosquées proches. La recherche de mosquées n’envoie qu’une position approximative."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación se usa en este teléfono para los horarios, la alquibla y las mezquitas cercanas. La búsqueda de mezquitas solo envía una ubicación aproximada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше местоположение используется на этом телефоне для времени намазов, киблы и мечетей поблизости. Поиск мечетей отправляет только приблизительное местоположение."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার লোকেশন এই ফোনেই নামাজের সময়, কিবলা ও কাছের মসজিদের জন্য ব্যবহার হয়। মসজিদ সার্চে শুধু আনুমানিক লোকেশন পাঠানো হয়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موقعیت شما روی همین گوشی برای اوقات نماز، قبله و مسجدهای نزدیک استفاده می‌شود. جستجوی مسجد فقط موقعیت تقریبی را می‌فرستد."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "موقعیت شما روی همین موبایل برای اوقات نماز، قبله و مساجد نزدیک استفاده می‌شود. جستجوی مسجد فقط موقعیت تقریبی را می‌فرستد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的位置在此手机上用于礼拜时间、朝向和附近的清真寺。清真寺搜索只会发送大致位置。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लोकेशन इसी फ़ोन पर नमाज़ के समय, क़िबला और आसपास की मस्जिदों के लिए इस्तेमाल होती है। मस्जिद खोज सिर्फ़ अनुमानित लोकेशन भेजती है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua localização é usada neste celular para os horários de oração, a Qibla e as mesquitas próximas. A busca de mesquitas envia só uma localização aproximada."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana amfani da wurinku a wannan wayar don lokutan sallah, Alƙibla da masallatan da ke kusa. Binciken masallatai yana aika wuri na ƙiyasi kawai."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahali ulipo panatumika kwenye simu hii kwa nyakati za sala, Kibla na misikiti iliyo karibu. Utafutaji wa misikiti hutuma mahali pa makadirio tu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginagamit ang iyong lokasyon sa teleponong ito para sa mga oras ng dasal, ang Qibla at mga kalapit na masjid. Tinatayang lokasyon lang ang ipinapadala ng paghahanap ng masjid."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí của bạn được dùng trên điện thoại này cho giờ cầu nguyện, hướng Qibla và các thánh đường gần đó. Tìm kiếm thánh đường chỉ gửi đi vị trí gần đúng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตำแหน่งของคุณใช้บนโทรศัพท์นี้สำหรับเวลาละหมาด กิบลัต และมัสยิดใกล้เคียง การค้นหามัสยิดจะส่งเพียงตำแหน่งโดยประมาณ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទីតាំងរបស់អ្នកត្រូវបានប្រើនៅលើទូរសព្ទនេះ សម្រាប់ម៉ោងសឡាត គិបឡាត់ និងម៉ាស្ជិតក្បែរៗ។ ការស្វែងរកម៉ាស្ជិតផ្ញើតែទីតាំងប្រហាក់ប្រហែលប៉ុណ្ណោះ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئورنىڭىز مۇشۇ تېلېفوندا ناماز ۋاقىتلىرى، قىبلە ۋە يېقىن ئەتراپتىكى مەسچىتلەر ئۈچۈن ئىشلىتىلىدۇ. مەسچىت ئىزدەشتە پەقەت تەخمىنىي ئورۇنلا يوللىنىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "شوێنەکەت لەسەر ئەم مۆبایلە بۆ کاتەکانی نوێژ، قیبلە و مزگەوتە نزیکەکان بەکاردێت. بۆ گەڕانی مزگەوت تەنها شوێنێکی نزیکەیی دەنێردرێت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša lokacija se koristi na ovom telefonu za namaska vremena, kiblu i džamije u blizini. Pretraga džamija šalje samo približnu lokaciju."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша локација се користи на овом телефону за намаска времена, киблу и џамије у близини. Претрага џамија шаље само приближну локацију."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашата локација се користи на овој телефон за времињата за намаз, киблата и џамиите во близина. Пребарувањето џамии испраќа само приближна локација."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyzetedet ez a telefon használja az imaidőkhöz, a kiblához és a közeli mecsetekhez. A mecsetkeresés csak hozzávetőleges helyet küld el."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je locatie wordt op deze telefoon gebruikt voor gebedstijden, de qibla en moskeeën in de buurt. Bij het zoeken naar moskeeën wordt alleen een geschatte locatie verstuurd."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი მდებარეობა ამ ტელეფონზე გამოიყენება ლოცვის დროებისთვის, ყიბლისთვის და ახლომდებარე მეჩეთებისთვის. მეჩეთების ძიებისას იგზავნება მხოლოდ მიახლოებითი მდებარეობა."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සලාත වේලාවන්, කිබ්ලා සහ අසල පල්ලි සඳහා ඔබේ ස්ථානය මෙම දුරකථනයේ භාවිත වේ. පල්ලි සෙවුම සඳහා යවනු ලබන්නේ ආසන්න ස්ථානයක් පමණි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నమాజ్ సమయాలు, ఖిబ్లా, దగ్గరి మసీదుల కోసం మీ లొకేషన్ ఈ ఫోన్‌లోనే ఉపయోగించబడుతుంది. మసీదు శోధన కోసం సుమారు లొకేషన్ మాత్రమే పంపబడుతుంది."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಮಾಜ್ ಸಮಯಗಳು, ಕಿಬ್ಲಾ ಮತ್ತು ಹತ್ತಿರದ ಮಸೀದಿಗಳಿಗಾಗಿ ನಿಮ್ಮ ಸ್ಥಳವನ್ನು ಈ ಫೋನ್‌ನಲ್ಲೇ ಬಳಸಲಾಗುತ್ತದೆ. ಮಸೀದಿ ಹುಡುಕಾಟಕ್ಕಾಗಿ ಅಂದಾಜು ಸ್ಥಳವನ್ನು ಮಾತ್ರ ಕಳುಹಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നമസ്കാര സമയങ്ങൾ, ഖിബ്‌ല, അടുത്തുള്ള പള്ളികൾ എന്നിവയ്ക്കായി നിങ്ങളുടെ ലൊക്കേഷൻ ഈ ഫോണിൽ ഉപയോഗിക്കുന്നു. പള്ളി തിരയലിന് ഏകദേശ ലൊക്കേഷൻ മാത്രമേ അയയ്ക്കൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचे लोकेशन याच फोनवर नमाजच्या वेळा, किब्ला आणि जवळच्या मशिदींसाठी वापरले जाते. मशीद शोधासाठी फक्त अंदाजे लोकेशन पाठवले जाते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારું લોકેશન આ જ ફોન પર નમાઝના સમય, કિબ્લા અને નજીકની મસ્જિદો માટે વપરાય છે. મસ્જિદ શોધ માટે ફક્ત અંદાજિત લોકેશન મોકલાય છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡਾ ਟਿਕਾਣਾ ਇਸੇ ਫ਼ੋਨ ’ਤੇ ਨਮਾਜ਼ ਦੇ ਵਕਤਾਂ, ਕਿਬਲੇ ਅਤੇ ਨੇੜਲੀਆਂ ਮਸਜਿਦਾਂ ਲਈ ਵਰਤਿਆ ਜਾਂਦਾ ਹੈ। ਮਸਜਿਦ ਖੋਜ ਲਈ ਸਿਰਫ਼ ਅੰਦਾਜ਼ਨ ਟਿਕਾਣਾ ਭੇਜਿਆ ਜਾਂਦਾ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপোনাৰ অৱস্থান এই ফোনতে নামাজৰ সময়, কিবলা আৰু ওচৰৰ মছজিদৰ বাবে ব্যৱহাৰ কৰা হয়। মছজিদ সন্ধানত কেৱল আনুমানিক অৱস্থানহে পঠিওৱা হয়।"
          }
        }
      }
    },
    "NSAlarmKitUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings the Adhan and the Fajr alarm like an alarm, even on silent, with a Stop button."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسمع الأذان ومنبّه الفجر كالمنبّه حتى في الوضع الصامت، مع زر للإيقاف."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اذان اور فجر کا الارم الارم کی طرح بجاتا ہے، خاموش موڈ میں بھی، \"بند کریں\" بٹن کے ساتھ۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezanı ve sabah alarmını sessizde bile Durdur düğmesiyle alarm gibi çaldırır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membunyikan azan dan Alarm Subuh seperti alarm, bahkan saat senyap, dengan tombol Hentikan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait sonner l’adhan et l’alarme du Fajr comme une alarme, même en mode silencieux, avec un bouton Arrêter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hace sonar el adhan y la alarma del Fajr como una alarma, incluso en silencio, con un botón Detener."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает азан и будильник на фаджр как будильник, даже в беззвучном режиме, с кнопкой «Стоп»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজান ও ফজরের অ্যালার্ম অ্যালার্মের মতো বাজায়, সাইলেন্টেও, \"বন্ধ করুন\" বোতামসহ।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اذان و زنگ هشدار صبح را مثل زنگ هشدار به صدا درمی‌آورد، حتی در حالت بی‌صدا، با دکمهٔ توقف."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "اذان و الارم صبح را مثل الارم به صدا درمی‌آورد، حتی در حالت بی‌صدا، با دکمهٔ توقف."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让宣礼和晨礼闹钟像闹钟一样响起，即使在静音模式下也会响，并带有“停止”按钮。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अज़ान और फ़ज्र अलार्म को अलार्म की तरह बजाता है, साइलेंट पर भी, \"बंद करें\" बटन के साथ।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca o adhan e o alarme do Fajr como um alarme, mesmo no silencioso, com um botão Parar."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana kunna kiran sallah da ƙararrawar Asuba kamar ƙararrawa, ko da a yanayin shiru, tare da maɓallin Tsaya."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hulia Adhana na kengele ya Alfajiri kama kengele, hata simu ikiwa kimya, ikiwa na kitufe cha Simamisha."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pinatutunog ang Adhan at ang alarm sa Fajr na parang alarm, kahit naka-silent, may button na Ihinto."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổ chuông Adhan và báo thức Fajr như báo thức, kể cả khi im lặng, kèm nút Dừng."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้อะซานและนาฬิกาปลุกซุบฮิดังแบบนาฬิกาปลุก แม้อยู่ในโหมดเงียบ พร้อมปุ่มหยุด"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រោទ៍អាហ្សាន និងម៉ោងរោទ៍ស៊ូពុហ៍ដូចម៉ោងរោទ៍ សូម្បីតែពេលបិទសំឡេង ជាមួយប៊ូតុងបញ្ឈប់។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەزان ۋە بامدات ئويغاتقۇچىنى ئۈنسىز ھالەتتىمۇ توختىتىش كۇنۇپكىسى بىلەن ئويغاتقۇچتەك جىرىڭلىتىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بانگ و ئەلارمی بەیانی وەک ئەلارم لێدەدات، تەنانەت لە دۆخی بێدەنگیشدا، لەگەڵ دوگمەی ڕاگرتن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pušta ezan i alarm za sabah kao alarm, čak i u nečujnom režimu, s dugmetom Zaustavi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Пушта езан и аларм за сабах као аларм, чак и у нечујном режиму, са дугметом Заустави."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ги пушта езанот и алармот за сабах како аларм, дури и на тивок режим, со копче Запри."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az adhant és a Fadzsr-ébresztőt ébresztőként szólaltatja meg, néma módban is, Leállítás gombbal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de adhan en de Fajr-wekker als wekker klinken, ook op stil, met een stopknop."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აზანსა და ფაჯრის მაღვიძარას მაღვიძარასავით რეკავს, ჩუმ რეჟიმშიც, შეჩერების ღილაკით."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "අදාන් සහ ෆජ්ර් එලාමය එලාමයක් මෙන් නාද කරයි, නිහඬ ප්‍රකාරයේදී පවා, නැවැත්වීමේ බොත්තමක් සමඟ."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అజాన్‌ను, ఫజ్ర్ అలారంను అలారంలా మోగిస్తుంది, సైలెంట్‌లో ఉన్నా కూడా, ఆపు బటన్‌తో."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅಜಾನ್ ಮತ್ತು ಫಜ್ರ್ ಅಲಾರಂ ಅನ್ನು ಅಲಾರಂನಂತೆ ರಿಂಗ್ ಮಾಡುತ್ತದೆ, ಸೈಲೆಂಟ್‌ನಲ್ಲಿದ್ದರೂ ಸಹ, ನಿಲ್ಲಿಸುವ ಬಟನ್‌ನೊಂದಿಗೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ബാങ്കും സുബ്ഹ് അലാറവും അലാറം പോലെ മുഴക്കുന്നു, സൈലന്റിലും, നിർത്താനുള്ള ബട്ടണോടെ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजान आणि फजर अलार्म अलार्मसारखे वाजवते, सायलेंटवरही, \"बंद करा\" बटणासह."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "અઝાન અને ફજર એલાર્મને એલાર્મની જેમ વગાડે છે, સાયલન્ટ પર પણ, \"બંધ કરો\" બટન સાથે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਜ਼ਾਨ ਅਤੇ ਫ਼ਜਰ ਦੇ ਅਲਾਰਮ ਨੂੰ ਅਲਾਰਮ ਵਾਂਗ ਵਜਾਉਂਦਾ ਹੈ, ਸਾਈਲੈਂਟ ’ਤੇ ਵੀ, \"ਬੰਦ ਕਰੋ\" ਬਟਨ ਨਾਲ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আজান আৰু ফজৰৰ এলাৰ্ম এলাৰ্মৰ দৰে বজায়, ছাইলেণ্টতো, \"বন্ধ কৰক\" বুটামৰ সৈতে।"
          }
        }
      }
    }
  }
}

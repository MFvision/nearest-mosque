    "widget_kind_qibla_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Qibla direction from north for your city. Tap for the live compass."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتجاه القبلة من الشمال لمدينتك. اضغط لفتح البوصلة الحية."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے شہر کے لیے شمال سے قبلہ کی سمت۔ زندہ قطب نما کے لیے تھپتھپائیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şehriniz için kuzeyden kıble yönü. Canlı pusula için dokunun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arah kiblat dari utara untuk kota Anda. Ketuk untuk kompas langsung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La direction de la qibla depuis le nord pour votre ville. Touchez pour la boussole en direct."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección de la alquibla desde el norte para tu ciudad. Toca para la brújula en vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направление киблы от севера для вашего города. Нажмите, чтобы открыть компас."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার শহরের জন্য উত্তর থেকে কিবলার দিক। লাইভ কম্পাসের জন্য ট্যাপ করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جهت قبله از شمال برای شهر شما. برای قطب‌نمای زنده ضربه بزنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "جهت قبله از شمال برای شهر شما. برای قطب‌نمای زنده ضربه بزنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您所在城市从正北算起的朝向。轻点打开实时指南针。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके शहर के लिए उत्तर से क़िबला की दिशा। लाइव कंपास के लिए टैप करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A direção da qibla a partir do norte para a sua cidade. Toque para a bússola ao vivo."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanyar alƙibla daga arewa a garinku. Taɓa don kamfas kai tsaye."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwelekeo wa kibla kutoka kaskazini kwa mji wako. Gusa kwa dira hai."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang direksyon ng qibla mula sa hilaga para sa iyong lungsod. I-tap para sa live na compass."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng Qibla tính từ hướng bắc cho thành phố của bạn. Chạm để mở la bàn trực tiếp."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทิศกิบลัตจากทิศเหนือสำหรับเมืองของคุณ แตะเพื่อเปิดเข็มทิศสด"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទិសគិបឡាតពីទិសខាងជើងសម្រាប់ទីក្រុងរបស់អ្នក។ ចុចដើម្បីបើកត្រីវិស័យផ្ទាល់។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "شەھىرىڭىز ئۈچۈن شىمالدىن قىبلە يۆنىلىشى. جانلىق كومپاس ئۈچۈن چېكىڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئاراستەی قیبلە لە باکوورەوە بۆ شارەکەت. بۆ قیبلەنمای ڕاستەوخۆ دەستی لێ بدە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Smjer kible od sjevera za vaš grad. Dodirnite za kompas uživo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Смер кибле од севера за ваш град. Додирните за компас уживо."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Насоката на киблата од север за вашиот град. Допрете за компасот во живо."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A kibla iránya északtól a városában. Koppintson az élő iránytűért."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De qibla-richting vanaf het noorden voor uw stad. Tik voor het live kompas."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ყიბლის მიმართულება ჩრდილოეთიდან თქვენი ქალაქისთვის. შეეხეთ ცოცხალი კომპასისთვის."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ නගරයට උතුරේ සිට කිබ්ලා දිශාව. සජීවී මාලිමාව සඳහා තට්ටු කරන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ నగరానికి ఉత్తరం నుండి ఖిబ్లా దిశ. లైవ్ కంపాస్ కోసం నొక్కండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ನಗರಕ್ಕೆ ಉತ್ತರದಿಂದ ಕಿಬ್ಲಾ ದಿಕ್ಕು. ಲೈವ್ ದಿಕ್ಸೂಚಿಗಾಗಿ ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ നഗരത്തിന് വടക്കുനിന്നുള്ള ഖിബ്‌ല ദിശ. ലൈവ് കോമ്പസിനായി ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या शहरासाठी उत्तरेपासून किब्लाची दिशा. थेट होकायंत्रासाठी टॅप करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા શહેર માટે ઉત્તરથી કિબ્લાની દિશા. લાઇવ હોકાયંત્ર માટે ટૅપ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਸ਼ਹਿਰ ਲਈ ਉੱਤਰ ਤੋਂ ਕਿਬਲੇ ਦੀ ਦਿਸ਼ਾ। ਲਾਈਵ ਕੰਪਾਸ ਲਈ ਟੈਪ ਕਰੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপোনাৰ চহৰৰ বাবে উত্তৰৰ পৰা কিবলাৰ দিশ। লাইভ কম্পাছৰ বাবে টিপক।"
          }
        }
      }
    },

        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả năm lần cầu nguyện tại thành phố của bạn, kèm ngày và lần cầu nguyện tiếp theo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ละหมาดทั้งห้าเวลาของเมืองคุณ พร้อมวันที่และละหมาดถัดไป"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សឡាតទាំងប្រាំសម្រាប់ទីក្រុងរបស់អ្នក ព្រមទាំងកាលបរិច្ឆេទ និងសឡាតបន្ទាប់។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "شەھىرىڭىزدىكى بەش ۋاخ ناماز، چېسلا ۋە كېيىنكى ناماز بىلەن بىرگە."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەر پێنج نوێژی شارەکەت، لەگەڵ بەروار و نوێژی داهاتوو."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svih pet namaza za vaš grad, s datumom i sljedećim namazom."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Свих пет намаза за ваш град, са датумом и следећим намазом."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сите пет намази за вашиот град, со датумот и следниот намаз."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Városod mind az öt imája, a dátummal és a következő imával."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vijf gebeden voor je stad, met de datum en het volgende gebed."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი ქალაქის ხუთივე ლოცვა, თარიღით და შემდეგი ლოცვით."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ නගරයේ සලාත පහම, දිනය සහ ඊළඟ සලාතය සමඟ."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ నగరానికి ఐదు నమాజ్‌లు, తేదీ మరియు తదుపరి నమాజ్‌తో."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ನಗರದ ಎಲ್ಲಾ ಐದು ನಮಾಜ್‌ಗಳು, ದಿನಾಂಕ ಮತ್ತು ಮುಂದಿನ ನಮಾಜ್‌ನೊಂದಿಗೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ നഗരത്തിലെ അഞ്ച് നമസ്കാരങ്ങളും, തീയതിയും അടുത്ത നമസ്കാരവും സഹിതം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या शहरातील पाचही नमाज, तारीख आणि पुढच्या नमाजसह."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા શહેરની પાંચેય નમાઝ, તારીખ અને આગામી નમાઝ સાથે."

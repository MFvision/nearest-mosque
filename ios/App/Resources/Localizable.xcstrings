            "value": "جوابات آپ کے فون میں موجود کتابوں سے حوالے کے ساتھ آتے ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cevaplar telefonunuzdaki kitaplardan, ayet veya sayfa numarasıyla alıntı yapar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban mengutip buku di ponsel Anda, lengkap dengan ayat atau halaman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses citent les livres de votre téléphone, avec le verset ou la page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas citan los libros de tu teléfono, con el versículo o la página."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы цитируют книги на вашем телефоне с указанием страницы или аята."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তরে আপনার ফোনের বই থেকে পৃষ্ঠা বা আয়াতসহ উদ্ধৃতি থাকে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ‌ها از کتاب‌های روی گوشی شما با ذکر صفحه یا آیه نقل می‌شوند."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ‌ها از کتاب‌های روی موبایل شما با ذکر صفحه یا آیه نقل می‌شوند."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答会引用你手机上的书籍，并注明页码或经文。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाबों में आपके फ़ोन की किताबों से पेज या आयत के साथ उद्धरण होते हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas citam os livros do seu celular, com a página ou o versículo."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Amsoshi suna ɗauko daga littattafan da ke wayarku, tare da shafi ko aya."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Majibu yananukuu vitabu vilivyo kwenye simu yako, pamoja na ukurasa au aya."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinisipi ng mga sagot ang mga aklat sa iyong telepono, kasama ang pahina o talata."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời trích dẫn các sách trên điện thoại của bạn, kèm trang hoặc câu kinh."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบยกข้อความจากหนังสือในโทรศัพท์ของคุณ พร้อมหน้าหรืออายะฮ์"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចម្លើយដកស្រង់ពីសៀវភៅនៅលើទូរសព្ទរបស់អ្នក ជាមួយទំព័រ ឬអាយ៉ាត់។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "جاۋابلار تېلېفونىڭىزدىكى كىتابلاردىن بەت ياكى ئايەت نومۇرى بىلەن نەقىل كەلتۈرىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وەڵامەکان لە کتێبەکانی سەر مۆبایلەکەتەوە وەردەگیرێن، لەگەڵ لاپەڕە یان ئایەت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovori citiraju knjige na vašem telefonu, uz stranicu ili ajet."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговори цитирају књиге на вашем телефону, уз страницу или ајет."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговорите цитираат од книгите на вашиот телефон, со страница или ајет."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszok a telefonodon lévő könyvekből idéznek, oldal- vagy versszámmal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden citeren de boeken op je telefoon, met de pagina of het vers."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პასუხები ციტირებს თქვენს ტელეფონზე არსებულ წიგნებს, გვერდის ან აიათის მითითებით."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "පිළිතුරු ඔබේ දුරකථනයේ ඇති පොත්වලින් පිටුව හෝ ආයතය සමඟ උපුටා දක්වයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమాధానాలు మీ ఫోన్‌లోని పుస్తకాలను పేజీ లేదా ఆయత్‌తో సహా ఉటంకిస్తాయి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉತ್ತರಗಳು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ ಪುಸ್ತಕಗಳನ್ನು ಪುಟ ಅಥವಾ ಆಯತ್‌ನೊಂದಿಗೆ ಉಲ್ಲೇಖಿಸುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉത്തരങ്ങൾ നിങ്ങളുടെ ഫോണിലെ പുസ്തകങ്ങളിൽ നിന്ന് പേജോ ആയത്തോ സഹിതം ഉദ്ധരിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्तरांमध्ये तुमच्या फोनवरील पुस्तकांमधील उतारे पान किंवा आयतसह दिलेले असतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જવાબોમાં તમારા ફોન પરનાં પુસ્તકોમાંથી પાના કે આયત સાથે અવતરણ હોય છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਵਾਬ ਤੁਹਾਡੇ ਫ਼ੋਨ ਦੀਆਂ ਕਿਤਾਬਾਂ ਤੋਂ ਸਫ਼ੇ ਜਾਂ ਆਇਤ ਸਮੇਤ ਹਵਾਲਾ ਦਿੰਦੇ ਹਨ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তৰত আপোনাৰ ফোনত থকা কিতাপৰ পৰা পৃষ্ঠা বা আয়াতসহ উদ্ধৃতি থাকে।"
          }
        }
      }
    },

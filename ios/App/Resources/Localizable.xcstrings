    "alerts_ramadan_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhoor 45 minutes before Fajr, iftar at Maghrib. Only during Ramadan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السحور قبل الفجر بـ45 دقيقة والإفطار عند المغرب، في رمضان فقط."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سحری فجر سے 45 منٹ پہلے، افطار مغرب پر۔ صرف رمضان میں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahur imsaktan 45 dk önce, iftar akşam ezanında. Yalnızca Ramazan'da."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahur 45 menit sebelum Subuh, iftar saat Magrib. Hanya selama Ramadan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhour 45 minutes avant Fajr, iftar au Maghrib. Seulement pendant le Ramadan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhur 45 minutos antes del Fajr, iftar en el Magrib. Solo en Ramadán."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сухур за 45 минут до фаджра, ифтар в магриб. Только в Рамадан."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেহরি ফজরের 45 মিনিট আগে, ইফতার মাগরিবে। শুধু রমজানে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سحری ۴۵ دقیقه پیش از اذان صبح، افطار به وقت مغرب. فقط در ماه رمضان."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "سحری ۴۵ دقیقه پیش از اذان صبح، افطار به وقت شام. فقط در ماه رمضان."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "封斋饭在晨礼前 45 分钟，开斋在昏礼时。仅限斋月期间。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहरी फ़ज्र से 45 मिनट पहले, इफ़्तार मग़रिब पर। सिर्फ़ रमज़ान में।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhoor 45 minutos antes do Fajr, iftar no Maghrib. Só durante o Ramadã."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahur minti 45 kafin Asuba, buɗa baki a Magariba. A lokacin Ramadan kawai."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Daku dakika 45 kabla ya Alfajiri, futari wakati wa Magharibi. Wakati wa Ramadhani tu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhoor 45 minuto bago ang Fajr, iftar sa Maghrib. Tuwing Ramadan lang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhoor 45 phút trước Fajr, iftar vào giờ Maghrib. Chỉ trong tháng Ramadan."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สะฮูร 45 นาทีก่อนซุบฮิ อิฟฏอร์เมื่อถึงมัฆริบ เฉพาะช่วงรอมฎอน"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សាហួរ 45 នាទីមុនស៊ូពុហ៍ អ៊ីហ្វតារនៅម៉ាហ្គ្រិប។ តែក្នុងខែរ៉ាម៉ាដនប៉ុណ្ណោះ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "سەھەرلىك بامداتتىن 45 مىنۇت بۇرۇن، ئىپتار شام ۋاقتىدا. پەقەت رامىزاندىلا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پارشێو ٤٥ خولەک پێش بەیانی، بەربانگ لە کاتی ئێوارە. تەنها لە ڕەمەزاندا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehur 45 minuta prije sabaha, iftar u vrijeme akšama. Samo tokom ramazana."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сехур 45 минута пре сабаха, ифтар у време акшама. Само током рамазана."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сехур 45 минути пред сабах, ифтар на акшам. Само во Рамазан."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Szahúr 45 perccel a fadzsr előtt, iftár maghribkor. Csak ramadánban."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Suhoor 45 minuten voor Fajr, iftar bij Maghrib. Alleen tijdens de ramadan."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "სუჰური ფაჯრამდე 45 წუთით ადრე, იფთარი მაღრიბზე. მხოლოდ რამადანის დროს."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ෆජ්ර්ට මිනිත්තු 45 කට පෙර සහර්, මග්රිබ්හිදී ඉෆ්තාර්. රමළාන් කාලයේ පමණි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫజ్ర్‌కు 45 నిమిషాల ముందు సహరీ, మగ్రిబ్‌కు ఇఫ్తార్. రంజాన్‌లో మాత్రమే."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫಜ್ರ್‌ಗೆ 45 ನಿಮಿಷ ಮೊದಲು ಸಹರಿ, ಮಗ್ರಿಬ್‌ಗೆ ಇಫ್ತಾರ್. ರಮಝಾನ್‌ನಲ್ಲಿ ಮಾತ್ರ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സുബ്ഹിന് 45 മിനിറ്റ് മുമ്പ് അത്താഴം, മഗ്‌രിബിന് നോമ്പുതുറ. റമദാനിൽ മാത്രം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सहरी फजरच्या 45 मिनिटे आधी, इफ्तार मगरिबला. फक्त रमजानमध्ये."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સેહરી ફજરના 45 મિનિટ પહેલાં, ઇફ્તાર મગરિબે. ફક્ત રમઝાન દરમિયાન."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਹਿਰੀ ਫ਼ਜਰ ਤੋਂ 45 ਮਿੰਟ ਪਹਿਲਾਂ, ਇਫ਼ਤਾਰ ਮਗ਼ਰਿਬ ’ਤੇ। ਸਿਰਫ਼ ਰਮਜ਼ਾਨ ਦੌਰਾਨ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "ছেহৰী ফজৰৰ 45 মিনিট আগতে, ইফতাৰ মাগৰিবত। কেৱল ৰমজানৰ সময়ত।"
          }
        }
      }
    },

    "reminder_friday_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dhuhr is at %1$@. Time to get ready for the Friday prayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الظهر الساعة %1$@. حان وقت الاستعداد لصلاة الجمعة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ظہر %1$@ پر ہے۔ جمعہ کی نماز کی تیاری کا وقت ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öğle %1$@'de. Cuma namazına hazırlanma vakti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuhur pukul %1$@. Saatnya bersiap untuk salat Jumat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dhuhr est à %1$@. Il est temps de se préparer pour la prière du vendredi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Dhuhr es a las %1$@. Es hora de prepararse para la oración del viernes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зухр в %1$@. Пора готовиться к пятничному намазу."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোহর %1$@-এ। জুমার নামাজের প্রস্তুতির সময় হয়েছে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ظهر ساعت %1$@ است. وقت آماده شدن برای نماز جمعه است."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز پیشین ساعت %1$@ است. وقت آماده شدن برای نماز جمعه است."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "晌礼在 %1$@。该为主麻礼拜做准备了。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़ुहर %1$@ बजे है। जुमे की नमाज़ की तैयारी का समय है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Dhuhr é às %1$@. Hora de se preparar para a oração de sexta-feira."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Azahar da ƙarfe %1$@ ne. Lokaci ya yi na shirya wa sallar Juma'a."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Adhuhuri ni saa %1$@. Ni wakati wa kujiandaa kwa sala ya Ijumaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Dhuhr ay sa %1$@. Oras na para maghanda para sa dasal sa Biyernes."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dhuhr lúc %1$@. Đã đến lúc chuẩn bị cho buổi cầu nguyện thứ Sáu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซุฮ์รีเวลา %1$@ ถึงเวลาเตรียมตัวสำหรับละหมาดวันศุกร์"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ហ្សូហ៊ួរនៅម៉ោង %1$@។ ដល់ពេលត្រៀមខ្លួនសម្រាប់សឡាតថ្ងៃសុក្រហើយ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "پېشىن سائەت %1$@ دە. جۈمە نامىزىغا تەييارلىنىش ۋاقتى بولدى."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نوێژی نیوەڕۆ کاتژمێر %1$@ دەبێت. کاتی خۆئامادەکردنە بۆ نوێژی هەینی."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podne je u %1$@. Vrijeme je da se spremite za džuma-namaz."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Подне је у %1$@. Време је да се спремите за џума-намаз."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пладне е во %1$@. Време е да се подготвите за џума-намазот."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A zuhr %1$@-kor van. Ideje készülődni a pénteki imára."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dhuhr is om %1$@. Tijd om je klaar te maken voor het vrijdaggebed."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზუჰრი %1$@-ზეა. დროა მოემზადოთ პარასკევის ლოცვისთვის."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ළුහර් %1$@ ට. ජුම්ආ සලාතයට සූදානම් වීමට කාලයයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "జుహర్ %1$@ కి. జుమా నమాజ్‌కు సిద్ధం కావడానికి సమయం."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಝುಹರ್ %1$@ ಕ್ಕೆ. ಜುಮಾ ನಮಾಜ್‌ಗೆ ಸಿದ್ಧರಾಗುವ ಸಮಯ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ളുഹ്ർ %1$@-ന്. ജുമുഅ നമസ്കാരത്തിന് ഒരുങ്ങാൻ സമയമായി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जोहर %1$@ वाजता आहे. जुम्माच्या नमाजची तयारी करण्याची वेळ झाली."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઝોહર %1$@ વાગ્યે છે. જુમ્માની નમાઝની તૈયારી કરવાનો સમય છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜ਼ੁਹਰ %1$@ ਵਜੇ ਹੈ। ਜੁੰਮੇ ਦੀ ਨਮਾਜ਼ ਦੀ ਤਿਆਰੀ ਦਾ ਵਕਤ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "যোহৰ %1$@ বজাত। জুমাৰ নামাজৰ বাবে সাজু হোৱাৰ সময় হৈছে।"
          }
        }
      }
    },

        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नक्शे की पृष्ठभूमि के लिए इंटरनेट चाहिए। सूची ऑफ़लाइन चलती है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O fundo do mapa precisa de internet. A lista funciona offline."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayan taswirar yana buƙatar intanet. Jerin yana aiki ba tare da intanet ba."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mandharinyuma ya ramani yanahitaji intaneti. Orodha inafanya kazi bila intaneti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng internet ang background ng mapa. Gumagana offline ang listahan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nền bản đồ cần internet. Danh sách vẫn hoạt động ngoại tuyến."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พื้นหลังแผนที่ต้องใช้อินเทอร์เน็ต รายการใช้งานออฟไลน์ได้"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្ទៃខាងក្រោយផែនទីត្រូវការអ៊ីនធឺណិត។ បញ្ជីដំណើរការក្រៅបណ្ដាញ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "خەرىتە ئارقا كۆرۈنۈشى ئۈچۈن تور كېرەك. تىزىملىك تورسىز ئىشلەيدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "باکگراوندی نەخشە پێویستی بە ئینتەرنێتە. لیستەکە بێ ئینتەرنێت کار دەکات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozadini mape je potreban internet. Lista radi bez interneta."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Позадини мапе је потребан интернет. Листа ради ван мреже."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "За позадината на мапата е потребен интернет. Списокот работи без интернет."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A térkép háttere internetet igényel. A lista internet nélkül is működik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kaartachtergrond heeft internet nodig. De lijst werkt offline."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რუკის ფონს ინტერნეტი სჭირდება. სია ოფლაინ მუშაობს."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සිතියමේ පසුබිමට අන්තර්ජාලය අවශ්‍යයි. ලැයිස්තුව නොබැඳිව ක්‍රියා කරයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మ్యాప్ నేపథ్యానికి ఇంటర్నెట్ అవసరం. జాబితా ఆఫ్‌లైన్‌లో పనిచేస్తుంది."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಕ್ಷೆಯ ಹಿನ್ನೆಲೆಗೆ ಇಂಟರ್ನೆಟ್ ಬೇಕು. ಪಟ್ಟಿ ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "മാപ്പിന്റെ പശ്ചാത്തലത്തിന് ഇന്റർനെറ്റ് വേണം. പട്ടിക ഓഫ്‌ലൈനായി പ്രവർത്തിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नकाशाच्या पार्श्वभूमीसाठी इंटरनेट लागते. यादी ऑफलाइन चालते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નકશાની પૃષ્ઠભૂમિ માટે ઇન્ટરનેટ જોઈએ. યાદી ઑફલાઇન ચાલે છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਕਸ਼ੇ ਦੇ ਪਿਛੋਕੜ ਲਈ ਇੰਟਰਨੈੱਟ ਚਾਹੀਦਾ ਹੈ। ਸੂਚੀ ਆਫ਼ਲਾਈਨ ਕੰਮ ਕਰਦੀ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "মানচিত্ৰৰ পটভূমিৰ বাবে ইণ্টাৰনেট লাগে। তালিকাখন অফলাইনত চলে।"
          }
        }
      }
    },
    "map_offline_plot": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline view: direction and distance from the search point. Not a street map."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض دون إنترنت: الاتجاه والمسافة من نقطة البحث، وليس خريطة شوارع."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آف لائن منظر: تلاش کے مقام سے سمت اور فاصلہ۔ یہ گلیوں کا نقشہ نہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrim dışı görünüm: arama noktasından yön ve mesafe. Sokak haritası değildir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan offline: arah dan jarak dari titik pencarian. Bukan peta jalan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vue hors ligne : direction et distance depuis le point de recherche. Pas un plan des rues."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista sin conexión: dirección y distancia desde el punto de búsqueda. No es un callejero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн-вид: направление и расстояние от точки поиска. Это не карта улиц."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অফলাইন দৃশ্য: খোঁজার জায়গা থেকে দিক ও দূরত্ব। এটি রাস্তার মানচিত্র নয়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نمای آفلاین: جهت و فاصله از نقطه جستجو. نقشه خیابان‌ها نیست."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "نمای آفلاین: جهت و فاصله از نقطه جستجو. نقشه سرک‌ها نیست."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线视图：显示与搜索点的方向和距离，不是街道地图。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन दृश्य: खोज की जगह से दिशा और दूरी। यह सड़कों का नक्शा नहीं है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualização offline: direção e distância a partir do ponto de busca. Não é um mapa de ruas."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duba ba tare da intanet ba: shiyya da nisa daga wurin bincike. Ba taswirar tituna ba ce."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwonekano bila intaneti: mwelekeo na umbali kutoka mahali pa utafutaji. Si ramani ya barabara."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline na view: direksyon at layo mula sa punto ng paghahanap. Hindi ito mapa ng kalye."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ ngoại tuyến: hướng và khoảng cách từ điểm tìm kiếm. Không phải bản đồ đường phố."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มุมมองออฟไลน์: ทิศทางและระยะทางจากจุดค้นหา ไม่ใช่แผนที่ถนน"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទិដ្ឋភាពក្រៅបណ្ដាញ៖ ទិស និងចម្ងាយពីចំណុចស្វែងរក។ មិនមែនផែនទីផ្លូវទេ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "تورسىز كۆرۈنۈش: ئىزدەش نۇقتىسىدىن يۆنىلىش ۋە ئارىلىق. كوچا خەرىتىسى ئەمەس."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشاندانی ئۆفلاین: ئاراستە و دووری لە خاڵی گەڕانەکەوە. نەخشەی شەقام نییە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaz bez interneta: smjer i udaljenost od tačke pretrage. Nije mapa ulica."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Приказ ван мреже: смер и удаљеност од тачке претраге. Није мапа улица."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приказ без интернет: насока и растојание од точката на пребарување. Не е улична мапа."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline nézet: irány és távolság a keresési ponttól. Nem utcatérkép."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline weergave: richting en afstand vanaf het zoekpunt. Geen stratenkaart."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოფლაინ ხედი: მიმართულება და მანძილი ძიების წერტილიდან. ეს ქუჩების რუკა არ არის."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "නොබැඳි දසුන: සෙවුම් ස්ථානයේ සිට දිශාව සහ දුර. මෙය වීදි සිතියමක් නොවේ."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆఫ్‌లైన్ వీక్షణ: వెతికిన ప్రదేశం నుండి దిశ, దూరం. ఇది వీధి మ్యాప్ కాదు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಫ್‌ಲೈನ್ ನೋಟ: ಹುಡುಕಾಟದ ಸ್ಥಳದಿಂದ ದಿಕ್ಕು ಮತ್ತು ದೂರ. ಇದು ರಸ್ತೆ ನಕ್ಷೆ ಅಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓഫ്‌ലൈൻ കാഴ്ച: തിരയൽ സ്ഥലത്തുനിന്നുള്ള ദിശയും ദൂരവും. ഇത് തെരുവ് മാപ്പല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफलाइन दृश्य: शोधाच्या ठिकाणापासून दिशा आणि अंतर. हा रस्त्यांचा नकाशा नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઑફલાઇન દૃશ્ય: શોધની જગ્યાથી દિશા અને અંતર. આ રસ્તાઓનો નકશો નથી."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਫ਼ਲਾਈਨ ਦ੍ਰਿਸ਼: ਖੋਜ ਵਾਲੀ ਥਾਂ ਤੋਂ ਦਿਸ਼ਾ ਅਤੇ ਦੂਰੀ। ਇਹ ਗਲੀਆਂ ਦਾ ਨਕਸ਼ਾ ਨਹੀਂ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "অফলাইন দৃশ্য: সন্ধানৰ ঠাইৰ পৰা দিশ আৰু দূৰত্ব। এইটো পথৰ মানচিত্ৰ নহয়।"
          }
        }
      }
    },

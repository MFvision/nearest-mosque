    "onb_setup_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your language and where to calculate prayer times. You can change both in Settings."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لغتك والمكان الذي تُحسب له المواقيت. يمكنك تغييرهما من الإعدادات."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی زبان اور وہ مقام منتخب کریں جس کے لیے اوقات حساب ہوں۔ دونوں ترتیبات میں بدل سکتے ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dilinizi ve vakitlerin hesaplanacağı yeri seçin. İkisini de Ayarlar’dan değiştirebilirsiniz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih bahasa dan lokasi untuk menghitung waktu salat. Keduanya bisa diubah di Pengaturan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre langue et le lieu de calcul des horaires. Vous pourrez les modifier dans les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu idioma y dónde calcular los horarios. Puedes cambiar ambos en Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите язык и место для расчёта времени намазов. И то и другое можно изменить в настройках."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ভাষা বেছে নিন এবং কোন জায়গার জন্য নামাজের সময় হিসাব হবে তা বেছে নিন। দুটোই সেটিংসে বদলাতে পারবেন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زبان خود و محل محاسبه اوقات نماز را انتخاب کنید. هر دو را می‌توانید در تنظیمات تغییر دهید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "زبان خود و محل محاسبه اوقات نماز را انتخاب کنید. هر دو را می‌توانید در تنظیمات تغییر دهید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你的语言以及计算礼拜时间的地点。两者都可以在设置中更改。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी भाषा चुनें और यह भी कि नमाज़ के समय किस जगह के लिए निकाले जाएँ। आप दोनों को सेटिंग्स में बदल सकते हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha seu idioma e onde calcular os horários de oração. Você pode alterar os dois em Configurações."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaɓi harshenku da wurin da za a lissafa lokutan sallah. Kuna iya canza duka biyun a Saituna."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua lugha yako na mahali pa kuhesabu nyakati za sala. Unaweza kubadilisha vyote viwili kwenye Mipangilio."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin ang iyong wika at kung saan kakalkulahin ang mga oras ng dasal. Maaari mong baguhin ang dalawa sa Mga Setting."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ngôn ngữ và nơi tính giờ cầu nguyện. Bạn có thể đổi cả hai trong Cài đặt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกภาษาและสถานที่สำหรับคำนวณเวลาละหมาด คุณเปลี่ยนทั้งสองอย่างได้ในการตั้งค่า"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ជ្រើសរើសភាសារបស់អ្នក និងកន្លែងសម្រាប់គណនាម៉ោងសឡាត។ អ្នកអាចប្ដូរទាំងពីរនៅក្នុងការកំណត់។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "تىلىڭىزنى ۋە ناماز ۋاقتى ھېسابلىنىدىغان جاينى تاللاڭ. ھەر ئىككىسىنى تەڭشەكتە ئۆزگەرتەلەيسىز."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "زمانەکەت و شوێنی هەژمارکردنی کاتەکانی نوێژ هەڵبژێرە. دەتوانیت هەردووکیان لە ڕێکخستنەکان بگۆڕیت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite jezik i mjesto za proračun namaskih vremena. Oboje možete promijeniti u postavkama."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Изаберите језик и место за прорачун намаских времена. Обоје можете променити у подешавањима."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете јазик и место за пресметување на времињата за намаз. И двете можете да ги промените во поставките."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Válaszd ki a nyelvet és azt a helyet, ahol az imaidőket számolni kell. Mindkettőt módosíthatod a Beállításokban."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je taal en waar de gebedstijden voor berekend worden. Je kunt beide wijzigen in Instellingen."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "აირჩიეთ ენა და ადგილი, რომლისთვისაც ლოცვის დროები გამოითვლება. ორივეს შეცვლა პარამეტრებში შეგიძლიათ."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ භාෂාව සහ සලාත වේලාවන් ගණනය කළ යුතු ස්ථානය තෝරන්න. දෙකම සැකසීම්වල වෙනස් කළ හැක."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ భాషను, నమాజ్ సమయాలు ఎక్కడి కోసం లెక్కించాలో ఎంచుకోండి. రెండింటినీ సెట్టింగ్‌లలో మార్చవచ్చు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಭಾಷೆ ಮತ್ತು ನಮಾಜ್ ಸಮಯಗಳನ್ನು ಎಲ್ಲಿಗಾಗಿ ಲೆಕ್ಕಹಾಕಬೇಕು ಎಂಬುದನ್ನು ಆಯ್ಕೆಮಾಡಿ. ಎರಡನ್ನೂ ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಬದಲಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഭാഷയും നമസ്കാര സമയങ്ങൾ എവിടേക്ക് കണക്കാക്കണമെന്നും തിരഞ്ഞെടുക്കുക. രണ്ടും ക്രമീകരണങ്ങളിൽ മാറ്റാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची भाषा निवडा आणि नमाजच्या वेळा कोणत्या ठिकाणासाठी मोजायच्या तेही निवडा. तुम्ही दोन्ही सेटिंग्जमध्ये बदलू शकता."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ભાષા પસંદ કરો અને નમાઝના સમય કઈ જગ્યા માટે ગણવા તે પણ પસંદ કરો. તમે બંને સેટિંગ્સમાં બદલી શકો છો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੀ ਭਾਸ਼ਾ ਚੁਣੋ ਅਤੇ ਇਹ ਵੀ ਕਿ ਨਮਾਜ਼ ਦੇ ਵਕਤ ਕਿਸ ਥਾਂ ਲਈ ਗਿਣੇ ਜਾਣ। ਦੋਵੇਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਬਦਲੇ ਜਾ ਸਕਦੇ ਹਨ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপোনাৰ ভাষা বাছক আৰু কোন ঠাইৰ বাবে নামাজৰ সময় গণনা কৰিব সেয়াও বাছক। দুয়োটা ছেটিংছত সলনি কৰিব পাৰিব।"
          }
        }
      }
    },

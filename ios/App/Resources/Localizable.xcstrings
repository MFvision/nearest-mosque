    "hours_unverified_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listed hours come from map data and may be out of date. Prayer congregation times are not included."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأوقات المدرجة من بيانات الخريطة وقد تكون قديمة، ولا تشمل أوقات إقامة الجماعة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درج اوقات نقشے کے ڈیٹا سے ہیں اور پرانے ہو سکتے ہیں۔ جماعت کے اوقات شامل نہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı saatler harita verisinden gelir ve eski olabilir. Cemaat vakitleri dahil değildir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jam tercatat berasal dari data peta dan mungkin usang. Waktu salat berjamaah tidak termasuk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horaires issus des données cartographiques, peut-être anciens. Les horaires de la prière en commun ne sont pas inclus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El horario procede de datos del mapa y puede estar desactualizado. No incluye los horarios de oración en congregación."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часы работы взяты из картографических данных и могут быть устаревшими. Время коллективных намазов не указано."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তালিকাভুক্ত সময় মানচিত্রের ডেটা থেকে নেওয়া এবং পুরোনো হতে পারে। জামাতের সময় এতে নেই।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعات ثبت‌شده از داده‌های نقشه است و ممکن است قدیمی باشد. اوقات نماز جماعت در آن نیست."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعات ثبت‌شده از معلومات نقشه است و ممکن است قدیمی باشد. اوقات نماز جماعت در آن نیست."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所列时间来自地图数据，可能已过时。不包含集体礼拜时间。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्ज समय नक्शे के डेटा से लिए गए हैं और पुराने हो सकते हैं। जमाअत के समय शामिल नहीं हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário informado vem dos dados do mapa e pode estar desatualizado. Os horários das orações em congregação não estão incluídos."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokutan da aka rubuta sun fito daga bayanan taswira kuma suna iya zama tsofaffi. Ba a haɗa lokutan sallar jam'i ba."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Saa zilizoorodheshwa zinatoka kwenye data ya ramani na huenda zimepitwa na wakati. Nyakati za sala ya jamaa hazijajumuishwa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Galing sa datos ng mapa ang nakalistang oras at maaaring luma na. Hindi kasama ang oras ng sama-samang pagdarasal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ được ghi lấy từ dữ liệu bản đồ và có thể đã cũ. Không bao gồm giờ cầu nguyện tập thể."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาที่ระบุมาจากข้อมูลแผนที่และอาจไม่เป็นปัจจุบัน ไม่รวมเวลาละหมาดญะมาอะฮ์"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ោងដែលបានចុះមកពីទិន្នន័យផែនទី ហើយអាចហួសសម័យ។ មិនរួមបញ្ចូលម៉ោងសឡាតរួមគ្នាទេ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "خاتىرىلەنگەن ۋاقىتلار خەرىتە سانلىق مەلۇماتىدىن ئېلىنغان، كونىراپ قالغان بولۇشى مۇمكىن. جامائەت ناماز ۋاقىتلىرى ئۇنىڭ ئىچىدە ئەمەس."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کاتە تۆمارکراوەکان لە زانیاری نەخشەوە دێن و لەوانەیە کۆن بن. کاتەکانی نوێژی بە کۆمەڵ تێدا نییە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Navedeno radno vrijeme potiče iz podataka mape i možda nije ažurno. Vremena zajedničkog namaza nisu uključena."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведено радно време потиче из података мапе и можда није ажурно. Времена заједничког намаза нису укључена."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наведеното работно време доаѓа од податоците на мапата и можеби не е ажурно. Времињата за заеднички намаз не се вклучени."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megadott nyitvatartás térképadatokból származik, és elavult lehet. A közös imák időpontjai nem szerepelnek benne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermelde tijden komen uit kaartgegevens en kunnen verouderd zijn. Tijden van het gezamenlijk gebed staan er niet bij."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მითითებული საათები რუკის მონაცემებიდანაა და შეიძლება მოძველებული იყოს. ჯამაათით ლოცვის დროები არ შედის."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සඳහන් වේලාවන් සිතියම් දත්තවලින් ලැබුණු ඒවා වන අතර යල් පැනගිය ඒවා විය හැක. ජමාඅත් වේලාවන් ඇතුළත් නැත."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పేర్కొన్న సమయాలు మ్యాప్ డేటా నుండి వచ్చాయి, పాతవి కావచ్చు. జమాత్ సమయాలు చేర్చబడలేదు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪಟ್ಟಿ ಮಾಡಿದ ಸಮಯಗಳು ನಕ್ಷೆಯ ಡೇಟಾದಿಂದ ಬಂದಿವೆ ಮತ್ತು ಹಳೆಯದಾಗಿರಬಹುದು. ಜಮಾಅತ್ ಸಮಯಗಳನ್ನು ಸೇರಿಸಲಾಗಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "രേഖപ്പെടുത്തിയ സമയങ്ങൾ മാപ്പ് ഡാറ്റയിൽ നിന്നുള്ളതാണ്, പഴയതാകാം. ജമാഅത്ത് സമയങ്ങൾ ഉൾപ്പെടുത്തിയിട്ടില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नोंदवलेल्या वेळा नकाशाच्या डेटामधून घेतल्या आहेत आणि जुन्या असू शकतात. जमातच्या वेळा समाविष्ट नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નોંધાયેલ સમય નકશાના ડેટામાંથી છે અને જૂના હોઈ શકે છે. જમાતના સમય શામેલ નથી."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦਰਜ ਸਮਾਂ ਨਕਸ਼ੇ ਦੇ ਡਾਟਾ ਤੋਂ ਹੈ ਅਤੇ ਪੁਰਾਣਾ ਹੋ ਸਕਦਾ ਹੈ। ਜਮਾਤ ਦੇ ਵਕਤ ਸ਼ਾਮਲ ਨਹੀਂ ਹਨ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "তালিকাভুক্ত সময় মানচিত্ৰৰ তথ্যৰ পৰা লোৱা আৰু পুৰণি হ'ব পাৰে। জামাতৰ সময় অন্তৰ্ভুক্ত নহয়।"
          }
        }
      }
    },

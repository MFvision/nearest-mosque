    "onb_ask_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers quote the Qur’an with the verse reference, so you can always check the source."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقتبس الإجابات من القرآن مع رقم الآية، لتتحقق من المصدر دائمًا."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جوابات قرآن سے آیت کے حوالے کے ساتھ اقتباس دیتے ہیں تاکہ آپ ہمیشہ ماخذ دیکھ سکیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cevaplar Kur’an’dan ayet numarasıyla alıntı yapar; kaynağı her zaman kontrol edebilirsiniz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban mengutip Al-Qur’an beserta nomor ayatnya, sehingga Anda selalu bisa memeriksa sumbernya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses citent le Coran avec la référence du verset, pour que vous puissiez toujours vérifier la source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas citan el Corán con la referencia de la aleya, para que siempre puedas comprobar la fuente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы цитируют Коран со ссылкой на аят, поэтому источник всегда можно проверить."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তরে আয়াতের রেফারেন্সসহ কুরআন থেকে উদ্ধৃতি থাকে, তাই আপনি সবসময় উৎস যাচাই করতে পারেন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ‌ها از قرآن با ذکر نشانی آیه نقل می‌شوند تا همیشه بتوانید منبع را بررسی کنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ‌ها از قرآن با ذکر نشانی آیه نقل می‌شوند تا همیشه بتوانید منبع را بررسی کنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答会引用古兰经并注明经文出处，你随时可以核对来源。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाबों में क़ुरआन का उद्धरण आयत के हवाले के साथ होता है, ताकि आप हमेशा स्रोत जाँच सकें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas citam o Alcorão com a referência do versículo, para você sempre poder conferir a fonte."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Amsoshi suna ɗauko daga Alƙur'ani tare da lambar aya, don ku iya duba tushen a kowane lokaci."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Majibu yananukuu Qur'ani pamoja na namba ya aya, ili uweze kukagua chanzo kila wakati."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinisipi ng mga sagot ang Qur'an kasama ang sanggunian ng talata, kaya lagi mong masusuri ang pinagmulan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời trích dẫn Qur’an kèm số câu kinh, để bạn luôn có thể kiểm tra nguồn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบยกข้อความจากอัลกุรอานพร้อมเลขอายะฮ์ คุณจึงตรวจสอบแหล่งที่มาได้เสมอ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចម្លើយដកស្រង់ពីគម្ពីរគូរ៉ាន ជាមួយលេខយោងអាយ៉ាត់ ដូច្នេះអ្នកអាចពិនិត្យប្រភពបានជានិច្ច។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "جاۋابلار قۇرئاندىن ئايەت نومۇرى بىلەن نەقىل كەلتۈرىدۇ، شۇڭا مەنبەنى ھەمىشە تەكشۈرەلەيسىز."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وەڵامەکان لە قورئانەوە وەردەگیرێن لەگەڵ ئاماژە بە ئایەتەکە، بۆ ئەوەی هەمیشە بتوانیت سەرچاوەکە بپشکنیت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovori citiraju Kur'an s oznakom ajeta, pa uvijek možete provjeriti izvor."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговори цитирају Кур'ан са ознаком ајета, па увек можете проверити извор."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговорите цитираат од Куранот со ознака на ајетот, па секогаш можете да го проверите изворот."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszok a Koránból idéznek, versszámmal, így a forrást mindig ellenőrizheted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden citeren de Koran met de versverwijzing, zodat je de bron altijd kunt controleren."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პასუხები ყურანს ციტირებს აიათის მითითებით, ასე რომ წყაროს ყოველთვის შეამოწმებთ."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "පිළිතුරු ආයත් යොමුව සමඟ කුර්ආනය උපුටා දක්වයි, එබැවින් ඔබට සැමවිටම මූලාශ්‍රය පරීක්ෂා කළ හැක."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమాధానాలు ఖురాన్‌ను ఆయత్ సూచనతో ఉటంకిస్తాయి, కాబట్టి మీరు ఎప్పుడైనా మూలాన్ని సరిచూసుకోవచ్చు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉತ್ತರಗಳು ಕುರ್‌ಆನ್ ಅನ್ನು ಆಯತ್ ಉಲ್ಲೇಖದೊಂದಿಗೆ ಉದ್ಧರಿಸುತ್ತವೆ, ಆದ್ದರಿಂದ ನೀವು ಯಾವಾಗಲೂ ಮೂಲವನ್ನು ಪರಿಶೀಲಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉത്തരങ്ങൾ ആയത്ത് നമ്പർ സഹിതം ഖുർആൻ ഉദ്ധരിക്കുന്നു, അതിനാൽ നിങ്ങൾക്ക് എപ്പോഴും ഉറവിടം പരിശോധിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्तरांमध्ये कुरआनचे उतारे आयतच्या संदर्भासह असतात, त्यामुळे तुम्ही नेहमी स्रोत तपासू शकता."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જવાબોમાં કુરઆનનાં અવતરણ આયતના સંદર્ભ સાથે હોય છે, જેથી તમે હંમેશાં સ્રોત ચકાસી શકો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਵਾਬ ਆਇਤ ਦੇ ਹਵਾਲੇ ਸਮੇਤ ਕੁਰਆਨ ਦਾ ਹਵਾਲਾ ਦਿੰਦੇ ਹਨ, ਤਾਂ ਜੋ ਤੁਸੀਂ ਹਮੇਸ਼ਾ ਸਰੋਤ ਜਾਂਚ ਸਕੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তৰত আয়াতৰ উল্লেখসহ কোৰআনৰ উদ্ধৃতি থাকে, যাতে আপুনি সদায় উৎস পৰীক্ষা কৰিব পাৰে।"
          }
        }
      }
    },

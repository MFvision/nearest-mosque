        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីៗទាំងអស់នៅទីនេះដំណើរការដោយគ្មានអ៊ីនធឺណិត។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ يەردىكى ھەممىسى تورسىز ئىشلەيدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەموو شتێک لێرە بێ ئینتەرنێت کار دەکات."

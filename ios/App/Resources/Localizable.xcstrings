    "widget_kind_next_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next prayer, its countdown and today's times."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصلاة القادمة وعدّها التنازلي ومواقيت اليوم."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگلی نماز، اس کی الٹی گنتی اور آج کے اوقات۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki namaz, geri sayımı ve bugünün vakitleri."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Salat berikutnya, hitung mundurnya, dan jadwal hari ini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prochaine prière, son compte à rebours et les horaires du jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La próxima oración, su cuenta atrás y los horarios de hoy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующий намаз, обратный отсчёт и время намазов на сегодня."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরবর্তী নামাজ, তার কাউন্টডাউন ও আজকের সময়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز بعدی، شمارش معکوس آن و اوقات امروز."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز بعدی، شمارش معکوس آن و اوقات نماز امروز."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下一次礼拜、倒计时及今日礼拜时间。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली नमाज़, उसकी उलटी गिनती और आज के समय।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A próxima oração, sua contagem regressiva e os horários de hoje."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sallah ta gaba, ƙidayarta da lokutan sallah na yau."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala ijayo, hesabu yake ya kurudi nyuma na nyakati za leo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang susunod na dasal, ang countdown nito at ang mga oras ngayong araw."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần cầu nguyện tiếp theo, đếm ngược và các giờ cầu nguyện hôm nay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ละหมาดถัดไป การนับถอยหลัง และเวลาละหมาดวันนี้"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សឡាតបន្ទាប់ ការរាប់ថយក្រោយ និងម៉ោងសឡាតថ្ងៃនេះ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "كېيىنكى ناماز، تەتۈر ساناق ۋە بۈگۈنكى ناماز ۋاقىتلىرى."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نوێژی داهاتوو، ژمێرەری پێچەوانەکەی و کاتەکانی نوێژی ئەمڕۆ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sljedeći namaz, odbrojavanje do njega i današnja namaska vremena."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Следећи намаз, одбројавање до њега и данашња намаска времена."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Следниот намаз, одбројувањето до него и денешните времиња за намаз."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő ima, a visszaszámlálás és a mai imaidők."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het volgende gebed, de aftelling ernaartoe en de gebedstijden van vandaag."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შემდეგი ლოცვა, მისი უკუთვლა და დღევანდელი ლოცვის დროები."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඊළඟ සලාතය, එයට ඉතිරි කාලය සහ අද සලාත වේලාවන්."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తదుపరి నమాజ్, దాని కౌంట్‌డౌన్ మరియు ఈరోజు సమయాలు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದಿನ ನಮಾಜ್, ಅದರ ಕ್ಷಣಗಣನೆ ಮತ್ತು ಇಂದಿನ ಸಮಯಗಳು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്ത നമസ്കാരം, അതിന്റെ കൗണ്ട്ഡൗൺ, ഇന്നത്തെ സമയങ്ങൾ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुढची नमाज, तिचे काउंटडाउन आणि आजच्या वेळा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આગામી નમાઝ, તેનું કાઉન્ટડાઉન અને આજના સમય."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਗਲੀ ਨਮਾਜ਼, ਉਸ ਦੀ ਉਲਟੀ ਗਿਣਤੀ ਅਤੇ ਅੱਜ ਦੇ ਵਕਤ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "পৰৱৰ্তী নামাজ, ইয়াৰ কাউণ্টডাউন আৰু আজিৰ সময়।"
          }
        }
      }
    },

    "ai_language_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device writing isn’t available in this language. Showing quotes instead."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتابة على الجهاز غير متاحة بهذه اللغة، لذا تُعرض الاقتباسات."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس زبان میں فون پر لکھائی دستیاب نہیں، اس لیے اقتباسات دکھائے جا رہے ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dilde cihaz içi yazım yok. Bunun yerine alıntılar gösteriliyor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penulisan di perangkat tidak tersedia dalam bahasa ini. Menampilkan kutipan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La rédaction sur l’appareil n’existe pas dans cette langue. Citations affichées à la place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La redacción en el dispositivo no está disponible en este idioma. Se muestran citas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Составление ответов на устройстве недоступно на этом языке. Показываем цитаты."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভাষায় অন-ডিভাইস লেখা সম্ভব নয়। এর বদলে উদ্ধৃতি দেখানো হচ্ছে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نوشتن روی گوشی به این زبان در دسترس نیست. به‌جای آن نقل‌قول‌ها نمایش داده می‌شوند."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "نوشتن روی موبایل به این زبان در دسترس نیست. به‌جای آن نقل‌قول‌ها نمایش داده می‌شوند."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此语言暂不支持设备端撰写，改为显示引文。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस भाषा में ऑन-डिवाइस लेखन उपलब्ध नहीं है। इसके बजाय उद्धरण दिखाए जा रहे हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A escrita no aparelho não está disponível neste idioma. Mostrando citações."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubutu a cikin na'ura ba ya samuwa a wannan harshe. Ana nuna ɗaukar magana a maimakon haka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uandishi kwenye kifaa haupatikani kwa lugha hii. Inaonyesha manukuu badala yake."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi available ang pagsulat sa device sa wikang ito. Mga sipi ang ipinapakita sa halip."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng viết trên thiết bị chưa hỗ trợ ngôn ngữ này. Đang hiển thị trích dẫn thay thế."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเขียนในเครื่องยังไม่รองรับภาษานี้ จึงแสดงข้อความอ้างอิงแทน"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការសរសេរលើឧបករណ៍មិនមានសម្រាប់ភាសានេះទេ។ កំពុងបង្ហាញសម្រង់ជំនួសវិញ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ تىلدا ئۈسكۈنىدە يېزىش مۇمكىن ئەمەس. ئۇنىڭ ئورنىغا نەقىللەر كۆرسىتىلىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نووسین لەسەر ئامێر بەم زمانە بەردەست نییە. لە جیاتی ئەوە وەرگیراوەکان پیشان دەدرێن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisanje na uređaju nije dostupno na ovom jeziku. Prikazujemo citate."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Писање на уређају није доступно на овом језику. Приказујемо цитате."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пишувањето на уредот не е достапно на овој јазик. Наместо тоа прикажуваме цитати."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközön történő szövegírás ezen a nyelven nem érhető el. Helyette idézeteket mutatunk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijven op het apparaat is niet beschikbaar in deze taal. In plaats daarvan worden citaten getoond."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოწყობილობაზე წერა ამ ენაზე მიუწვდომელია. სანაცვლოდ ნაჩვენებია ციტატები."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම භාෂාවෙන් උපාංගයේ ලිවීම නොමැත. ඒ වෙනුවට උපුටා දැක්වීම් පෙන්වමින්."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ భాషలో ఆన్-డివైస్ రచన అందుబాటులో లేదు. బదులుగా ఉల్లేఖనలను చూపిస్తోంది."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಭಾಷೆಯಲ್ಲಿ ಸಾಧನದಲ್ಲೇ ಬರವಣಿಗೆ ಲಭ್ಯವಿಲ್ಲ. ಬದಲಿಗೆ ಉಲ್ಲೇಖಗಳನ್ನು ತೋರಿಸಲಾಗುತ್ತಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ഭാഷയിൽ ഉപകരണത്തിലെ എഴുത്ത് ലഭ്യമല്ല. പകരം ഉദ്ധരണികൾ കാണിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या भाषेत ऑन-डिव्हाइस लेखन उपलब्ध नाही. त्याऐवजी उतारे दाखवत आहोत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ભાષામાં ઑન-ડિવાઇસ લેખન ઉપલબ્ધ નથી. તેના બદલે અવતરણો બતાવી રહ્યા છીએ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਭਾਸ਼ਾ ਵਿੱਚ ਫ਼ੋਨ ’ਤੇ ਲਿਖਾਈ ਉਪਲਬਧ ਨਹੀਂ। ਇਸ ਦੀ ਥਾਂ ਹਵਾਲੇ ਦਿਖਾਏ ਜਾ ਰਹੇ ਹਨ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভাষাত অন-ডিভাইচ লিখন উপলব্ধ নহয়। তাৰ সলনি উদ্ধৃতি দেখুওৱা হৈছে।"
          }
        }
      }
    },
    "ai_pack_not_installed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device AI isn’t available on this phone yet. You still get answers that quote your books."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكاء على الجهاز غير متاح على هذا الهاتف بعد، وستحصل مع ذلك على إجابات تقتبس من كتبك."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون پر AI ابھی دستیاب نہیں۔ پھر بھی آپ کو کتابوں کے حوالوں والے جوابات ملیں گے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz içi yapay zekâ bu telefonda henüz yok. Yine de kitaplarınızdan alıntı yapan cevaplar alırsınız."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI di perangkat belum tersedia di ponsel ini. Anda tetap mendapat jawaban yang mengutip buku Anda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’IA sur l’appareil n’est pas encore disponible ici. Vous recevez quand même des réponses citant vos livres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA en el dispositivo aún no está disponible aquí. Igualmente recibirás respuestas que citan tus libros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ИИ на устройстве пока недоступен на этом телефоне. Вы всё равно получаете ответы с цитатами из ваших книг."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অন-ডিভাইস AI এখনো এই ফোনে নেই। তবুও আপনি আপনার বই থেকে উদ্ধৃতিসহ উত্তর পাবেন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هوش مصنوعی روی گوشی هنوز روی این گوشی در دسترس نیست. همچنان پاسخ‌هایی با نقل از کتاب‌هایتان دریافت می‌کنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "هوش مصنوعی روی موبایل هنوز روی این موبایل در دسترس نیست. همچنان پاسخ‌هایی با نقل از کتاب‌هایتان دریافت می‌کنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此手机暂不支持设备端 AI。你仍可获得引用书籍的回答。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑन-डिवाइस AI अभी इस फ़ोन पर उपलब्ध नहीं है। फिर भी आपको आपकी किताबों के उद्धरणों वाले जवाब मिलते रहेंगे।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA no aparelho ainda não está disponível neste celular. Você continua recebendo respostas que citam seus livros."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "AI a cikin na'ura ba ta samu a wannan wayar ba tukuna. Har yanzu kuna samun amsoshin da ke ɗauko daga littattafanku."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ya kwenye kifaa bado haipatikani kwenye simu hii. Bado utapata majibu yanayonukuu vitabu vyako."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa available ang AI sa device sa teleponong ito. Makakakuha ka pa rin ng mga sagot na sumisipi sa iyong mga aklat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI trên thiết bị chưa khả dụng trên điện thoại này. Bạn vẫn nhận được câu trả lời trích dẫn sách của bạn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ในเครื่องยังไม่พร้อมใช้งานในโทรศัพท์นี้ คุณยังได้รับคำตอบที่ยกข้อความจากหนังสือของคุณ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "AI លើឧបករណ៍មិនទាន់មាននៅលើទូរសព្ទនេះនៅឡើយទេ។ អ្នកនៅតែទទួលបានចម្លើយដែលដកស្រង់ពីសៀវភៅរបស់អ្នក។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئۈسكۈنىدىكى سۈنئىي ئەقىل بۇ تېلېفوندا تېخى يوق. كىتابلىرىڭىزدىن نەقىل كەلتۈرىدىغان جاۋابلارغا يەنىلا ئېرىشىسىز."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "زیرەکی دەستکردی سەر ئامێر هێشتا لەسەر ئەم مۆبایلە بەردەست نییە. هێشتا وەڵام وەردەگریت کە لە کتێبەکانتەوە وەرگیراون."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "AI na uređaju još nije dostupan na ovom telefonu. I dalje dobijate odgovore koji citiraju vaše knjige."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI на уређају још није доступан на овом телефону. И даље добијате одговоре који цитирају ваше књиге."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "AI на уредот сè уште не е достапна на овој телефон. Сепак добивате одговори што цитираат од вашите книги."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eszközön futó MI még nem érhető el ezen a telefonon. A könyveidből idéző válaszokat így is megkapod."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI op het apparaat is nog niet beschikbaar op deze telefoon. Je krijgt nog steeds antwoorden die je boeken citeren."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მოწყობილობაზე AI ამ ტელეფონზე ჯერ მიუწვდომელია. მაინც მიიღებთ პასუხებს, რომლებიც თქვენს წიგნებს ციტირებს."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "උපාංගයේ AI මෙම දුරකථනයේ තවම නොමැත. එසේ වුවද ඔබේ පොත් උපුටා දක්වන පිළිතුරු ඔබට ලැබේ."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఫోన్‌లో ఆన్-డివైస్ AI ఇంకా అందుబాటులో లేదు. అయినా మీ పుస్తకాలను ఉటంకించే సమాధానాలు మీకు లభిస్తాయి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಾಧನದಲ್ಲೇ AI ಈ ಫೋನ್‌ನಲ್ಲಿ ಇನ್ನೂ ಲಭ್ಯವಿಲ್ಲ. ಆದರೂ ನಿಮ್ಮ ಪುಸ್ತಕಗಳನ್ನು ಉಲ್ಲೇಖಿಸುವ ಉತ್ತರಗಳು ನಿಮಗೆ ಸಿಗುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉപകരണത്തിലെ AI ഈ ഫോണിൽ ഇതുവരെ ലഭ്യമല്ല. എങ്കിലും നിങ്ങളുടെ പുസ്തകങ്ങൾ ഉദ്ധരിക്കുന്ന ഉത്തരങ്ങൾ ലഭിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑन-डिव्हाइस AI अजून या फोनवर उपलब्ध नाही. तरीही तुम्हाला तुमच्या पुस्तकांमधील उतारे असलेली उत्तरे मिळतील."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઑન-ડિવાઇસ AI હજી આ ફોન પર ઉપલબ્ધ નથી. છતાં તમને તમારાં પુસ્તકોનાં અવતરણવાળા જવાબો મળતા રહેશે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਨ ’ਤੇ AI ਅਜੇ ਇਸ ਫ਼ੋਨ ’ਤੇ ਉਪਲਬਧ ਨਹੀਂ। ਫਿਰ ਵੀ ਤੁਹਾਨੂੰ ਤੁਹਾਡੀਆਂ ਕਿਤਾਬਾਂ ਦੇ ਹਵਾਲਿਆਂ ਵਾਲੇ ਜਵਾਬ ਮਿਲਣਗੇ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "অন-ডিভাইচ AI এতিয়াও এই ফোনত উপলব্ধ নহয়। তথাপি আপুনি আপোনাৰ কিতাপৰ উদ্ধৃতিসহ উত্তৰ পাব।"
          }
        }
      }
    },

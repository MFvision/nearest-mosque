    "sunrise_not_prayer_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunrise marks the end of Fajr time; it is not a prayer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشروق نهاية وقت الفجر، وليس صلاة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "طلوعِ آفتاب فجر کے وقت کا اختتام ہے، یہ نماز نہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneşin doğuşu imsak vaktinin sonudur; bir namaz değildir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terbit menandai akhir waktu Subuh; bukan waktu salat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lever du soleil marque la fin du Fajr ; ce n’est pas une prière."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El amanecer marca el fin de Fajr; no es una oración."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восход отмечает конец времени фаджра; это не намаз."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সূর্যোদয় ফজরের সময়ের শেষ নির্দেশ করে; এটি কোনো নামাজ নয়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "طلوع آفتاب پایان وقت نماز صبح است و خودش نماز نیست."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "طلوع آفتاب پایان وقت نماز صبح است و خودش نماز نیست."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日出标志着晨礼时间结束，它本身不是一次礼拜。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूर्योदय फ़ज्र के वक़्त का अंत है; यह कोई नमाज़ नहीं है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O nascer do sol marca o fim do horário do Fajr; não é uma oração."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitowar rana ita ce ƙarshen lokacin Asuba; ba sallah ba ce."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Macheo ni mwisho wa wakati wa Alfajiri; si sala."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pagsikat ng araw ang hudyat ng pagtatapos ng oras ng Fajr; hindi ito isang dasal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mặt trời mọc đánh dấu hết giờ Fajr; đây không phải là một lần cầu nguyện."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดวงอาทิตย์ขึ้นเป็นเครื่องหมายสิ้นสุดเวลาซุบฮิ ไม่ใช่เวลาละหมาด"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ថ្ងៃរះជាសញ្ញាបញ្ចប់ពេលស៊ូពុហ៍ វាមិនមែនជាសឡាតទេ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "كۈن چىقىش بامدات ۋاقتىنىڭ ئاخىرلاشقانلىقىنى بىلدۈرىدۇ؛ ئۇ ناماز ئەمەس."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "خۆرهەڵاتن کۆتایی کاتی نوێژی بەیانییە؛ خۆی نوێژ نییە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Izlazak sunca označava kraj vremena sabaha; to nije namaz."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Излазак сунца означава крај времена сабаха; то није намаз."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Изгрејсонцето го означува крајот на времето за сабах; тоа не е намаз."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A napkelte a fadzsr idejének végét jelzi; nem ima."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonsopgang markeert het einde van de Fajr-tijd; het is geen gebed."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მზის ამოსვლა ფაჯრის დროის დასასრულს ნიშნავს; ეს ლოცვა არ არის."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "හිරු උදාව ෆජ්ර් වේලාවේ අවසානය සලකුණු කරයි; එය සලාතයක් නොවේ."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సూర్యోదయం ఫజ్ర్ సమయం ముగింపును సూచిస్తుంది; అది నమాజ్ కాదు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸೂರ್ಯೋದಯವು ಫಜ್ರ್ ಸಮಯದ ಅಂತ್ಯವನ್ನು ಸೂಚಿಸುತ್ತದೆ; ಅದು ನಮಾಜ್ ಅಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "സൂര്യോദയം സുബ്ഹിന്റെ സമയത്തിന്റെ അവസാനമാണ്; അതൊരു നമസ്കാരമല്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सूर्योदयाला फजरची वेळ संपते; ही नमाज नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૂર્યોદય ફજરના સમયનો અંત છે; તે નમાઝ નથી."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸੂਰਜ ਚੜ੍ਹਨਾ ਫ਼ਜਰ ਦੇ ਵਕਤ ਦਾ ਅੰਤ ਹੈ; ਇਹ ਨਮਾਜ਼ ਨਹੀਂ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "সূৰ্যোদয়ে ফজৰৰ সময়ৰ শেষ বুজায়; ই কোনো নামাজ নহয়।"
          }
        }
      }
    },

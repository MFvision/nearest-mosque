    "online_offline_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’re offline. Showing downloaded mosques only."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل. تُعرض المساجد المحمّلة فقط."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ آف لائن ہیں۔ صرف ڈاؤن لوڈ کردہ مساجد دکھائی جا رہی ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısınız. Yalnızca indirilen camiler gösteriliyor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sedang offline. Hanya masjid yang diunduh yang ditampilkan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne. Seules les mosquées téléchargées sont affichées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Solo se muestran las mezquitas descargadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет подключения. Показаны только загруженные мечети."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অফলাইনে আছেন। শুধু ডাউনলোড করা মসজিদ দেখানো হচ্ছে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آفلاین هستید. فقط مسجدهای دانلودشده نمایش داده می‌شوند."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "آفلاین هستید. فقط مساجد دانلودشده نمایش داده می‌شوند."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你处于离线状态，仅显示已下载的清真寺。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। सिर्फ़ डाउनलोड की गई मस्जिदें दिखाई जा रही हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está offline. Mostrando só as mesquitas baixadas."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba ku da intanet. Ana nuna masallatan da aka sauke kawai."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huna intaneti. Inaonyesha misikiti iliyopakuliwa tu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline ka. Mga na-download na masjid lang ang ipinapakita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đang ngoại tuyến. Chỉ hiển thị các thánh đường đã tải về."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณออฟไลน์อยู่ แสดงเฉพาะมัสยิดที่ดาวน์โหลดไว้"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកកំពុងនៅក្រៅបណ្ដាញ។ កំពុងបង្ហាញតែម៉ាស្ជិតដែលបានទាញយកប៉ុណ្ណោះ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "تورسىز ھالەتتىسىز. پەقەت چۈشۈرۈلگەن مەسچىتلەرلا كۆرسىتىلىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "تۆ ئۆفلاینیت. تەنها مزگەوتە داگیراوەکان پیشان دەدرێن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Niste na internetu. Prikazuju se samo preuzete džamije."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ван мреже сте. Приказују се само преузете џамије."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не сте поврзани на интернет. Се прикажуваат само преземените џамии."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs internetkapcsolat. Csak a letöltött mecsetek látszanak."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent offline. Alleen gedownloade moskeeën worden getoond."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ოფლაინ ხართ. ნაჩვენებია მხოლოდ ჩამოტვირთული მეჩეთები."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ නොබැඳිව සිටී. බාගත කළ පල්ලි පමණක් පෙන්වමින්."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఆఫ్‌లైన్‌లో ఉన్నారు. డౌన్‌లోడ్ చేసిన మసీదులను మాత్రమే చూపిస్తోంది."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿದ್ದೀರಿ. ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಮಸೀದಿಗಳನ್ನು ಮಾತ್ರ ತೋರಿಸಲಾಗುತ್ತಿದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഓഫ്‌ലൈനാണ്. ഡൗൺലോഡ് ചെയ്ത പള്ളികൾ മാത്രം കാണിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही ऑफलाइन आहात. फक्त डाउनलोड केलेल्या मशिदी दाखवत आहोत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ઑફલાઇન છો. ફક્ત ડાઉનલોડ કરેલી મસ્જિદો બતાવી રહ્યા છીએ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਸੀਂ ਆਫ਼ਲਾਈਨ ਹੋ। ਸਿਰਫ਼ ਡਾਊਨਲੋਡ ਕੀਤੀਆਂ ਮਸਜਿਦਾਂ ਦਿਖਾਈਆਂ ਜਾ ਰਹੀਆਂ ਹਨ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপুনি অফলাইন আছে। কেৱল ডাউনলোড কৰা মছজিদ দেখুওৱা হৈছে।"
          }
        }
      }
    },

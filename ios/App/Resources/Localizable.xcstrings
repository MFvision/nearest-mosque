    "widget_kind_ask_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question, or tap one of today's suggestions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطرح سؤالك، أو اضغط أحد اقتراحات اليوم."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سوال پوچھیں، یا آج کی تجاویز میں سے کسی ایک پر ٹیپ کریں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir soru sorun veya bugünün önerilerinden birine dokunun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajukan pertanyaan, atau ketuk salah satu saran hari ini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question ou touchez l'une des suggestions du jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pregunta o toca una de las sugerencias de hoy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте вопрос или нажмите на одну из подсказок дня."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রশ্ন করুন, অথবা আজকের পরামর্শগুলোর একটিতে ট্যাপ করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سؤال خود را بپرسید یا روی یکی از پیشنهادهای امروز بزنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "سوال خود را بپرسید یا روی یکی از پیشنهادهای امروز ضربه بزنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提出问题，或点按今日推荐的问题之一。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सवाल पूछें, या आज के सुझावों में से किसी एक पर टैप करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta ou toque em uma das sugestões de hoje."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi tambaya, ko ka taɓa ɗaya daga cikin shawarwarin yau."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uliza swali, au gusa mojawapo ya mapendekezo ya leo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magtanong, o i-tap ang isa sa mga mungkahi ngayong araw."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt câu hỏi hoặc chạm vào một gợi ý hôm nay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามคำถาม หรือแตะคำถามแนะนำของวันนี้"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សួរសំណួរ ឬចុចលើសំណួរណែនាំមួយសម្រាប់ថ្ងៃនេះ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "سوئال سوراڭ ياكى بۈگۈنكى تەۋسىيەلەرنىڭ بىرىنى بېسىڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پرسیارێک بکە، یان دەست بنێ بە یەکێک لە پێشنیارەکانی ئەمڕۆ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Postavite pitanje ili dodirnite jedan od današnjih prijedloga."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставите питање или додирните један од данашњих предлога."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставете прашање или допрете еден од денешните предлози."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegyél fel egy kérdést, vagy koppints a mai javaslatok egyikére."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een vraag of tik op een van de suggesties van vandaag."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დასვით კითხვა ან შეეხეთ დღის ერთ-ერთ შეთავაზებას."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ප්‍රශ්නයක් අහන්න, නැතහොත් අද යෝජනාවලින් එකක් තට්ටු කරන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక ప్రశ్న అడగండి, లేదా ఈరోజు సూచనల్లో ఒకదానిపై నొక్కండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪ್ರಶ್ನೆ ಕೇಳಿ, ಅಥವಾ ಇಂದಿನ ಸಲಹೆಗಳಲ್ಲಿ ಒಂದನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു ചോദ്യം ചോദിക്കൂ, അല്ലെങ്കിൽ ഇന്നത്തെ നിർദ്ദേശങ്ങളിൽ ഒന്നിൽ ടാപ്പ് ചെയ്യൂ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रश्न विचारा, किंवा आजच्या सूचनांपैकी एकावर टॅप करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સવાલ પૂછો, અથવા આજનાં સૂચનોમાંથી કોઈ એક પર ટૅપ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਵਾਲ ਪੁੱਛੋ, ਜਾਂ ਅੱਜ ਦੇ ਸੁਝਾਵਾਂ ਵਿੱਚੋਂ ਕਿਸੇ ਇੱਕ 'ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "প্ৰশ্ন সোধক, নাইবা আজিৰ পৰামৰ্শবোৰৰ এটাত টেপ কৰক।"
          }
        }
      }
    },

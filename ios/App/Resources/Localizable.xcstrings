            "state": "translated",
            "value": "నమాజ్ సమయాల కోసం లొకేషన్"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಮಾಜ್ ಸಮಯಗಳಿಗಾಗಿ ಸ್ಥಳ"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നമസ്കാര സമയങ്ങൾക്കുള്ള ലൊക്കേഷൻ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नमाजच्या वेळांसाठी लोकेशन"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નમાઝના સમય માટે લોકેશન"
          }

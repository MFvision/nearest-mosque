    "intent_show_qibla_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Near Mosque on the Qibla direction."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح تطبيق أقرب مسجد على اتجاه القبلة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریبی مسجد ایپ کو قبلہ کی سمت پر کھولتا ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque’u kıble yönünde açar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Near Mosque pada arah kiblat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Near Mosque sur la direction de la qibla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Near Mosque en la dirección de la alquibla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Near Mosque на направлении киблы."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque কিবলার দিকে খোলে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامهٔ نزدیک‌ترین مسجد را روی جهت قبله باز می‌کند."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامهٔ نزدیک‌ترین مسجد را روی جهت قبله باز می‌کند."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在朝向页面打开 Near Mosque。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque को क़िबला की दिशा पर खोलता है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Near Mosque na direção da qibla."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana buɗe Near Mosque a kan hanyar alƙibla."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hufungua Near Mosque kwenye mwelekeo wa kibla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binubuksan ang Near Mosque sa direksyon ng qibla."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Near Mosque ở hướng Qibla."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Near Mosque ที่ทิศกิบลัต"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើក Near Mosque នៅទិសគិបឡាត។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "«ئەڭ يېقىن مەسچىت» نى قىبلە يۆنىلىشىدە ئاچىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەپی نزیکترین مزگەوت لەسەر ئاراستەی قیبلە دەکاتەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara Near Mosque na smjeru kible."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвара Near Mosque на смеру кибле."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Го отвора Near Mosque на насоката на киблата."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja az Near Mosque alkalmazást a kibla irányánál."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Near Mosque op de qibla-richting."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხსნის Near Mosque-ს ყიბლის მიმართულებაზე."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque කිබ්ලා දිශාවෙන් විවෘත කරයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque ను ఖిబ్లా దిశలో తెరుస్తుంది."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque ಅನ್ನು ಕಿಬ್ಲಾ ದಿಕ್ಕಿನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque ഖിബ്‌ല ദിശയിൽ തുറക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque किब्लाच्या दिशेवर उघडते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque ને કિબ્લાની દિશા પર ખોલે છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque ਨੂੰ ਕਿਬਲੇ ਦੀ ਦਿਸ਼ਾ ’ਤੇ ਖੋਲ੍ਹਦਾ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque কিবলাৰ দিশত খোলে।"
          }
        }
      }
    },

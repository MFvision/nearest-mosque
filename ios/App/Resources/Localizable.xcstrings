          "stringUnit": {
            "state": "translated",
            "value": "As cinco orações da sua cidade, com a data e a próxima oração."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Salloli biyar na garinku, tare da kwanan wata da sallah ta gaba."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sala zote tano za mji wako, pamoja na tarehe na sala ijayo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lahat ng limang dasal para sa iyong lungsod, kasama ang petsa at ang susunod na dasal."

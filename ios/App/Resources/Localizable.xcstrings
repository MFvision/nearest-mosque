        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasa Arabic at English ang iyong mga aklat. Nananatili ang mga sipi sa orihinal nilang wika."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sách của bạn bằng tiếng Ả Rập và tiếng Anh. Các trích dẫn được giữ nguyên ngôn ngữ gốc."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หนังสือของคุณเป็นภาษาอาหรับและภาษาอังกฤษ ข้อความที่ยกมาจะคงภาษาเดิม"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សៀវភៅរបស់អ្នកជាភាសាអារ៉ាប់ និងអង់គ្លេស។ សម្រង់នៅតែជាភាសាដើម។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "كىتابلىرىڭىز ئەرەبچە ۋە ئىنگلىزچە. نەقىللەر ئەسلى تىلىدا قالىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کتێبەکانت بە عەرەبی و ئینگلیزین. وەرگیراوەکان بە زمانی ڕەسەنی خۆیان دەمێننەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše knjige su na arapskom i engleskom. Citati ostaju na izvornom jeziku."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше књиге су на арапском и енглеском. Цитати остају на изворном језику."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашите книги се на арапски и англиски. Цитатите остануваат на изворниот јазик."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A könyveid arab és angol nyelvűek. Az idézetek az eredeti nyelvükön maradnak."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je boeken zijn in het Arabisch en Engels. Citaten blijven in hun oorspronkelijke taal."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენი წიგნები არაბულ და ინგლისურ ენებზეა. ციტატები ორიგინალის ენაზე რჩება."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ පොත් අරාබි සහ ඉංග්‍රීසි භාෂාවලින් ඇත. උපුටා දැක්වීම් ඒවායේ මුල් භාෂාවෙන්ම පවතී."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ పుస్తకాలు అరబిక్, ఇంగ్లీష్‌లో ఉన్నాయి. ఉల్లేఖనలు వాటి అసలు భాషలోనే ఉంటాయి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪುಸ್ತಕಗಳು ಅರೇಬಿಕ್ ಮತ್ತು ಇಂಗ್ಲಿಷ್‌ನಲ್ಲಿವೆ. ಉಲ್ಲೇಖಗಳು ಅವುಗಳ ಮೂಲ ಭಾಷೆಯಲ್ಲೇ ಇರುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പുസ്തകങ്ങൾ അറബിയിലും ഇംഗ്ലീഷിലുമാണ്. ഉദ്ധരണികൾ അവയുടെ മൂലഭാഷയിൽ തന്നെ നിലനിൽക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमची पुस्तके अरबी आणि इंग्रजीत आहेत. उतारे त्यांच्या मूळ भाषेतच राहतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારાં પુસ્તકો અરબી અને અંગ્રેજીમાં છે. અવતરણો તેમની મૂળ ભાષામાં જ રહે છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀਆਂ ਕਿਤਾਬਾਂ ਅਰਬੀ ਅਤੇ ਅੰਗਰੇਜ਼ੀ ਵਿੱਚ ਹਨ। ਹਵਾਲੇ ਆਪਣੀ ਅਸਲ ਭਾਸ਼ਾ ਵਿੱਚ ਹੀ ਰਹਿੰਦੇ ਹਨ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপোনাৰ কিতাপবোৰ আৰবী আৰু ইংৰাজীত। উদ্ধৃতিবোৰ মূল ভাষাতে থাকে।"
          }
        }
      }
    },
    "answer_not_fatwa": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answers quote books; they are not a fatwa. For a personal ruling, ask a qualified scholar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الإجابات اقتباسات من الكتب وليست فتوى. للحكم في حالتك اسأل عالمًا مؤهلًا."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جوابات کتابوں کے حوالے ہیں، فتویٰ نہیں۔ ذاتی مسئلے کے لیے مستند عالم سے پوچھیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cevaplar kitaplardan alıntıdır, fetva değildir. Kişisel bir hüküm için yetkin bir âlime danışın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban adalah kutipan buku, bukan fatwa. Untuk hukum pribadi, tanyakan kepada ulama yang berkompeten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses citent des livres ; ce n’est pas une fatwa. Pour votre cas, consultez un savant qualifié."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas citan libros; no son una fetua. Para tu caso, consulta a un erudito cualificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы цитируют книги и не являются фетвой. За личным решением обратитесь к знающему учёному."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তরগুলো বই থেকে উদ্ধৃতি; এগুলো ফতোয়া নয়। ব্যক্তিগত মাসআলার জন্য একজন যোগ্য আলেমকে জিজ্ঞেস করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ‌ها نقل از کتاب‌ها هستند و فتوا نیستند. برای حکم شخصی از یک عالم واجد شرایط بپرسید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ‌ها نقل از کتاب‌ها هستند و فتوا نیستند. برای حکم شخصی از یک عالم واجد شرایط بپرسید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答引用书籍，并非法特瓦。如需针对个人的教法裁决，请询问合格的学者。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब किताबों के उद्धरण हैं; ये फ़तवा नहीं हैं। निजी मसले के लिए किसी योग्य आलिम से पूछें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas citam livros; não são uma fatwa. Para uma decisão pessoal, consulte um sábio qualificado."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Amsoshi suna ɗauko daga littattafai; ba fatawa ba ne. Don hukunci na kanku, ku tambayi ƙwararren malami."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Majibu yananukuu vitabu; si fatwa. Kwa hukumu yako binafsi, muulize mwanachuoni aliyehitimu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinisipi ng mga sagot ang mga aklat; hindi ito fatwa. Para sa personal na hatol, magtanong sa isang kwalipikadong iskolar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời trích dẫn sách; đây không phải là fatwa. Để có phán quyết cho trường hợp riêng, hãy hỏi một học giả có chuyên môn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบยกข้อความจากหนังสือ ไม่ใช่ฟัตวา หากต้องการคำวินิจฉัยเฉพาะตัว โปรดถามผู้รู้ที่มีคุณสมบัติ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចម្លើយដកស្រង់ពីសៀវភៅ វាមិនមែនជាហ្វាតវ៉ាទេ។ សម្រាប់ការវិនិច្ឆ័យផ្ទាល់ខ្លួន សូមសួរអ្នកប្រាជ្ញដែលមានសមត្ថភាព។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "جاۋابلار كىتابلاردىن نەقىل؛ پەتىۋا ئەمەس. شەخسىي ھۆكۈم ئۈچۈن لاياقەتلىك ئالىمدىن سوراڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وەڵامەکان وەرگیراون لە کتێبەکان؛ فەتوا نین. بۆ حوکمێکی تایبەت بە خۆت، پرسیار لە زانایەکی شارەزا بکە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovori citiraju knjige; nisu fetva. Za lično pitanje obratite se stručnom učenjaku."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговори цитирају књиге; нису фетва. За лично питање обратите се стручном учењаку."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговорите цитираат книги; тие не се фетва. За лично прашање обратете се до стручен учен."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszok könyvekből idéznek; nem fatvák. Személyes ügyben fordulj képzett tudóshoz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden citeren boeken; ze zijn geen fatwa. Vraag voor een persoonlijke uitspraak een bevoegde geleerde."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პასუხები წიგნებს ციტირებს; ისინი ფეთვა არ არის. პირადი განჩინებისთვის მიმართეთ კვალიფიციურ სწავლულს."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "පිළිතුරු පොත් උපුටා දක්වයි; ඒවා ෆත්වා නොවේ. පෞද්ගලික තීන්දුවක් සඳහා සුදුසුකම් ලත් විද්වතෙකුගෙන් අහන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమాధానాలు పుస్తకాలను ఉటంకిస్తాయి; అవి ఫత్వా కాదు. వ్యక్తిగత తీర్పు కోసం అర్హత గల పండితుడిని అడగండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉತ್ತರಗಳು ಪುಸ್ತಕಗಳನ್ನು ಉಲ್ಲೇಖಿಸುತ್ತವೆ; ಅವು ಫತ್ವಾ ಅಲ್ಲ. ವೈಯಕ್ತಿಕ ತೀರ್ಪಿಗಾಗಿ ಅರ್ಹ ವಿದ್ವಾಂಸರನ್ನು ಕೇಳಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉത്തരങ്ങൾ പുസ്തകങ്ങൾ ഉദ്ധരിക്കുന്നു; അവ ഫത്‌വയല്ല. വ്യക്തിപരമായ വിധിക്ക് യോഗ്യനായ ഒരു പണ്ഡിതനോട് ചോദിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्तरे पुस्तकांमधील उतारे आहेत; ते फतवा नाहीत. वैयक्तिक मसल्यासाठी पात्र आलिमांना विचारा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જવાબો પુસ્તકોનાં અવતરણ છે; તે ફતવો નથી. અંગત મસલા માટે કોઈ લાયક આલિમને પૂછો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਵਾਬ ਕਿਤਾਬਾਂ ਦੇ ਹਵਾਲੇ ਹਨ; ਇਹ ਫ਼ਤਵਾ ਨਹੀਂ। ਨਿੱਜੀ ਮਸਲੇ ਲਈ ਕਿਸੇ ਯੋਗ ਆਲਿਮ ਨੂੰ ਪੁੱਛੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তৰবোৰ কিতাপৰ উদ্ধৃতি; এইবোৰ ফতোৱা নহয়। ব্যক্তিগত মাছআলাৰ বাবে এজন যোগ্য আলিমক সোধক।"
          }
        }
      }
    },

    "sky_day_a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sun path: sunrise %1$@, Maghrib %2$@. %3$@ of daylight has passed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسار الشمس: الشروق %1$@، المغرب %2$@. مضى %3$@ من النهار."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سورج کا راستہ: طلوع %1$@، مغرب %2$@۔ دن کا %3$@ گزر چکا ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güneşin yolu: gün doğumu %1$@, akşam %2$@. Gündüzün %3$@ geçti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lintasan matahari: terbit %1$@, Magrib %2$@. %3$@ siang telah berlalu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Course du soleil : lever %1$@, Maghrib %2$@. %3$@ de la journée est passé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorrido del sol: salida %1$@, Magrib %2$@. Ha pasado el %3$@ del día."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Путь солнца: восход %1$@, магриб %2$@. Прошло %3$@ светового дня."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সূর্যের পথ: সূর্যোদয় %1$@, মাগরিব %2$@। দিনের আলোর %3$@ পার হয়েছে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسیر خورشید: طلوع %1$@، مغرب %2$@. %3$@ از روز گذشته است."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "مسیر خورشید: طلوع %1$@، شام %2$@. %3$@ از روز گذشته است."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

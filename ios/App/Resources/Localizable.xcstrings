    "widget_kind_ring_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time left to the next prayer on a ring, with all of today's times."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوقت المتبقي للصلاة القادمة على حلقة، مع مواقيت اليوم كلها."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگلی نماز تک باقی وقت ایک دائرے پر، آج کے تمام اوقات کے ساتھ۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonraki namaza kalan süre bir halkada, bugünün tüm vakitleriyle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sisa waktu menuju salat berikutnya dalam lingkaran, dengan semua jadwal hari ini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps restant avant la prochaine prière sur un anneau, avec tous les horaires du jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo hasta la próxima oración en un anillo, con todos los horarios de hoy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время до следующей молитвы на кольце и всё расписание на сегодня."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরের নামাজ পর্যন্ত বাকি সময় একটি রিংয়ে, আজকের সব সময়সহ।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمان باقی‌مانده تا نماز بعدی روی یک حلقه، همراه با همهٔ اوقات امروز."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت باقی‌مانده تا نماز بعدی روی یک حلقه، همراه با همهٔ اوقات امروز."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圆环显示距下次礼拜的剩余时间，并列出今天的全部时间。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगली नमाज़ तक बाकी समय एक रिंग पर, आज के सभी समय के साथ।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo até a próxima oração num anel, com todos os horários de hoje."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokacin da ya rage zuwa sallah ta gaba a kan zobe, tare da dukan lokutan yau."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda uliobaki hadi sala inayofuata kwenye mduara, pamoja na nyakati zote za leo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang natitirang oras bago ang susunod na salah sa isang singsing, kasama ang lahat ng oras ngayon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian còn lại đến giờ cầu nguyện tiếp theo trên một vòng tròn, kèm mọi giờ hôm nay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาที่เหลือถึงละหมาดถัดไปบนวงแหวน พร้อมเวลาทั้งหมดของวันนี้"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពេលនៅសល់ដល់សឡាតបន្ទាប់លើរង្វង់ ជាមួយម៉ោងទាំងអស់ថ្ងៃនេះ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "كېيىنكى نامازغىچە قالغان ۋاقىت ھالقىدا، بۈگۈنكى بارلىق ۋاقىتلار بىلەن."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کاتی ماوە بۆ نوێژی داهاتوو لەسەر ئەڵقەیەک، لەگەڵ هەموو کاتەکانی ئەمڕۆ."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Preostalo vrijeme do sljedećeg namaza na prstenu, sa svim današnjim vremenima."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Преостало време до следеће молитве на прстену, са свим данашњим временима."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Преостанатото време до следната молитва на прстен, со сите денешни времиња."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A következő imáig hátralévő idő egy gyűrűn, a mai összes időponttal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijd tot het volgende gebed op een ring, met alle tijden van vandaag."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შემდეგ ლოცვამდე დარჩენილი დრო რგოლზე, დღევანდელი ყველა დროით."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඊළඟ සලාතයට ඉතිරි කාලය වළල්ලක, අද සියලු වේලාවන් සමඟ."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తదుపరి నమాజ్‌కు మిగిలిన సమయం ఒక రింగ్‌పై, ఈరోజు అన్ని సమయాలతో."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದಿನ ನಮಾಜ್‌ವರೆಗೆ ಉಳಿದ ಸಮಯ ಒಂದು ರಿಂಗ್‌ನಲ್ಲಿ, ಇಂದಿನ ಎಲ್ಲ ಸಮಯಗಳೊಂದಿಗೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്ത നമസ്കാരം വരെ ശേഷിക്കുന്ന സമയം ഒരു വളയത്തിൽ, ഇന്നത്തെ എല്ലാ സമയങ്ങളോടും കൂടി."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुढील नमाजपर्यंत उरलेला वेळ वर्तुळावर, आजच्या सर्व वेळांसह."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આગલી નમાઝ સુધીનો બાકી સમય રિંગ પર, આજના બધા સમય સાથે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਗਲੀ ਨਮਾਜ਼ ਤੱਕ ਬਾਕੀ ਸਮਾਂ ਇੱਕ ਰਿੰਗ ’ਤੇ, ਅੱਜ ਦੇ ਸਾਰੇ ਸਮਿਆਂ ਨਾਲ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "পৰৱৰ্তী নামাজলৈ বাকী সময় এটা ৰিঙত, আজিৰ সকলো সময়ৰ সৈতে।"
          }
        }
      }
    },

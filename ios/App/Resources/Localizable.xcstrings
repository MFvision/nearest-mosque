            "state": "translated",
            "value": "Разрешите доступ к геолокации или используйте город, выбранный для времени намазов."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লোকেশনের অনুমতি দিন, অথবা নামাজের সময়ের জন্য বেছে নেওয়া শহরটি ব্যবহার করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به موقعیت را بدهید یا از شهری که برای اوقات نماز انتخاب کرده‌اید استفاده کنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به موقعیت را بدهید یا از شهری که برای اوقات نماز انتخاب کرده‌اید استفاده کنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许使用位置，或使用你为礼拜时间选择的城市。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकेशन की अनुमति दें, या नमाज़ के समय के लिए चुना गया शहर इस्तेमाल करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita a localização ou use a cidade que você escolheu para os horários de oração."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba da izinin wuri, ko yi amfani da garin da kuka zaɓa don lokutan sallah."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhusu mahali, au tumia mji uliouchagua kwa nyakati za sala."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Payagan ang lokasyon, o gamitin ang lungsod na pinili mo para sa mga oras ng dasal."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập vị trí, hoặc dùng thành phố bạn đã chọn cho giờ cầu nguyện."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตตำแหน่ง หรือใช้เมืองที่คุณเลือกไว้สำหรับเวลาละหมาด"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អនុញ្ញាតទីតាំង ឬប្រើទីក្រុងដែលអ្នកបានជ្រើសរើសសម្រាប់ម៉ោងសឡាត។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئورۇنغا ئىجازەت بېرىڭ ياكى ناماز ۋاقتى ئۈچۈن تاللىغان شەھىرىڭىزنى ئىشلىتىڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ڕێگە بە شوێن بدە، یان ئەو شارە بەکاربهێنە کە بۆ کاتەکانی نوێژ هەڵتبژاردووە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dozvolite pristup lokaciji ili koristite grad koji ste odabrali za namaska vremena."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволите приступ локацији или користите град који сте изабрали за намаска времена."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволете пристап до локацијата или користете го градот што го избравте за времињата за намаз."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Engedélyezd a helyhozzáférést, vagy használd az imaidőkhöz választott várost."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta locatie toe, of gebruik de stad die je voor de gebedstijden hebt gekozen."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაუშვით მდებარეობა ან გამოიყენეთ ლოცვის დროებისთვის არჩეული ქალაქი."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ස්ථානයට ඉඩ දෙන්න, නැතහොත් සලාත වේලාවන් සඳහා ඔබ තෝරාගත් නගරය භාවිත කරන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లొకేషన్‌ను అనుమతించండి, లేదా నమాజ్ సమయాల కోసం మీరు ఎంచుకున్న నగరాన్ని ఉపయోగించండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಳವನ್ನು ಅನುಮತಿಸಿ, ಅಥವಾ ನಮಾಜ್ ಸಮಯಗಳಿಗಾಗಿ ನೀವು ಆಯ್ಕೆಮಾಡಿದ ನಗರವನ್ನು ಬಳಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൊക്കേഷൻ അനുവദിക്കുക, അല്ലെങ്കിൽ നമസ്കാര സമയങ്ങൾക്കായി നിങ്ങൾ തിരഞ്ഞെടുത്ത നഗരം ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकेशनला परवानगी द्या, किंवा नमाजच्या वेळांसाठी निवडलेले शहर वापरा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લોકેશનની પરવાનગી આપો, અથવા નમાઝના સમય માટે પસંદ કરેલું શહેર વાપરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟਿਕਾਣੇ ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ, ਜਾਂ ਨਮਾਜ਼ ਦੇ ਵਕਤਾਂ ਲਈ ਚੁਣਿਆ ਸ਼ਹਿਰ ਵਰਤੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "অৱস্থানৰ অনুমতি দিয়ক, বা নামাজৰ সময়ৰ বাবে বাছি লোৱা চহৰখন ব্যৱহাৰ কৰক।"
          }
        }
      }
    },

    "qibla_calibrate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compass accuracy is low. Move your phone in a figure 8, away from metal and magnets."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دقة البوصلة منخفضة. حرّك الهاتف على شكل الرقم 8 بعيدًا عن المعادن والمغناطيس."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قطب نما کی درستی کم ہے۔ فون کو دھات اور مقناطیس سے دور 8 کی شکل میں گھمائیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pusula hassasiyeti düşük. Telefonu metal ve mıknatıslardan uzakta 8 çizerek hareket ettirin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akurasi kompas rendah. Gerakkan ponsel membentuk angka 8, jauh dari logam dan magnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précision faible. Décrivez un 8 avec le téléphone, loin du métal et des aimants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisión baja. Mueve el teléfono en forma de 8, lejos de metales e imanes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Низкая точность компаса. Поводите телефоном восьмёркой вдали от металла и магнитов."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পাসের নির্ভুলতা কম। ধাতু ও চুম্বক থেকে দূরে থেকে ফোনটি 8-এর আকারে ঘোরান।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دقت قطب‌نما کم است. گوشی را دور از فلز و آهنربا به شکل عدد ۸ حرکت دهید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "دقت قطب‌نما کم است. موبایل را دور از فلز و مقناطیس به شکل عدد ۸ حرکت دهید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指南针精度较低。请远离金属和磁铁，将手机按 8 字形移动。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम्पास की सटीकता कम है। धातु और चुंबक से दूर रहकर फ़ोन को 8 के आकार में घुमाएँ।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A precisão da bússola está baixa. Mova o celular fazendo um 8, longe de metais e ímãs."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Daidaiton kamfas ya yi ƙasa. Motsa wayarku kamar siffar 8, nesa da ƙarfe da maganaɗisu."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usahihi wa dira ni mdogo. Zungusha simu yako kwa umbo la 8, mbali na chuma na sumaku."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mababa ang katumpakan ng compass. Igalaw ang iyong telepono nang pa-figure 8, malayo sa metal at magnet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "La bàn kém chính xác. Hãy di chuyển điện thoại theo hình số 8, tránh xa kim loại và nam châm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข็มทิศแม่นยำต่ำ ขยับโทรศัพท์เป็นรูปเลข 8 ให้ห่างจากโลหะและแม่เหล็ก"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ភាពត្រឹមត្រូវរបស់ត្រីវិស័យទាប។ សូមធ្វើចលនាទូរសព្ទជារាងលេខ 8 ឱ្យឆ្ងាយពីលោហៈ និងមេដែក។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "كومپاس ئېنىقلىقى تۆۋەن. تېلېفونىڭىزنى مېتال ۋە ماگنىتتىن يىراقتا 8 شەكلىدە ھەرىكەتلەندۈرۈڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وردی قیبلەنما کەمە. مۆبایلەکەت بە شێوەی ژمارە ٨ بجووڵێنە، دوور لە کانزا و موگناتیس."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tačnost kompasa je niska. Pomjerajte telefon u obliku osmice, dalje od metala i magneta."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Тачност компаса је ниска. Померајте телефон у облику осмице, даље од метала и магнета."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прецизноста на компасот е ниска. Движете го телефонот во форма на осумка, подалеку од метал и магнети."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az iránytű pontossága alacsony. Mozgasd a telefont nyolcas alakban, fémtől és mágnesektől távol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kompas is onnauwkeurig. Beweeg je telefoon in een achtvorm, uit de buurt van metaal en magneten."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კომპასის სიზუსტე დაბალია. ამოძრავეთ ტელეფონი რიცხვი 8-ის ფორმით, ლითონისა და მაგნიტებისგან მოშორებით."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මාලිමාවේ නිරවද්‍යතාව අඩුයි. ලෝහ සහ චුම්බකවලින් ඈතව ඔබේ දුරකථනය 8 හැඩයට චලනය කරන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దిక్సూచి ఖచ్చితత్వం తక్కువగా ఉంది. లోహాలు, అయస్కాంతాలకు దూరంగా మీ ఫోన్‌ను 8 ఆకారంలో కదిలించండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಿಕ್ಸೂಚಿಯ ನಿಖರತೆ ಕಡಿಮೆಯಿದೆ. ಲೋಹ ಮತ್ತು ಆಯಸ್ಕಾಂತಗಳಿಂದ ದೂರದಲ್ಲಿ ನಿಮ್ಮ ಫೋನ್ ಅನ್ನು 8 ಆಕಾರದಲ್ಲಿ ಚಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കോമ്പസിന്റെ കൃത്യത കുറവാണ്. ലോഹങ്ങളിൽ നിന്നും കാന്തങ്ങളിൽ നിന്നും അകലെ ഫോൺ 8 ആകൃതിയിൽ ചലിപ്പിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "होकायंत्राची अचूकता कमी आहे. धातू आणि चुंबकांपासून दूर राहून फोन 8 च्या आकारात फिरवा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હોકાયંત્રની ચોકસાઈ ઓછી છે. ધાતુ અને ચુંબકથી દૂર રહીને ફોનને 8 ના આકારમાં ફેરવો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੰਪਾਸ ਦੀ ਸ਼ੁੱਧਤਾ ਘੱਟ ਹੈ। ਧਾਤ ਅਤੇ ਚੁੰਬਕਾਂ ਤੋਂ ਦੂਰ ਆਪਣੇ ਫ਼ੋਨ ਨੂੰ 8 ਦੀ ਸ਼ਕਲ ਵਿੱਚ ਘੁਮਾਓ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "কম্পাছৰ সঠিকতা কম। ধাতু আৰু চুম্বকৰ পৰা আঁতৰত থাকি ফোনটো 8ৰ আকাৰত ঘূৰাওক।"
          }
        }
      }
    },

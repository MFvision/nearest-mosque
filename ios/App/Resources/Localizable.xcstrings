        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਅਸਮਾਨ ਦੇ ਨਾਲ ਚੱਲਦੇ ਨਮਾਜ਼ ਦੇ ਵਕਤ"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আকাশৰ সৈতে খোজ মিলোৱা নামাজৰ সময়"
          }
        }
      }
    },
    "onb_qibla_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold your phone flat and turn slowly. When the gold dot meets the Kaaba at the top, you’re facing the Qibla and it glows."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أمسك هاتفك بشكل مستوٍ واستدر ببطء. عندما تلتقي النقطة الذهبية بالكعبة في الأعلى فأنت باتجاه القبلة ويتوهج القرص."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون کو سیدھا رکھیں اور آہستہ گھومیں۔ جب سنہری نقطہ اوپر کعبہ سے ملے تو آپ قبلہ رخ ہیں اور ڈسک چمکتی ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu düz tutun ve yavaşça dönün. Altın nokta üstteki Kâbe ile buluştuğunda kıbleye dönüksünüz ve disk parlar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegang ponsel mendatar dan berputar perlahan. Saat titik emas bertemu Ka’bah di atas, Anda menghadap kiblat dan cakramnya bersinar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenez le téléphone à plat et tournez lentement. Quand le point doré rejoint la Kaaba en haut, vous faites face à la qibla et le disque s’illumine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sostén el teléfono en horizontal y gira despacio. Cuando el punto dorado llega a la Kaaba arriba, estás orientado a la alquibla y el disco brilla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите телефон горизонтально и медленно поворачивайтесь. Когда золотая точка совпадёт с Каабой наверху, вы смотрите на киблу, и она засветится."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোনটি সমতল করে ধরুন এবং ধীরে ধীরে ঘুরুন। সোনালি বিন্দুটি ওপরে কাবার সাথে মিলে গেলে আপনি কিবলামুখী, আর তখন এটি উজ্জ্বল হয়ে ওঠে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گوشی را صاف نگه دارید و آرام بچرخید. وقتی نقطه طلایی در بالا به کعبه برسد، رو به قبله هستید و می‌درخشد."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "موبایل را صاف نگه دارید و آرام بچرخید. وقتی نقطه طلایی در بالا به کعبه برسد، رو به قبله هستید و می‌درخشد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手机平放并缓慢转动。当金色圆点与顶部的天房对齐时，你就面向了朝向，表盘会发光。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन को समतल रखें और धीरे-धीरे घूमें। जब सुनहरा बिंदु ऊपर काबा से मिल जाता है, तो आपका रुख़ क़िबला की ओर होता है और वह चमक उठता है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Segure o celular na horizontal e gire devagar. Quando o ponto dourado encontrar a Caaba no topo, você estará voltado para a Qibla e ela vai brilhar."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Riƙe wayarku a kwance kuma ku juya a hankali. Idan ɗigon zinariya ya haɗu da Ka'aba a sama, kuna fuskantar Alƙibla kuma zai yi haske."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shika simu yako ikiwa imelala sawa na ugeuke polepole. Kitone cha dhahabu kikikutana na Al-Kaaba juu, umeelekea Kibla na kinang'aa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hawakan nang pahiga ang iyong telepono at umikot nang dahan-dahan. Kapag nagtagpo ang gintong tuldok at ang Kaaba sa itaas, nakaharap ka na sa Qibla at iilaw ito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ điện thoại nằm phẳng và xoay chậm. Khi chấm vàng gặp Kaaba ở trên cùng, bạn đang hướng về Qibla và nó sẽ sáng lên."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางโทรศัพท์ให้ราบแล้วหมุนช้าๆ เมื่อจุดสีทองตรงกับกะอ์บะฮ์ด้านบน แสดงว่าคุณหันตรงกิบลัตแล้วและหน้าปัดจะเรืองแสง"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កាន់ទូរសព្ទឱ្យរាបស្មើ ហើយបង្វិលយឺតៗ។ នៅពេលចំណុចពណ៌មាសជួបកាបះនៅខាងលើ អ្នកកំពុងបែរមុខទៅគិបឡាត់ ហើយវានឹងភ្លឺ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "تېلېفونىڭىزنى تۈز تۇتۇپ ئاستا بۇرۇلۇڭ. ئالتۇن رەڭلىك چېكىت ئۈستىدىكى كەبىگە يەتكەندە، قىبلىگە يۈزلەنگەن بولىسىز ۋە ئۇ نۇر چاچىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "مۆبایلەکەت بە ڕێکی ڕابگرە و هێواش بسووڕێوە. کاتێک خاڵە زێڕینەکە لە سەرەوە دەگاتە کەعبە، ڕووت لە قیبلەیە و دەدرەوشێتەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Držite telefon vodoravno i polako se okrećite. Kad se zlatna tačka poklopi s Kabom na vrhu, okrenuti ste prema kibli i ona zasvijetli."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Држите телефон водоравно и полако се окрећите. Кад се златна тачка поклопи са Кабом на врху, окренути сте ка кибли и она засветли."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Држете го телефонот хоризонтално и полека вртете се. Кога златната точка ќе се порамни со Кааба на врвот, свртени сте кон киблата и таа засветлува."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartsd vízszintesen a telefont, és fordulj lassan. Amikor az arany pont fent találkozik a Kábával, a kibla felé nézel, és felragyog."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd je telefoon plat en draai langzaam. Als de gouden stip de Kaaba bovenaan raakt, ben je gericht op de qibla en licht hij op."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაიჭირეთ ტელეფონი ჰორიზონტალურად და ნელა შეატრიალეთ. როცა ოქროსფერი წერტილი ზემოთ ქააბას დაემთხვევა, ყიბლისკენ ხართ მიბრუნებული და ის ანათებს."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ දුරකථනය තිරස්ව අල්ලා සෙමින් හැරෙන්න. රන් තිත ඉහළ ඇති කඅබාවට ළඟා වූ විට, ඔබ කිබ්ලා දෙසට මුහුණලා සිටින අතර එය දිදුලයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫోన్‌ను సమతలంగా పట్టుకుని నెమ్మదిగా తిరగండి. బంగారు చుక్క పైభాగంలో కాబాను చేరుకున్నప్పుడు, మీరు ఖిబ్లా వైపు ఉన్నారు, అది మెరుస్తుంది."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋನ್ ಅನ್ನು ಸಮತಟ್ಟಾಗಿ ಹಿಡಿದು ನಿಧಾನವಾಗಿ ತಿರುಗಿ. ಚಿನ್ನದ ಚುಕ್ಕೆ ಮೇಲ್ಭಾಗದಲ್ಲಿ ಕಅಬಾವನ್ನು ತಲುಪಿದಾಗ, ನೀವು ಕಿಬ್ಲಾ ಕಡೆಗೆ ಮುಖ ಮಾಡಿರುತ್ತೀರಿ ಮತ್ತು ಅದು ಹೊಳೆಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോൺ നിരപ്പായി പിടിച്ച് പതുക്കെ തിരിയുക. സ്വർണ്ണ ബിന്ദു മുകളിലുള്ള കഅ്ബയിൽ എത്തുമ്പോൾ, നിങ്ങൾ ഖിബ്‌ലയ്ക്ക് അഭിമുഖമാണ്, അത് തിളങ്ങും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोन सपाट धरा आणि हळूहळू फिरा. सोनेरी ठिपका वरच्या काबाला मिळाला की तुमचे तोंड किब्लाकडे असते आणि तो चमकतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોનને સપાટ રાખો અને ધીમે ધીમે ફરો. જ્યારે સોનેરી ટપકું ઉપર કાબા સાથે મળે, ત્યારે તમારું મોં કિબ્લા તરફ હોય છે અને તે ચમકી ઊઠે છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣਾ ਫ਼ੋਨ ਪੱਧਰਾ ਫੜੋ ਅਤੇ ਹੌਲੀ-ਹੌਲੀ ਘੁੰਮੋ। ਜਦੋਂ ਸੁਨਹਿਰੀ ਬਿੰਦੂ ਉੱਪਰ ਕਾਬਾ ਨਾਲ ਮਿਲੇ, ਤੁਹਾਡਾ ਮੂੰਹ ਕਿਬਲੇ ਵੱਲ ਹੈ ਅਤੇ ਇਹ ਚਮਕਦਾ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোনটো সমানকৈ ধৰক আৰু লাহে লাহে ঘূৰক। সোণালী বিন্দুটো ওপৰৰ কাবাৰ সৈতে মিলিলে আপুনি কিবলামুখী হয় আৰু ই জিলিকি উঠে।"
          }
        }
      }
    },

    "library_download_failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t load it. Check your connection and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحميل. تحقّق من الاتصال وحاول مرة أخرى."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لوڈ نہیں ہو سکا۔ کنکشن چیک کر کے دوبارہ کوشش کریں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklenemedi. Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal memuat. Periksa koneksi lalu coba lagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement impossible. Vérifiez la connexion et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar. Revisa la conexión e inténtalo de nuevo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить. Проверьте подключение и повторите."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লোড করা যায়নি। আপনার সংযোগ দেখে আবার চেষ্টা করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بارگیری نشد. اتصال خود را بررسی کنید و دوباره امتحان کنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "دانلود نشد. اتصال خود را بررسی کنید و دوباره کوشش کنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载。请检查网络连接后重试。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोड नहीं हो सका। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar. Verifique sua conexão e tente de novo."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya loda shi ba. Duba haɗin intanet ɗinku kuma ku sake gwadawa."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kupakia. Angalia muunganisho wako na ujaribu tena."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ito ma-load. Tingnan ang iyong koneksyon at subukan muli."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tải được. Hãy kiểm tra kết nối và thử lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดไม่ได้ ตรวจสอบการเชื่อมต่อแล้วลองอีกครั้ง"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនអាចផ្ទុកបានទេ។ សូមពិនិត្យការតភ្ជាប់របស់អ្នក ហើយព្យាយាមម្ដងទៀត។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "يۈكلىگىلى بولمىدى. تور ئۇلىنىشىنى تەكشۈرۈپ قايتا سىناڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نەتوانرا بار بکرێت. پەیوەندییەکەت بپشکنە و دووبارە هەوڵ بدەرەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Učitavanje nije uspjelo. Provjerite vezu i pokušajte ponovo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитавање није успело. Проверите везу и покушајте поново."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не може да се вчита. Проверете ја врската и обидете се повторно."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült betölteni. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon het niet laden. Controleer je verbinding en probeer het opnieuw."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩატვირთვა ვერ მოხერხდა. შეამოწმეთ კავშირი და სცადეთ ხელახლა."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "පූරණය කළ නොහැකි විය. ඔබේ සම්බන්ධතාව පරීක්ෂා කර නැවත උත්සාහ කරන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లోడ్ కాలేదు. మీ కనెక్షన్‌ను తనిఖీ చేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲೋಡ್ ಆಗಲಿಲ್ಲ. ನಿಮ್ಮ ಸಂಪರ್ಕವನ್ನು ಪರಿಶೀಲಿಸಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലോഡ് ചെയ്യാനായില്ല. കണക്ഷൻ പരിശോധിച്ച് വീണ്ടും ശ്രമിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लोड करता आले नाही. तुमचे कनेक्शन तपासा आणि पुन्हा प्रयत्न करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લોડ થઈ શક્યું નહીં. તમારું કનેક્શન તપાસો અને ફરી પ્રયાસ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲੋਡ ਨਹੀਂ ਹੋ ਸਕਿਆ। ਆਪਣਾ ਕਨੈਕਸ਼ਨ ਜਾਂਚੋ ਅਤੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "লোড কৰিব পৰা নগ'ল। আপোনাৰ সংযোগ পৰীক্ষা কৰি পুনৰ চেষ্টা কৰক।"
          }
        }
      }
    },

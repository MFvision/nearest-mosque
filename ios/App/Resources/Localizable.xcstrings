        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر پنج نماز شهر شما، همراه با تاریخ و نماز بعدی."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "هر پنج نماز شهر شما، همراه با تاریخ و نماز بعدی."

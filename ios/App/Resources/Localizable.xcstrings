          "stringUnit": {
            "state": "translated",
            "value": "जवाब सिर्फ़ आपके फ़ोन की किताबों से आते हैं। दूसरे शब्द या कोई आम सवाल आज़माएँ, या डाउनलोड में किताबें जोड़ें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas vêm apenas dos livros do seu celular. Tente outras palavras, uma pergunta frequente ou adicione livros em Downloads."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Amsoshi suna fitowa ne kawai daga littattafan da ke wayarku. Gwada wasu kalmomi, tambayar da aka saba, ko ƙara littattafai a Abubuwan da aka sauke."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Majibu yanatoka tu kwenye vitabu vilivyo kwenye simu yako. Jaribu maneno mengine, swali la kawaida, au ongeza vitabu kwenye Vipakuliwa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Galing lamang ang mga sagot sa mga aklat sa iyong telepono. Subukan ang ibang salita, isang karaniwang tanong, o magdagdag ng mga aklat sa Mga Download."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Câu trả lời chỉ đến từ các sách trên điện thoại của bạn. Hãy thử từ khác, một câu hỏi thường gặp, hoặc thêm sách trong mục Tải về."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำตอบมาจากหนังสือในโทรศัพท์ของคุณเท่านั้น ลองใช้คำอื่น เลือกคำถามที่พบบ่อย หรือเพิ่มหนังสือในส่วนดาวน์โหลด"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចម្លើយមកតែពីសៀវភៅនៅលើទូរសព្ទរបស់អ្នកប៉ុណ្ណោះ។ សូមសាកល្បងពាក្យផ្សេង សំណួរទូទៅ ឬបន្ថែមសៀវភៅក្នុងផ្នែកទាញយក។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "جاۋابلار پەقەت تېلېفونىڭىزدىكى كىتابلاردىنلا كېلىدۇ. باشقا سۆزلەرنى ياكى كۆپ سورالغان سوئالنى سىناڭ، ياكى «چۈشۈرۈلگەنلەر» دىن كىتاب قوشۇڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وەڵامەکان تەنها لە کتێبەکانی سەر مۆبایلەکەتەوە دێن. وشەی تر یان پرسیارێکی باو تاقی بکەرەوە، یان لە داگرتنەکان کتێب زیاد بکە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovori dolaze samo iz knjiga na vašem telefonu. Pokušajte drugim riječima, nekim čestim pitanjem ili dodajte knjige u Preuzimanjima."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговори потичу само из књига на вашем телефону. Покушајте другим речима, неко често питање или додајте књиге у Преузимањима."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговорите доаѓаат само од книгите на вашиот телефон. Обидете се со други зборови, со често прашање или додадете книги во Преземања."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszok csak a telefonodon lévő könyvekből származnak. Próbálj más szavakat, egy gyakori kérdést, vagy adj hozzá könyveket a Letöltések között."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden komen alleen uit boeken op je telefoon. Probeer andere woorden, een veelgestelde vraag, of voeg boeken toe bij Downloads."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "პასუხები მხოლოდ თქვენს ტელეფონზე არსებული წიგნებიდან მოდის. სცადეთ სხვა სიტყვები, ხშირი კითხვა, ან დაამატეთ წიგნები ჩამოტვირთვებში."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "පිළිතුරු ලැබෙන්නේ ඔබේ දුරකථනයේ ඇති පොත්වලින් පමණි. වෙනත් වචන හෝ පොදු ප්‍රශ්නයක් උත්සාහ කරන්න, නැතහොත් බාගැනීම්වල පොත් එක් කරන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమాధానాలు మీ ఫోన్‌లోని పుస్తకాల నుండి మాత్రమే వస్తాయి. వేరే పదాలు లేదా ఒక సాధారణ ప్రశ్న ప్రయత్నించండి, లేదా డౌన్‌లోడ్‌లలో పుస్తకాలను జోడించండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಉತ್ತರಗಳು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ ಪುಸ್ತಕಗಳಿಂದ ಮಾತ್ರ ಬರುತ್ತವೆ. ಬೇರೆ ಪದಗಳು ಅಥವಾ ಒಂದು ಸಾಮಾನ್ಯ ಪ್ರಶ್ನೆ ಪ್ರಯತ್ನಿಸಿ, ಅಥವಾ ಡೌನ್‌ಲೋಡ್‌ಗಳಲ್ಲಿ ಪುಸ್ತಕಗಳನ್ನು ಸೇರಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഉത്തരങ്ങൾ നിങ്ങളുടെ ഫോണിലെ പുസ്തകങ്ങളിൽ നിന്ന് മാത്രമാണ്. മറ്റ് വാക്കുകളോ ഒരു സാധാരണ ചോദ്യമോ ശ്രമിക്കുക, അല്ലെങ്കിൽ ഡൗൺലോഡുകളിൽ പുസ്തകങ്ങൾ ചേർക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उत्तरे फक्त तुमच्या फोनवरील पुस्तकांमधून येतात. दुसरे शब्द किंवा नेहमीचा प्रश्न वापरून पाहा, किंवा डाउनलोड्समध्ये पुस्तके जोडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "જવાબો ફક્ત તમારા ફોન પરનાં પુસ્તકોમાંથી આવે છે. બીજા શબ્દો કે કોઈ સામાન્ય સવાલ અજમાવો, અથવા ડાઉનલોડ્સમાં પુસ્તકો ઉમેરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਵਾਬ ਸਿਰਫ਼ ਤੁਹਾਡੇ ਫ਼ੋਨ ਦੀਆਂ ਕਿਤਾਬਾਂ ਤੋਂ ਆਉਂਦੇ ਹਨ। ਹੋਰ ਸ਼ਬਦ ਜਾਂ ਕੋਈ ਆਮ ਸਵਾਲ ਅਜ਼ਮਾਓ, ਜਾਂ ਡਾਊਨਲੋਡਾਂ ਵਿੱਚ ਕਿਤਾਬਾਂ ਜੋੜੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "উত্তৰ কেৱল আপোনাৰ ফোনত থকা কিতাপৰ পৰাহে আহে। আন শব্দ বা কোনো সাধাৰণ প্ৰশ্নৰে চেষ্টা কৰক, বা ডাউনলোডত কিতাপ যোগ কৰক।"
          }
        }
      }
    },

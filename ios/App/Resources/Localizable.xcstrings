    "alerts_bells_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on the bell next to a prayer for a reminder at its time."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل الجرس بجانب الصلاة لتصلك تذكرة في وقتها."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے ساتھ گھنٹی آن کریں تاکہ وقت پر یاددہانی ملے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaktinde hatırlatma için namazın yanındaki zili açın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan lonceng di samping salat untuk pengingat pada waktunya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez la cloche à côté d'une prière pour un rappel à son heure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active la campana junto a una oración para un aviso a su hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите колокольчик рядом с намазом, чтобы получить напоминание в его время."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো নামাজের সময়ে রিমাইন্ডার পেতে তার পাশের ঘণ্টাটি চালু করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زنگوله کنار هر نماز را روشن کنید تا سر وقت آن یادآوری دریافت کنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "زنگوله کنار هر نماز را روشن کنید تا سر وقت آن یادآوری دریافت کنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开礼拜旁边的铃铛，即可在其时间收到提醒。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी नमाज़ के समय पर रिमाइंडर के लिए उसके पास की घंटी चालू करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o sino ao lado de uma oração para receber um lembrete no horário dela."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunna ƙararrawar da ke kusa da sallah don tunatarwa a lokacinta."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa kengele iliyo kando ya sala ili upate kikumbusho wakati wake."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on ang kampana sa tabi ng isang dasal para sa paalala sa oras nito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật chuông bên cạnh một giờ cầu nguyện để được nhắc đúng giờ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดกระดิ่งข้างเวลาละหมาดเพื่อรับการเตือนเมื่อถึงเวลา"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើកកណ្ដឹងនៅក្បែរសឡាត ដើម្បីទទួលការរំលឹកនៅពេលដល់ម៉ោង។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ناماز ۋاقتىدا ئەسكەرتىش ئۈچۈن ناماز يېنىدىكى قوڭغۇراقنى ئېچىڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "زەنگی تەنیشت هەر نوێژێک چالاک بکە بۆ بیرخەرەوەیەک لە کاتی خۆیدا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključite zvonce pored namaza za podsjetnik u njegovo vrijeme."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Укључите звонце поред намаза за подсетник у његово време."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вклучете го ѕвончето до намазот за потсетник во неговото време."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsold be az ima melletti csengőt, hogy az ima idején emlékeztetőt kapj."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet het belletje naast een gebed aan voor een herinnering op dat tijdstip."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩართეთ ზარი ლოცვის გვერდით, რომ მის დროს შეხსენება მიიღოთ."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සලාතයක වේලාවට සිහිකැඳවීමක් සඳහා එය අසල ඇති සීනුව සක්‍රිය කරන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఒక నమాజ్ సమయానికి రిమైండర్ కోసం దాని పక్కన ఉన్న గంటను ఆన్ చేయండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಮಾಜ್‌ನ ಸಮಯಕ್ಕೆ ಜ್ಞಾಪನೆ ಪಡೆಯಲು ಅದರ ಪಕ್ಕದ ಗಂಟೆಯನ್ನು ಆನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഒരു നമസ്കാരത്തിന്റെ സമയത്ത് ഓർമ്മപ്പെടുത്തൽ ലഭിക്കാൻ അതിനടുത്തുള്ള മണി ഓണാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एखाद्या नमाजच्या वेळी रिमाइंडरसाठी तिच्या शेजारची घंटा चालू करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ નમાઝના સમયે રિમાઇન્ડર માટે તેની બાજુની ઘંટડી ચાલુ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਨਮਾਜ਼ ਦੇ ਵਕਤ ’ਤੇ ਯਾਦ-ਦਹਾਨੀ ਲਈ ਉਸ ਦੇ ਨਾਲ ਵਾਲੀ ਘੰਟੀ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো নামাজৰ সময়ত সোঁৱৰণীৰ বাবে তাৰ কাষৰ ঘণ্টাটো অন কৰক।"
          }
        }
      }
    },

        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەسكەرتىشلەر كېيىنكى %1$lld كۈنگە تەڭشەلدى. داۋاملىشىشى ئۈچۈن ئەپنى ئارىلاپ ئېچىپ تۇرۇڭ."

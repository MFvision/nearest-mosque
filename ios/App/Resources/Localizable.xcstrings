        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی ترجمه‌ها پیش‌نویس هستند و منتظر بازبینی گویشوران بومی‌اند."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分翻译为草稿，等待母语人士审阅。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ अनुवाद ड्राफ़्ट हैं और मूल भाषियों की समीक्षा बाक़ी है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas traduções são rascunhos aguardando revisão de falantes nativos."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wasu fassarorin daftari ne da ke jiran masu harshen su duba."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Baadhi ya tafsiri ni rasimu zinazosubiri kukaguliwa na wazawa wa lugha."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Draft pa ang ilang salin at hinihintay ang pagsusuri ng mga katutubong nagsasalita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số bản dịch là bản nháp, đang chờ người bản ngữ xem lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำแปลบางส่วนเป็นฉบับร่างที่รอเจ้าของภาษาตรวจทาน"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការបកប្រែខ្លះជាសេចក្ដីព្រាង ដែលកំពុងរង់ចាំការពិនិត្យដោយអ្នកនិយាយភាសាកំណើត។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بەزى تەرجىمىلەر ئانا تىللىقلارنىڭ تەكشۈرۈشىنى كۈتۈۋاتقان دەسلەپكى نۇسخا."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هەندێک وەرگێڕان ڕەشنووسن و چاوەڕوانی پێداچوونەوەی ئاخێوەرانی زمانەکەن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neki prijevodi su nacrti koji čekaju pregled izvornih govornika."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Неки преводи су нацрти који чекају преглед изворних говорника."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Некои преводи се нацрти што чекаат преглед од мајчини говорители."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Egyes fordítások vázlatok, anyanyelvi ellenőrzésre várnak."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige vertalingen zijn concepten die nog door moedertaalsprekers worden nagekeken."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ზოგიერთი თარგმანი სამუშაო ვერსიაა და ელოდება მშობლიური ენის მცოდნის შემოწმებას."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සමහර පරිවර්තන කෙටුම්පත් වන අතර මව් භාෂිකයින්ගේ සමාලෝචනය බලාපොරොත්තුවෙන් සිටී."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "కొన్ని అనువాదాలు ముసాయిదాలు, స్థానిక భాషా సమీక్ష కోసం వేచి ఉన్నాయి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೆಲವು ಅನುವಾದಗಳು ಕರಡುಗಳಾಗಿದ್ದು, ಸ್ಥಳೀಯ ಭಾಷಿಕರ ಪರಿಶೀಲನೆಗಾಗಿ ಕಾಯುತ್ತಿವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചില പരിഭാഷകൾ കരടുകളാണ്, മാതൃഭാഷക്കാരുടെ പരിശോധന കാത്തിരിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "काही अनुवाद मसुदे आहेत आणि मूळ भाषकांच्या पुनरावलोकनाच्या प्रतीक्षेत आहेत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કેટલાક અનુવાદો ડ્રાફ્ટ છે અને મૂળ ભાષીઓની સમીક્ષા બાકી છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੁਝ ਅਨੁਵਾਦ ਖਰੜੇ ਹਨ ਅਤੇ ਮਾਂ-ਬੋਲੀ ਵਾਲਿਆਂ ਦੀ ਨਜ਼ਰਸਾਨੀ ਬਾਕੀ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "কিছুমান অনুবাদ খচৰা আৰু মাতৃভাষীৰ পৰ্যালোচনাৰ অপেক্ষাত।"
          }
        }
      }
    },

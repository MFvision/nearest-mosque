          "stringUnit": {
            "state": "translated",
            "value": "Megmondja, melyik a következő ima, mikor lesz, és mennyi idő van hátra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegt welk gebed het volgende is, wanneer, en hoe lang nog."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გეუბნებათ, რომელია შემდეგი ლოცვა, როდის და რამდენი დრო რჩება."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඊළඟ සලාතය කුමක්ද, කවදාද, තව කොපමණ කාලයක්ද යන්න කියයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తదుపరి నమాజ్ ఏది, ఎప్పుడు, ఇంకా ఎంత సమయం ఉందో చెబుతుంది."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಮುಂದಿನ ನಮಾಜ್ ಯಾವುದು, ಯಾವಾಗ ಮತ್ತು ಎಷ್ಟು ಸಮಯ ಉಳಿದಿದೆ ಎಂದು ಹೇಳುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്ത നമസ്കാരം ഏതാണ്, എപ്പോൾ, എത്ര സമയം ബാക്കിയുണ്ട് എന്ന് പറയുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुढील नमाज कोणती, केव्हा आणि किती वेळ उरला ते सांगते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આગલી નમાઝ કઈ છે, ક્યારે છે અને કેટલો સમય બાકી છે તે કહે છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਦੱਸਦਾ ਹੈ ਕਿ ਅਗਲੀ ਨਮਾਜ਼ ਕਿਹੜੀ ਹੈ, ਕਦੋਂ ਹੈ ਅਤੇ ਕਿੰਨਾ ਸਮਾਂ ਬਾਕੀ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "পৰৱৰ্তী নামাজ কোনটো, কেতিয়া আৰু কিমান সময় বাকী কয়।"
          }
        }
      }
    },

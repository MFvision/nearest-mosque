    "remove_pack_confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove %1$@ from this phone? You can add it again later."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة %1$@ من هذا الهاتف؟ يمكنك إضافتها لاحقًا."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ کو اس فون سے ہٹائیں؟ بعد میں دوبارہ شامل کر سکتے ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bu telefondan kaldırılsın mı? Daha sonra yeniden ekleyebilirsiniz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus %1$@ dari ponsel ini? Anda dapat menambahkannya lagi nanti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer %1$@ de ce téléphone ? Vous pourrez le rajouter plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar %1$@ de este teléfono? Puedes añadirlo después."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить %1$@ с этого телефона? Позже его можно добавить снова."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোন থেকে %1$@ সরাবেন? পরে আবার যোগ করতে পারবেন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ از این گوشی حذف شود؟ بعداً می‌توانید دوباره آن را اضافه کنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ از این موبایل حذف شود؟ بعداً می‌توانید دوباره آن را اضافه کنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要从此手机移除 %1$@ 吗？你以后可以再次添加。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ को इस फ़ोन से हटाएँ? आप इसे बाद में फिर जोड़ सकते हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover %1$@ deste celular? Você pode adicioná-lo de novo depois."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "A cire %1$@ daga wannan wayar? Kuna iya sake ƙara shi daga baya."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ondoa %1$@ kwenye simu hii? Unaweza kuiongeza tena baadaye."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Alisin ang %1$@ sa teleponong ito? Maaari mo itong idagdag muli mamaya."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa %1$@ khỏi điện thoại này? Bạn có thể thêm lại sau."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบ %1$@ ออกจากโทรศัพท์นี้หรือไม่ คุณเพิ่มใหม่ได้ภายหลัง"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដក %1$@ ចេញពីទូរសព្ទនេះ? អ្នកអាចបន្ថែមវាម្ដងទៀតនៅពេលក្រោយ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ بۇ تېلېفوندىن چىقىرىۋېتىلسۇنمۇ؟ كېيىن قايتا قوشسىڭىز بولىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ لەم مۆبایلە لاببرێت؟ دەتوانیت دواتر دووبارە زیادی بکەیتەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukloniti %1$@ s ovog telefona? Kasnije ga možete ponovo dodati."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Уклонити %1$@ са овог телефона? Касније га можете поново додати."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Да се отстрани %1$@ од овој телефон? Подоцна можете повторно да го додадете."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítod erről a telefonról: %1$@? Később újra hozzáadhatod."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ van deze telefoon verwijderen? Je kunt het later opnieuw toevoegen."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წაიშალოს %1$@ ამ ტელეფონიდან? მოგვიანებით შეგიძლიათ ხელახლა დაამატოთ."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ මෙම දුරකථනයෙන් ඉවත් කරන්නද? පසුව නැවත එක් කළ හැක."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ను ఈ ఫోన్ నుండి తీసివేయాలా? తర్వాత మళ్లీ జోడించవచ్చు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ಅನ್ನು ಈ ಫೋನ್‌ನಿಂದ ತೆಗೆದುಹಾಕಬೇಕೇ? ನಂತರ ಮತ್ತೆ ಸೇರಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ഈ ഫോണിൽ നിന്ന് നീക്കം ചെയ്യണോ? പിന്നീട് വീണ്ടും ചേർക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ या फोनवरून काढायचे? तुम्ही ते नंतर पुन्हा जोडू शकता."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ને આ ફોનમાંથી દૂર કરવું છે? તમે તેને પછીથી ફરી ઉમેરી શકો છો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕੀ %1$@ ਨੂੰ ਇਸ ਫ਼ੋਨ ਤੋਂ ਹਟਾਉਣਾ ਹੈ? ਤੁਸੀਂ ਇਸ ਨੂੰ ਬਾਅਦ ਵਿੱਚ ਦੁਬਾਰਾ ਜੋੜ ਸਕਦੇ ਹੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোনৰ পৰা %1$@ আঁতৰাবনে? আপুনি পিছত পুনৰ যোগ কৰিব পাৰিব।"
          }
        }
      }
    },

    "onb_mosque_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See mosques around you on a live map or a compass, with distance and one-tap directions."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد المساجد من حولك على خريطة حية أو بوصلة، مع المسافة والاتجاهات بلمسة واحدة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے آس پاس کی مساجد لائیو نقشے یا قطب نما پر دیکھیں، فاصلے اور ایک ٹیپ میں راستے کے ساتھ۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrenizdeki camileri canlı haritada veya pusulada, mesafe ve tek dokunuşla yol tarifiyle görün."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat masjid di sekitar Anda di peta langsung atau kompas, lengkap dengan jarak dan petunjuk arah sekali ketuk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez les mosquées autour de vous sur une carte en direct ou une boussole, avec la distance et l’itinéraire en un geste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira las mezquitas a tu alrededor en un mapa en vivo o una brújula, con la distancia y la ruta con un toque."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотрите мечети вокруг на живой карте или компасе — с расстоянием и маршрутом в одно касание."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ মানচিত্রে বা কম্পাসে আপনার চারপাশের মসজিদ দেখুন, দূরত্ব ও এক ট্যাপে পথনির্দেশসহ।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسجدهای اطراف خود را روی نقشه زنده یا قطب‌نما ببینید، با فاصله و مسیریابی با یک لمس."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "مساجد اطراف خود را روی نقشه زنده یا قطب‌نما ببینید، با فاصله و مسیریابی با یک لمس."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在实时地图或指南针上查看你周围的清真寺，显示距离，一键获取路线。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आसपास की मस्जिदें लाइव नक्शे या कम्पास पर देखें, दूरी और एक टैप में रास्ते के साथ।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja as mesquitas ao seu redor em um mapa ao vivo ou em uma bússola, com a distância e rotas com um toque."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duba masallatan da ke kewaye da ku a taswira kai tsaye ko kamfas, tare da nisa da kwatance da taɓawa ɗaya."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ona misikiti inayokuzunguka kwenye ramani hai au dira, pamoja na umbali na maelekezo kwa mguso mmoja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingnan ang mga masjid sa paligid mo sa live na mapa o compass, kasama ang layo at direksyon sa isang tap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem các thánh đường quanh bạn trên bản đồ trực tiếp hoặc la bàn, kèm khoảng cách và chỉ đường chỉ với một chạm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูมัสยิดรอบตัวคุณบนแผนที่แบบเรียลไทม์หรือเข็มทิศ พร้อมระยะทางและเส้นทางในแตะเดียว"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មើលម៉ាស្ជិតជុំវិញអ្នកនៅលើផែនទីផ្ទាល់ ឬត្រីវិស័យ ជាមួយចម្ងាយ និងផ្លូវទៅដោយចុចតែម្ដង។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەتراپىڭىزدىكى مەسچىتلەرنى جانلىق خەرىتە ياكى كومپاستا كۆرۈڭ، ئارىلىقى ۋە بىر چېكىشتىلا يول كۆرسىتىش بىلەن."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "مزگەوتەکانی دەوروبەرت لەسەر نەخشەی ڕاستەوخۆ یان قیبلەنما ببینە، لەگەڵ دووری و ڕێنمایی ڕێگا بە یەک دەستلێدان."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pogledajte džamije oko sebe na mapi uživo ili na kompasu, s udaljenošću i uputama jednim dodirom."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Погледајте џамије око себе на мапи уживо или на компасу, са удаљеношћу и упутствима једним додиром."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Погледнете ги џамиите околу вас на мапа во живо или на компас, со растојание и насоки со еден допир."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nézd meg a körülötted lévő mecseteket élő térképen vagy iránytűn, távolsággal és egy koppintásos útvonallal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zie moskeeën om je heen op een live kaart of een kompas, met afstand en route met één tik."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "იხილეთ ირგვლივ მდებარე მეჩეთები ცოცხალ რუკაზე ან კომპასზე, მანძილით და ერთი შეხებით მარშრუტით."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ අවට පල්ලි සජීවී සිතියමක හෝ මාලිමාවක, දුර සහ එක් තට්ටුවකින් මඟ සමඟ බලන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ చుట్టుపక్కల మసీదులను లైవ్ మ్యాప్‌లో లేదా దిక్సూచిలో, దూరంతో మరియు ఒక్క ట్యాప్‌తో దారితో చూడండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಸುತ್ತಲಿನ ಮಸೀದಿಗಳನ್ನು ಲೈವ್ ನಕ್ಷೆ ಅಥವಾ ದಿಕ್ಸೂಚಿಯಲ್ಲಿ, ದೂರ ಮತ್ತು ಒಂದೇ ಟ್ಯಾಪ್‌ನ ದಾರಿಯೊಂದಿಗೆ ನೋಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ചുറ്റുമുള്ള പള്ളികൾ ലൈവ് മാപ്പിലോ കോമ്പസിലോ, ദൂരവും ഒറ്റ ടാപ്പിൽ വഴിയും സഹിതം കാണുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या आजूबाजूच्या मशिदी लाइव्ह नकाशावर किंवा होकायंत्रावर पाहा, अंतर आणि एका टॅपमध्ये रस्त्यासह."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી આસપાસની મસ્જિદો લાઇવ નકશા કે હોકાયંત્ર પર જુઓ, અંતર અને એક ટૅપમાં રસ્તા સાથે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਆਪਣੇ ਆਲੇ-ਦੁਆਲੇ ਦੀਆਂ ਮਸਜਿਦਾਂ ਲਾਈਵ ਨਕਸ਼ੇ ਜਾਂ ਕੰਪਾਸ ’ਤੇ ਵੇਖੋ, ਦੂਰੀ ਅਤੇ ਇੱਕ ਟੈਪ ਵਿੱਚ ਰਸਤੇ ਸਮੇਤ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ মানচিত্ৰ বা কম্পাছত আপোনাৰ চাৰিওফালৰ মছজিদ চাওক, দূৰত্ব আৰু এটা টেপতে পথ নিৰ্দেশনাসহ।"
          }
        }
      }
    },

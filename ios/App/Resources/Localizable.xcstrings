    "qibla_approximate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone compasses are approximate. Check against a known landmark when you can."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بوصلات الهواتف تقريبية. تحقّق بمعلم معروف متى أمكن."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون کے قطب نما تخمینی ہوتے ہیں۔ جب ممکن ہو کسی معلوم نشان سے تصدیق کریں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefon pusulaları yaklaşıktır. Mümkünse bilinen bir işaretle kontrol edin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompas ponsel bersifat perkiraan. Periksa dengan penanda yang diketahui bila bisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boussoles de téléphone sont approximatives. Vérifiez avec un repère connu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las brújulas del teléfono son aproximadas. Compruébalo con una referencia conocida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компас телефона неточен. По возможности сверяйтесь с известным ориентиром."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোনের কম্পাস আনুমানিক। সম্ভব হলে পরিচিত কোনো চিহ্নের সাথে মিলিয়ে নিন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قطب‌نمای گوشی تقریبی است. هر وقت توانستید با یک نشانه شناخته‌شده مقایسه کنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "قطب‌نمای موبایل تقریبی است. هر وقت توانستید با یک نشانه شناخته‌شده مقایسه کنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机指南针只是近似值。条件允许时，请对照已知地标核对。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन के कम्पास अनुमानित होते हैं। जब हो सके, किसी जानी-पहचानी जगह से मिलान कर लें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As bússolas de celular são aproximadas. Quando puder, confira com um ponto de referência conhecido."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamfas ɗin waya na ƙiyasi ne. Idan kun samu dama, ku kwatanta da wata alama da aka sani."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dira za simu ni za makadirio. Linganisha na alama inayojulikana unapoweza."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinatayang direksyon lang ang compass ng telepono. Ihambing sa kilalang palatandaan kapag kaya mo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "La bàn điện thoại chỉ gần đúng. Khi có thể, hãy đối chiếu với một địa điểm đã biết."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข็มทิศในโทรศัพท์เป็นค่าโดยประมาณ ตรวจสอบกับจุดสังเกตที่รู้จักเมื่อทำได้"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ត្រីវិស័យទូរសព្ទគ្រាន់តែប្រហាក់ប្រហែល។ សូមផ្ទៀងផ្ទាត់ជាមួយទីសម្គាល់ដែលស្គាល់ នៅពេលអាចធ្វើបាន។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "تېلېفون كومپاسى تەخمىنىي بولىدۇ. پۇرسەت بولغاندا تونۇش بىر بەلگە بىلەن سېلىشتۇرۇڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "قیبلەنمای مۆبایل نزیکەیییە. هەر کاتێک توانیت بە نیشانەیەکی ناسراو بەراوردی بکە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompasi na telefonu su približni. Kad možete, provjerite prema nekom poznatom orijentiru."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Компаси на телефону су приближни. Када можете, проверите према неком познатом оријентиру."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Компасите на телефоните се приближни. Кога можете, проверете според некој познат ориентир."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefonos iránytűk csak közelítőek. Ha lehet, ellenőrizd egy ismert tereptárgyhoz képest."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefoonkompassen zijn bij benadering. Controleer het waar mogelijk met een bekend herkenningspunt."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ტელეფონის კომპასები მიახლოებითია. როცა შეძლებთ, შეამოწმეთ ცნობილი ღირსშესანიშნაობის მიხედვით."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "දුරකථන මාලිමා ආසන්න අගයන් පමණි. හැකි විට දන්නා සලකුණක් සමඟ සසඳා බලන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఫోన్ దిక్సూచులు సుమారుగా ఉంటాయి. వీలైనప్పుడు తెలిసిన గుర్తుతో సరిచూసుకోండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಫೋನ್ ದಿಕ್ಸೂಚಿಗಳು ಅಂದಾಜಿನವು. ಸಾಧ್ಯವಾದಾಗ ತಿಳಿದಿರುವ ಹೆಗ್ಗುರುತಿನೊಂದಿಗೆ ಪರಿಶೀಲಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഫോൺ കോമ്പസുകൾ ഏകദേശമാണ്. സാധിക്കുമ്പോൾ അറിയാവുന്ന ഒരു അടയാളവുമായി ഒത്തുനോക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "फोनची होकायंत्रे अंदाजे असतात. शक्य असेल तेव्हा एखाद्या ओळखीच्या खुणेशी तुलना करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ફોનના હોકાયંત્ર અંદાજિત હોય છે. શક્ય હોય ત્યારે કોઈ જાણીતી નિશાની સાથે સરખાવો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਫ਼ੋਨ ਦੇ ਕੰਪਾਸ ਅੰਦਾਜ਼ਨ ਹੁੰਦੇ ਹਨ। ਜਦੋਂ ਹੋ ਸਕੇ ਕਿਸੇ ਜਾਣੀ-ਪਛਾਣੀ ਨਿਸ਼ਾਨੀ ਨਾਲ ਮਿਲਾ ਕੇ ਵੇਖੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোনৰ কম্পাছ আনুমানিক। সম্ভৱ হ'লে কোনো চিনাকি চিনৰ সৈতে মিলাই চাওক।"
          }
        }
      }
    },

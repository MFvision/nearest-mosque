    "alerts_fajr_alarm_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rings like an alarm until you stop it, even on silent where the phone allows."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرنّ كالمنبّه حتى توقفه، حتى في الوضع الصامت إن سمح الهاتف."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "الارم کی طرح بجتا ہے جب تک آپ بند نہ کریں، فون اجازت دے تو خاموش موڈ میں بھی۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdurana kadar alarm gibi çalar; telefon izin verirse sessizde de."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berbunyi seperti alarm sampai Anda hentikan, bahkan saat senyap jika ponsel mengizinkan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonne comme une alarme jusqu'à l'arrêt, même en silencieux si le téléphone le permet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suena como una alarma hasta que la detenga, incluso en silencio si el teléfono lo permite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звонит как будильник, пока вы его не выключите, даже в беззвучном режиме, если телефон позволяет."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি বন্ধ না করা পর্যন্ত অ্যালার্মের মতো বাজে, ফোন অনুমতি দিলে সাইলেন্টেও।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مثل زنگ هشدار به صدا درمی‌آید تا آن را خاموش کنید، حتی در حالت بی‌صدا اگر گوشی اجازه دهد."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "مثل الارم زنگ می‌زند تا آن را خاموش کنید، حتی در حالت بی‌صدا اگر موبایل اجازه دهد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像闹钟一样响铃，直到你关闭它；在手机允许的情况下，静音时也会响。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप बंद न करें, अलार्म की तरह बजता है, और जहाँ फ़ोन अनुमति दे वहाँ साइलेंट पर भी।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca como um alarme até você desligar, mesmo no silencioso quando o celular permite."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tana ƙara kamar ƙararrawa har sai kun dakatar da ita, ko da a yanayin shiru idan wayar ta yarda."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inalia kama kengele hadi uizime, hata simu ikiwa kimya pale simu inaporuhusu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumutunog na parang alarm hanggang ihinto mo, kahit naka-silent kung pinapayagan ng telepono."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đổ chuông như báo thức cho đến khi bạn tắt, kể cả khi ở chế độ im lặng nếu điện thoại cho phép."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดังเหมือนนาฬิกาปลุกจนกว่าคุณจะหยุด แม้ในโหมดเงียบหากโทรศัพท์อนุญาต"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "រោទ៍ដូចម៉ោងរោទ៍ រហូតដល់អ្នកបញ្ឈប់វា សូម្បីតែនៅពេលបិទសំឡេង ប្រសិនបើទូរសព្ទអនុញ្ញាត។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "سىز توختاتمىغۇچە ئويغاتقۇچتەك جىرىڭلايدۇ، تېلېفون يول قويسا ئۈنسىز ھالەتتىمۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "وەک ئەلارم لێدەدات تا ڕایدەگریت، تەنانەت لە دۆخی بێدەنگیشدا ئەگەر مۆبایلەکە ڕێگە بدات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvoni kao alarm dok ga ne zaustavite, čak i u nečujnom režimu gdje telefon to dozvoljava."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Звони као аларм док га не зауставите, чак и у нечујном режиму где телефон то дозвољава."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ѕвони како аларм додека не го запрете, дури и на тивок режим, каде што телефонот дозволува."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ébresztőként szól, amíg le nem állítod, néma módban is, ha a telefon engedi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaat af als een wekker tot je hem stopt, ook op stil waar de telefoon dat toestaat."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რეკავს მაღვიძარასავით, სანამ არ გამორთავთ, ჩუმ რეჟიმშიც, თუ ტელეფონი ამის საშუალებას იძლევა."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ නවත්වන තුරු එලාමයක් මෙන් නාද වේ, දුරකථනය ඉඩ දෙන තැන්වල නිහඬ ප්‍රකාරයේදී පවා."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఆపే వరకు అలారంలా మోగుతుంది, ఫోన్ అనుమతిస్తే సైలెంట్‌లో ఉన్నా కూడా."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ನಿಲ್ಲಿಸುವವರೆಗೆ ಅಲಾರಂನಂತೆ ರಿಂಗ್ ಆಗುತ್ತದೆ, ಫೋನ್ ಅನುಮತಿಸಿದರೆ ಸೈಲೆಂಟ್‌ನಲ್ಲಿದ್ದರೂ ಸಹ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ നിർത്തുന്നതുവരെ അലാറം പോലെ മുഴങ്ങും, ഫോൺ അനുവദിക്കുമെങ്കിൽ സൈലന്റിലും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही बंद करेपर्यंत अलार्मसारखा वाजतो, फोन परवानगी देत असेल तिथे सायलेंटवरही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે બંધ ન કરો ત્યાં સુધી એલાર્મની જેમ વાગે છે, ફોન પરવાનગી આપે ત્યાં સાયલન્ટ પર પણ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜਦੋਂ ਤੱਕ ਤੁਸੀਂ ਬੰਦ ਨਾ ਕਰੋ ਅਲਾਰਮ ਵਾਂਗ ਵੱਜਦਾ ਹੈ, ਜਿੱਥੇ ਫ਼ੋਨ ਇਜਾਜ਼ਤ ਦੇਵੇ ਉੱਥੇ ਸਾਈਲੈਂਟ ’ਤੇ ਵੀ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপুনি বন্ধ নকৰালৈকে এলাৰ্মৰ দৰে বাজে, ফোনে অনুমতি দিলে ছাইলেণ্টতো।"
          }
        }
      }
    },

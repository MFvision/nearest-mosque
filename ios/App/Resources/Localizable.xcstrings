    "map_a11y": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Map of nearby mosques. Use the actions to open one, or use the list."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خريطة المساجد القريبة. استخدم الإجراءات لفتح مسجد، أو استخدم القائمة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریبی مساجد کا نقشہ۔ کوئی مسجد کھولنے کے لیے ایکشنز یا فہرست استعمال کریں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakındaki camilerin haritası. Birini açmak için eylemleri veya listeyi kullanın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peta masjid terdekat. Gunakan tindakan untuk membuka salah satunya, atau gunakan daftar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Carte des mosquées proches. Utilisez les actions pour en ouvrir une, ou la liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa de mezquitas cercanas. Use las acciones para abrir una, o la lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карта мечетей поблизости. Используйте действия, чтобы открыть мечеть, или перейдите к списку."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাছের মসজিদের মানচিত্র। কোনোটি খুলতে অ্যাকশন ব্যবহার করুন, অথবা তালিকা ব্যবহার করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نقشه مسجدهای نزدیک. برای باز کردن یک مسجد از کنش‌ها یا فهرست استفاده کنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "نقشه مساجد نزدیک. برای باز کردن یک مسجد از کنش‌ها یا فهرست استفاده کنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近清真寺地图。使用操作打开其中一个，或使用列表。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आसपास की मस्जिदों का नक्शा। किसी मस्जिद को खोलने के लिए ऐक्शन इस्तेमाल करें, या सूची इस्तेमाल करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa das mesquitas próximas. Use as ações para abrir uma ou use a lista."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Taswirar masallatan da ke kusa. Yi amfani da ayyukan don buɗe ɗaya, ko yi amfani da jerin."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramani ya misikiti iliyo karibu. Tumia vitendo kufungua mmoja, au tumia orodha."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa ng mga kalapit na masjid. Gamitin ang mga aksyon para buksan ang isa, o gamitin ang listahan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản đồ các thánh đường gần đó. Dùng các thao tác để mở một thánh đường, hoặc dùng danh sách."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แผนที่มัสยิดใกล้เคียง ใช้การดำเนินการเพื่อเปิดมัสยิด หรือใช้รายการ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផែនទីម៉ាស្ជិតក្បែរៗ។ ប្រើសកម្មភាពដើម្បីបើកមួយ ឬប្រើបញ្ជី។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "يېقىن ئەتراپتىكى مەسچىتلەر خەرىتىسى. بىرىنى ئېچىش ئۈچۈن مەشغۇلاتلارنى ياكى تىزىملىكنى ئىشلىتىڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نەخشەی مزگەوتە نزیکەکان. کردارەکان بەکاربهێنە بۆ کردنەوەی یەکێکیان، یان لیستەکە بەکاربهێنە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapa džamija u blizini. Koristite radnje da otvorite neku ili koristite listu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Мапа џамија у близини. Користите радње да отворите неку или користите листу."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мапа на џамии во близина. Користете ги дејствата за да отворите една или користете го списокот."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A közeli mecsetek térképe. A műveletekkel megnyithatsz egyet, vagy használd a listát."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaart van moskeeën in de buurt. Gebruik de acties om er een te openen, of gebruik de lijst."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ახლომდებარე მეჩეთების რუკა. გამოიყენეთ მოქმედებები ერთ-ერთის გასახსნელად, ან გამოიყენეთ სია."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "අසල පල්ලිවල සිතියම. එකක් විවෘත කිරීමට ක්‍රියා භාවිත කරන්න, නැතහොත් ලැයිස්තුව භාවිත කරන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దగ్గరి మసీదుల మ్యాప్. ఒకదాన్ని తెరవడానికి చర్యలను ఉపయోగించండి, లేదా జాబితాను ఉపయోగించండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹತ್ತಿರದ ಮಸೀದಿಗಳ ನಕ್ಷೆ. ಒಂದನ್ನು ತೆರೆಯಲು ಕ್ರಿಯೆಗಳನ್ನು ಬಳಸಿ, ಅಥವಾ ಪಟ್ಟಿಯನ್ನು ಬಳಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്തുള്ള പള്ളികളുടെ മാപ്പ്. ഒന്ന് തുറക്കാൻ പ്രവർത്തനങ്ങൾ ഉപയോഗിക്കുക, അല്ലെങ്കിൽ പട്ടിക ഉപയോഗിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जवळच्या मशिदींचा नकाशा. एखादी मशीद उघडण्यासाठी ॲक्शन वापरा, किंवा यादी वापरा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નજીકની મસ્જિદોનો નકશો. કોઈ મસ્જિદ ખોલવા માટે ઍક્શન વાપરો, અથવા યાદી વાપરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੇੜਲੀਆਂ ਮਸਜਿਦਾਂ ਦਾ ਨਕਸ਼ਾ। ਕੋਈ ਮਸਜਿਦ ਖੋਲ੍ਹਣ ਲਈ ਕਾਰਵਾਈਆਂ ਵਰਤੋ, ਜਾਂ ਸੂਚੀ ਵਰਤੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "ওচৰৰ মছজিদৰ মানচিত্ৰ। এখন খুলিবলৈ একচন ব্যৱহাৰ কৰক, বা তালিকাখন ব্যৱহাৰ কৰক।"
          }
        }
      }
    },

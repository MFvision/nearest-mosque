    "exact_alarm_needed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To ring on time, allow “Alarms & reminders” for this app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليصل التذكير في وقته، اسمح بـ«المنبّهات والتذكيرات» لهذا التطبيق."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وقت پر اطلاع کے لیے اس ایپ کو “الارم اور یاد دہانیاں” کی اجازت دیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam vaktinde çalması için bu uygulamaya “Alarmlar ve hatırlatıcılar” izni verin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agar tepat waktu, izinkan “Alarm & pengingat” untuk aplikasi ini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour sonner à l’heure, autorisez « Alarmes et rappels » pour cette app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para avisar a tiempo, permite “Alarmas y recordatorios” para esta app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы напоминания звучали вовремя, разрешите этому приложению «Будильники и напоминания»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঠিক সময়ে বাজার জন্য এই অ্যাপকে “অ্যালার্ম ও রিমাইন্ডার” অনুমতি দিন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای اینکه سر وقت زنگ بزند، «هشدارها و یادآورها» را برای این برنامه مجاز کنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "برای اینکه سر وقت زنگ بزند، «هشدارها و یادآورها» را برای این برنامه مجاز کنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了准时响铃，请为此应用允许“闹钟和提醒”。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ठीक समय पर बजने के लिए इस ऐप को “अलार्म और रिमाइंडर” की अनुमति दें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tocar na hora certa, permita “Alarmes e lembretes” para este app."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Don ta yi ƙara a kan lokaci, ba da izinin “Ƙararrawa da tunatarwa” ga wannan manhaja."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ili ilie kwa wakati, ruhusu “Kengele na vikumbusho” kwa programu hii."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tumunog sa tamang oras, payagan ang “Mga alarm at paalala” para sa app na ito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đổ chuông đúng giờ, hãy cho phép “Báo thức và lời nhắc” cho ứng dụng này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้ดังตรงเวลา โปรดอนุญาต “การปลุกและการเตือน” สำหรับแอปนี้"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដើម្បីរោទ៍ឱ្យទាន់ពេល សូមអនុញ្ញាត “ម៉ោងរោទ៍ និងការរំលឹក” សម្រាប់កម្មវិធីនេះ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ۋاقتىدا جىرىڭلىشى ئۈچۈن بۇ ئەپكە «ئويغاتقۇچ ۋە ئەسكەرتىشلەر» ئىجازىتىنى بېرىڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بۆ ئەوەی لە کاتی خۆیدا لێبدات، ڕێگە بە «ئەلارم و بیرخەرەوەکان» بدە بۆ ئەم ئەپە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Da bi zvonilo na vrijeme, dozvolite ovoj aplikaciji „Alarmi i podsjetnici”."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Да би звонило на време, дозволите овој апликацији „Аларми и подсетници”."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "За да ѕвони навреме, дозволете „Аларми и потсетници“ за оваа апликација."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A pontos jelzéshez engedélyezd az alkalmazásnak az „Ébresztések és emlékeztetők” funkciót."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta „Wekkers en herinneringen” toe voor deze app, zodat hij op tijd afgaat."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დროულად რომ დარეკოს, ამ აპისთვის დაუშვით „მაღვიძარები და შეხსენებები“."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "නියමිත වේලාවට නාද වීමට, මෙම යෙදුමට “එලාම් සහ සිහිකැඳවීම්” ඉඩ දෙන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "సమయానికి మోగడానికి, ఈ యాప్‌కు “అలారాలు & రిమైండర్‌లు” అనుమతించండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸಮಯಕ್ಕೆ ಸರಿಯಾಗಿ ರಿಂಗ್ ಆಗಲು, ಈ ಆ್ಯಪ್‌ಗೆ “ಅಲಾರಂಗಳು & ಜ್ಞಾಪನೆಗಳು” ಅನುಮತಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "കൃത്യസമയത്ത് മുഴങ്ങാൻ, ഈ ആപ്പിന് “അലാറങ്ങളും ഓർമ്മപ്പെടുത്തലുകളും” അനുവദിക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वेळेवर वाजण्यासाठी या ॲपला “अलार्म आणि रिमाइंडर” ची परवानगी द्या."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સમયસર વાગે તે માટે આ ઍપને “એલાર્મ અને રિમાઇન્ડર” ની પરવાનગી આપો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਹੀ ਵਕਤ ’ਤੇ ਵੱਜਣ ਲਈ, ਇਸ ਐਪ ਨੂੰ “ਅਲਾਰਮ ਅਤੇ ਯਾਦ-ਦਹਾਨੀਆਂ” ਦੀ ਇਜਾਜ਼ਤ ਦਿਓ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "ঠিক সময়ত বাজিবলৈ এই এপক “এলাৰ্ম আৰু সোঁৱৰণী”ৰ অনুমতি দিয়ক।"
          }
        }
      }
    },

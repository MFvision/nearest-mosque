    "widget_kind_actions_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask, the nearest mosque, and prayer times with the Qibla, one tap each."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل، وأقرب مسجد، ومواقيت الصلاة مع القبلة، كلٌّ بلمسة واحدة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پوچھیں، قریب ترین مسجد، اور قبلہ کے ساتھ نماز کے اوقات، ہر ایک ایک ٹیپ میں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sor, en yakın cami ve kıbleyle namaz vakitleri, her biri tek dokunuşla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanya, masjid terdekat, serta jadwal salat dengan kiblat, masing-masing satu ketukan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander, la mosquée la plus proche, et les horaires avec la qibla, d’une seule touche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar, la mezquita más cercana y los horarios con la alquibla, con un toque cada uno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вопрос, ближайшая мечеть и время молитв с киблой — одним касанием."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "জিজ্ঞাসা, কাছের মসজিদ, এবং কিবলাসহ নামাজের সময়, প্রতিটি এক ট্যাপে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پرسیدن، نزدیک‌ترین مسجد، و اوقات نماز با قبله، هر کدام با یک ضربه."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "پرسیدن، نزدیک‌ترین مسجد، و اوقات نماز با قبله، هر کدام با یک ضربه."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提问、最近的清真寺、礼拜时间与朝向，一键直达。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूछें, सबसे नज़दीकी मस्जिद, और क़िबला के साथ नमाज़ के समय, हर एक एक टैप में।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Perguntar, a mesquita mais próxima e os horários com a qibla, cada um com um toque."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambaya, masallaci mafi kusa, da lokutan sallah tare da alƙibla, kowanne da taɓawa ɗaya."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uliza, msikiti wa karibu, na nyakati za sala pamoja na kibla, kila kimoja kwa mguso mmoja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magtanong, ang pinakamalapit na masjid, at oras ng salah kasama ang qibla, tig-isang tap."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi, nhà thờ Hồi giáo gần nhất, và giờ cầu nguyện kèm hướng Qibla, mỗi thứ một chạm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามคำถาม มัสยิดใกล้ที่สุด และเวลาละหมาดพร้อมกิบลัต แตะครั้งเดียว"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សួរ វិហារឥស្លាមជិតបំផុត និងម៉ោងសឡាតជាមួយគិបឡាត ចុចតែម្ដង។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "سوراش، ئەڭ يېقىن مەسچىت ۋە قىبلە بىلەن ناماز ۋاقىتلىرى، ھەر بىرى بىر چېكىشتە."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پرسیار، نزیکترین مزگەوت، و کاتەکانی نوێژ لەگەڵ قیبلە، هەر یەکە بە یەک دەستلێدان."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pitaj, najbliža džamija i vaktija s kiblom, svako jednim dodirom."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Питај, најближа џамија и времена молитве са киблом, свако једним додиром."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прашај, најблиската џамија и времињата за молитва со киблата, секое со еден допир."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kérdezés, a legközelebbi mecset, és az imaidők a kiblával, egy-egy koppintással."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vragen, de dichtstbijzijnde moskee en gebedstijden met de qibla, elk met één tik."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "კითხვა, უახლოესი მეჩეთი და ლოცვის დრო ყიბლასთან ერთად, თითო შეხებით."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "අසන්න, ළඟම පල්ලිය, සහ කිබ්ලා සමඟ සලාත් වේලාවන්, එක් තට්ටුවකින්."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అడగండి, దగ్గరి మసీదు, ఖిబ్లాతో నమాజ్ సమయాలు, ఒక్కో ట్యాప్‌తో."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಕೇಳಿ, ಹತ್ತಿರದ ಮಸೀದಿ, ಮತ್ತು ಕಿಬ್ಲಾ ಸಹಿತ ನಮಾಜ್ ಸಮಯಗಳು, ಒಂದೊಂದು ಟ್ಯಾಪ್‌ನಲ್ಲಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചോദിക്കുക, അടുത്തുള്ള പള്ളി, ഖിബ്‌ലയോടൊപ്പം നമസ്കാര സമയങ്ങൾ, ഓരോന്നും ഒറ്റ ടാപ്പിൽ."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "विचारा, जवळची मशीद, आणि किब्लासह नमाजाच्या वेळा, प्रत्येकी एका टॅपमध्ये."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પૂછો, નજીકની મસ્જિદ, અને કિબ્લા સાથે નમાઝના સમય, દરેક એક ટૅપમાં."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਪੁੱਛੋ, ਨੇੜਲੀ ਮਸਜਿਦ, ਅਤੇ ਕਿਬਲੇ ਨਾਲ ਨਮਾਜ਼ ਦੇ ਸਮੇਂ, ਹਰ ਇੱਕ ਇੱਕ ਟੈਪ ਵਿੱਚ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "সোধক, ওচৰৰ মছজিদ, আৰু কিবলাৰ সৈতে নামাজৰ সময়, প্ৰতিটো এটা টিপত।"
          }
        }
      }
    },

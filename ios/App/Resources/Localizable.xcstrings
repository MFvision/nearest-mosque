        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีอายะฮ์ในโทรศัพท์ของคุณที่ตรงอย่างชัดเจน แต่รายการเหล่านี้จาก IslamHouse ตรงกัน เปิดรายการหนึ่งเพื่ออ่าน"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានអាយ៉ាត់នៅលើទូរសព្ទរបស់អ្នកដែលត្រូវគ្នាច្បាស់លាស់ទេ ប៉ុន្តែធាតុទាំងនេះពី IslamHouse ត្រូវគ្នា។ បើកមួយដើម្បីអាន។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "تېلېفونىڭىزدىكى ھېچقانداق ئايەت ئېنىق ماس كەلمىدى، ئەمما بۇ IslamHouse مەزمۇنلىرى ماس كېلىدۇ. ئوقۇش ئۈچۈن بىرىنى ئېچىڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ ئایەتێک لەسەر مۆبایلەکەت بە ڕوونی ناگونجێت، بەڵام ئەم بابەتانەی IslamHouse دەگونجێن. یەکێکیان بکەرەوە بۆ خوێندنەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nijedan ajet na vašem telefonu ne odgovara jasno, ali ovi sadržaji s IslamHouse-a odgovaraju. Otvorite neki da ga pročitate."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниједан ајет на вашем телефону не одговара јасно, али ови садржаји са IslamHouse-а одговарају. Отворите неки да га прочитате."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ниеден ајет на вашиот телефон не одговара јасно, но овие материјали од IslamHouse одговараат. Отворете еден за да го прочитате."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A telefonodon egyetlen vers sem illik egyértelműen a kérdéshez, de ezek az IslamHouse-anyagok igen. Nyiss meg egyet az olvasáshoz."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen vers op je telefoon past duidelijk, maar deze items van IslamHouse wel. Open er een om het te lezen."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენს ტელეფონზე არცერთი აიათი ნათლად არ შეესაბამება, მაგრამ IslamHouse-ის ეს მასალები შეესაბამება. გახსენით ერთ-ერთი წასაკითხად."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබේ දුරකථනයේ කිසිදු ආයතයක් පැහැදිලිව නොගැළපේ, නමුත් මෙම IslamHouse අයිතම ගැළපේ. කියවීමට එකක් විවෘත කරන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఫోన్‌లోని ఏ ఆయత్ స్పష్టంగా సరిపోలలేదు, కానీ ఈ IslamHouse అంశాలు సరిపోతాయి. చదవడానికి ఒకదాన్ని తెరవండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿರುವ ಯಾವುದೇ ಆಯತ್ ಸ್ಪಷ್ಟವಾಗಿ ಹೊಂದುವುದಿಲ್ಲ, ಆದರೆ ಈ IslamHouse ಅಂಶಗಳು ಹೊಂದುತ್ತವೆ. ಓದಲು ಒಂದನ್ನು ತೆರೆಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഫോണിലെ ഒരു ആയത്തും വ്യക്തമായി യോജിക്കുന്നില്ല, എന്നാൽ ഈ IslamHouse ഇനങ്ങൾ യോജിക്കുന്നു. വായിക്കാൻ ഒന്ന് തുറക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या फोनवरील कोणतीही आयत स्पष्टपणे जुळत नाही, पण IslamHouse वरील हे साहित्य जुळते. वाचण्यासाठी एखादे उघडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારા ફોન પરની કોઈ આયત સ્પષ્ટ રીતે મેળ ખાતી નથી, પણ IslamHouse ની આ સામગ્રી મેળ ખાય છે. વાંચવા માટે કોઈ એક ખોલો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਫ਼ੋਨ ’ਤੇ ਕੋਈ ਆਇਤ ਸਾਫ਼ ਤੌਰ ’ਤੇ ਮੇਲ ਨਹੀਂ ਖਾਂਦੀ, ਪਰ ਇਹ IslamHouse ਸਮੱਗਰੀ ਮੇਲ ਖਾਂਦੀ ਹੈ। ਪੜ੍ਹਨ ਲਈ ਕੋਈ ਇੱਕ ਖੋਲ੍ਹੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপোনাৰ ফোনৰ কোনো আয়াত স্পষ্টকৈ মিল নাখায়, কিন্তু IslamHouseৰ এই সমলবোৰ মিলে। পঢ়িবলৈ এটা খোলক।"
          }
        }
      }
    },

            "state": "translated",
            "value": "మీ పుస్తకాల్లో వెతుకుతోంది…"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಪುಸ್ತಕಗಳಲ್ಲಿ ಹುಡುಕಲಾಗುತ್ತಿದೆ…"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ പുസ്തകങ്ങളിൽ തിരയുന്നു…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या पुस्तकांमध्ये शोधत आहोत…"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારાં પુસ્તકોમાં શોધી રહ્યા છીએ…"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀਆਂ ਕਿਤਾਬਾਂ ਵਿੱਚ ਲੱਭਿਆ ਜਾ ਰਿਹਾ ਹੈ…"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপোনাৰ কিতাপবোৰত বিচৰা হৈছে…"
          }
        }
      }
    },

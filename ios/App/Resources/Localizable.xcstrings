    "polar_unavailable_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this latitude the sun doesn’t rise or set today, so ordinary times don’t exist. You can choose a high-latitude rule."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في هذا العرض لا تشرق الشمس أو لا تغرب اليوم، فلا توجد مواقيت معتادة. يمكنك اختيار قاعدة العروض العليا."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس عرض بلد پر آج سورج طلوع یا غروب نہیں ہوتا، اس لیے عام اوقات موجود نہیں۔ آپ بلند عرض بلد کا اصول منتخب کر سکتے ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu enlemde güneş bugün doğmuyor ya da batmıyor; olağan vakitler yok. Bir yüksek enlem kuralı seçebilirsiniz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di lintang ini matahari tidak terbit atau terbenam hari ini, jadi jadwal biasa tidak ada. Anda dapat memilih aturan lintang tinggi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À cette latitude, le soleil ne se lève pas ou ne se couche pas aujourd’hui. Vous pouvez choisir une règle pour hautes latitudes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta latitud el sol no sale o no se pone hoy, así que no hay horarios ordinarios. Puedes elegir una regla de latitudes altas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этой широте сегодня солнце не восходит или не заходит, поэтому обычного времени нет. Можно выбрать правило для высоких широт."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অক্ষাংশে আজ সূর্য ওঠে না বা অস্ত যায় না, তাই সাধারণ সময়গুলো নেই। আপনি উচ্চ অক্ষাংশের একটি নিয়ম বেছে নিতে পারেন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در این عرض جغرافیایی خورشید امروز طلوع یا غروب نمی‌کند، پس اوقات معمول وجود ندارد. می‌توانید یک قاعده عرض‌های بالا انتخاب کنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "در این عرض جغرافیایی خورشید امروز طلوع یا غروب نمی‌کند، پس اوقات معمول وجود ندارد. می‌توانید یک قاعده عرض‌های بالا انتخاب کنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此纬度，今天太阳不升起或不落下，因此不存在常规时间。你可以选择一种高纬度规则。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अक्षांश पर आज सूरज न उगता है न डूबता है, इसलिए सामान्य समय मौजूद नहीं हैं। आप ऊँचे अक्षांश का कोई नियम चुन सकते हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta latitude o sol não nasce ou não se põe hoje, então não existem horários comuns. Você pode escolher uma regra para altas latitudes."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "A wannan latitude rana ba ta fitowa ko ba ta faɗuwa yau, don haka babu lokuta na yau da kullum. Kuna iya zaɓar ƙa'idar manyan latitude."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Katika latitudo hii jua halichomozi au halizami leo, kwa hivyo nyakati za kawaida hazipo. Unaweza kuchagua kanuni ya latitudo za juu."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa latitude na ito, hindi sumisikat o lumulubog ang araw ngayon, kaya walang karaniwang mga oras. Maaari kang pumili ng panuntunan para sa matataas na latitude."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ở vĩ độ này, hôm nay mặt trời không mọc hoặc không lặn, nên không có giờ thông thường. Bạn có thể chọn một quy tắc vĩ độ cao."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่ละติจูดนี้ วันนี้ดวงอาทิตย์ไม่ขึ้นหรือไม่ตก จึงไม่มีเวลาตามปกติ คุณเลือกกฎสำหรับละติจูดสูงได้"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "នៅរយៈទទឹងនេះ ថ្ងៃមិនរះ ឬមិនលិចនៅថ្ងៃនេះទេ ដូច្នេះមិនមានម៉ោងធម្មតាទេ។ អ្នកអាចជ្រើសរើសច្បាប់សម្រាប់រយៈទទឹងខ្ពស់។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ كەڭلىكتە بۈگۈن قۇياش چىقمايدۇ ياكى پاتمايدۇ، شۇڭا ئادەتتىكى ۋاقىتلار يوق. يۇقىرى كەڭلىك قائىدىسىنى تاللىسىڭىز بولىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لەم پانییە خۆر ئەمڕۆ هەڵنایەت یان ئاوا نابێت، بۆیە کاتی ئاسایی نییە. دەتوانیت یاسایەکی پانییە بەرزەکان هەڵبژێریت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovoj geografskoj širini sunce danas ne izlazi ili ne zalazi, pa uobičajena vremena ne postoje. Možete odabrati pravilo za velike širine."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "На овој географској ширини сунце данас не излази или не залази, па уобичајена времена не постоје. Можете изабрати правило за велике ширине."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "На оваа географска ширина сонцето денес не изгрева или не заоѓа, па вообичаени времиња не постојат. Можете да изберете правило за високи ширини."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a szélességen ma nem kel fel vagy nem nyugszik le a nap, így szokásos időpontok nincsenek. Választhatsz magas szélességi szabályt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op deze breedtegraad komt de zon vandaag niet op of gaat ze niet onder, dus gewone tijden bestaan niet. Je kunt een regel voor hoge breedtegraden kiezen."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ განედზე დღეს მზე არ ამოდის ან არ ჩადის, ამიტომ ჩვეულებრივი დროები არ არსებობს. შეგიძლიათ აირჩიოთ მაღალი განედის წესი."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම අක්ෂාංශයේ අද හිරු උදා නොවේ හෝ බැස නොයයි, එබැවින් සාමාන්‍ය වේලාවන් නොපවතී. ඔබට ඉහළ අක්ෂාංශ නීතියක් තෝරා ගත හැක."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ అక్షాంశంలో ఈరోజు సూర్యుడు ఉదయించడు లేదా అస్తమించడు, కాబట్టి సాధారణ సమయాలు ఉండవు. మీరు అధిక అక్షాంశ నియమాన్ని ఎంచుకోవచ్చు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಅಕ್ಷಾಂಶದಲ್ಲಿ ಇಂದು ಸೂರ್ಯ ಉದಯಿಸುವುದಿಲ್ಲ ಅಥವಾ ಅಸ್ತಮಿಸುವುದಿಲ್ಲ, ಆದ್ದರಿಂದ ಸಾಮಾನ್ಯ ಸಮಯಗಳು ಇರುವುದಿಲ್ಲ. ನೀವು ಉನ್ನತ ಅಕ್ಷಾಂಶ ನಿಯಮವನ್ನು ಆಯ್ಕೆಮಾಡಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ അക്ഷാംശത്തിൽ ഇന്ന് സൂര്യൻ ഉദിക്കുകയോ അസ്തമിക്കുകയോ ചെയ്യുന്നില്ല, അതിനാൽ സാധാരണ സമയങ്ങൾ നിലവിലില്ല. നിങ്ങൾക്ക് ഒരു ഉയർന്ന അക്ഷാംശ നിയമം തിരഞ്ഞെടുക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या अक्षांशावर आज सूर्य उगवत नाही किंवा मावळत नाही, त्यामुळे सामान्य वेळा अस्तित्वात नाहीत. तुम्ही उच्च अक्षांशाचा एखादा नियम निवडू शकता."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ અક્ષાંશ પર આજે સૂરજ ઊગતો નથી કે આથમતો નથી, તેથી સામાન્ય સમય હોતા નથી. તમે ઊંચા અક્ષાંશનો કોઈ નિયમ પસંદ કરી શકો છો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਅਕਸ਼ਾਂਸ਼ ’ਤੇ ਅੱਜ ਸੂਰਜ ਨਾ ਚੜ੍ਹਦਾ ਹੈ ਨਾ ਡੁੱਬਦਾ ਹੈ, ਇਸ ਲਈ ਆਮ ਵਕਤ ਮੌਜੂਦ ਨਹੀਂ। ਤੁਸੀਂ ਉੱਚ ਅਕਸ਼ਾਂਸ਼ ਦਾ ਨਿਯਮ ਚੁਣ ਸਕਦੇ ਹੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অক্ষাংশত আজি সূৰ্য উদয় বা অস্ত নাযায়, সেয়েহে সাধাৰণ সময়বোৰ নাই। আপুনি উচ্চ অক্ষাংশৰ এটা নিয়ম বাছিব পাৰে।"
          }
        }
      }
    },

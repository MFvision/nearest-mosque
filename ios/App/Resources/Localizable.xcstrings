        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "بیرخەرەوەکان بۆ %1$lld ڕۆژی داهاتوو دانراون. جار جار ئەپەکە بکەرەوە بۆ ئەوەی بەردەوام بن."

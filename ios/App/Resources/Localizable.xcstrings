        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang mga notification para sa app na ito. I-on ang mga ito sa Mga Setting para makatanggap ng mga paalala."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo của ứng dụng này đang tắt. Hãy bật trong Cài đặt để nhận nhắc nhở."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนของแอปนี้ปิดอยู่ เปิดได้ในการตั้งค่าเพื่อรับการเตือน"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជូនដំណឹងសម្រាប់កម្មវិធីនេះត្រូវបានបិទ។ សូមបើកវានៅក្នុងការកំណត់ ដើម្បីទទួលបានការរំលឹក។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ ئەپنىڭ ئۇقتۇرۇشلىرى تاقاق. ئەسكەرتىش تاپشۇرۇۋېلىش ئۈچۈن تەڭشەكتە ئېچىڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئاگادارکردنەوەکان بۆ ئەم ئەپە کوژاونەتەوە. لە ڕێکخستنەکان هەڵیانبکە بۆ وەرگرتنی بیرخەرەوەکان."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavještenja su isključena za ovu aplikaciju. Uključite ih u postavkama da biste dobijali podsjetnike."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Обавештења су искључена за ову апликацију. Укључите их у подешавањима да бисте добијали подсетнике."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Известувањата за оваа апликација се исклучени. Вклучете ги во поставките за да добивате потсетници."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az alkalmazás értesítései ki vannak kapcsolva. Kapcsold be őket a Beállításokban, hogy emlékeztetőket kapj."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldingen staan uit voor deze app. Zet ze aan in Instellingen om herinneringen te krijgen."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ამ აპის შეტყობინებები გამორთულია. შეხსენებების მისაღებად ჩართეთ ისინი პარამეტრებში."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම යෙදුමට දැනුම්දීම් අක්‍රියයි. සිහිකැඳවීම් ලබා ගැනීමට සැකසීම්වල ඒවා සක්‍රිය කරන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ యాప్‌కు నోటిఫికేషన్‌లు ఆఫ్‌లో ఉన్నాయి. రిమైండర్‌లు పొందడానికి సెట్టింగ్‌లలో వాటిని ఆన్ చేయండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಆ್ಯಪ್‌ಗೆ ಅಧಿಸೂಚನೆಗಳು ಆಫ್ ಆಗಿವೆ. ಜ್ಞಾಪನೆಗಳನ್ನು ಪಡೆಯಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅವುಗಳನ್ನು ಆನ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ ആപ്പിന്റെ അറിയിപ്പുകൾ ഓഫാണ്. ഓർമ്മപ്പെടുത്തലുകൾ ലഭിക്കാൻ ക്രമീകരണങ്ങളിൽ അവ ഓണാക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या ॲपच्या सूचना बंद आहेत. रिमाइंडर मिळवण्यासाठी सेटिंग्जमध्ये त्या चालू करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ ઍપના નોટિફિકેશન બંધ છે. રિમાઇન્ડર મેળવવા માટે સેટિંગ્સમાં તેને ચાલુ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਐਪ ਲਈ ਸੂਚਨਾਵਾਂ ਬੰਦ ਹਨ। ਯਾਦ-ਦਹਾਨੀਆਂ ਲਈ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਇਨ੍ਹਾਂ ਨੂੰ ਚਾਲੂ ਕਰੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এই এপৰ জাননী অফ আছে। সোঁৱৰণী পাবলৈ ছেটিংছত সেইবোৰ অন কৰক।"
          }
        }
      }
    },

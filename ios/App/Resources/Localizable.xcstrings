    "chat_history_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats are saved only on this phone and never sent anywhere. Opening one asks its questions again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ المحادثات على هذا الهاتف فقط ولا تُرسل إلى أي مكان. فتح محادثة يعيد طرح أسئلتها."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "گفتگو صرف اسی فون پر محفوظ ہوتی ہے اور کہیں نہیں بھیجی جاتی۔ کھولنے پر اس کے سوال دوبارہ پوچھے جاتے ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbetler yalnızca bu telefonda saklanır ve hiçbir yere gönderilmez. Açtığınızda soruları yeniden sorulur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrolan hanya disimpan di ponsel ini dan tidak dikirim ke mana pun. Membukanya akan mengajukan pertanyaannya lagi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations restent sur ce téléphone et ne sont envoyées nulle part. En ouvrir une repose ses questions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conversaciones se guardan solo en este teléfono y no se envían a ningún sitio. Abrir una vuelve a hacer sus preguntas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаты сохраняются только на этом телефоне и никуда не отправляются. При открытии чата его вопросы задаются заново."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চ্যাট শুধু এই ফোনেই সেভ হয় এবং কোথাও পাঠানো হয় না। কোনো চ্যাট খুললে তার প্রশ্নগুলো আবার জিজ্ঞেস করা হয়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گفتگوها فقط روی این گوشی ذخیره می‌شوند و به هیچ جا فرستاده نمی‌شوند. با باز کردن یک گفتگو، سؤال‌های آن دوباره پرسیده می‌شوند."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "گفتگوها فقط روی این موبایل ذخیره می‌شوند و به هیچ جا فرستاده نمی‌شوند. با باز کردن یک گفتگو، سوال‌های آن دوباره پرسیده می‌شوند."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话只保存在此手机上，绝不会发送到任何地方。打开一个对话会重新提出其中的问题。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चैट सिर्फ़ इसी फ़ोन पर सेव होती हैं और कहीं नहीं भेजी जातीं। किसी चैट को खोलने पर उसके सवाल फिर से पूछे जाते हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As conversas ficam salvas só neste celular e nunca são enviadas. Abrir uma faz as perguntas dela de novo."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ajiye hirarraki a wannan wayar kawai kuma ba a aika su ko'ina. Buɗe ɗaya yana sake yin tambayoyinta."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mazungumzo yanahifadhiwa kwenye simu hii tu na hayatumwi popote. Ukifungua moja, maswali yake yanaulizwa tena."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa teleponong ito lang nai-save ang mga chat at hindi kailanman ipinapadala kahit saan. Kapag binuksan ang isa, itatanong muli ang mga tanong nito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cuộc trò chuyện chỉ được lưu trên điện thoại này và không bao giờ được gửi đi đâu. Khi mở lại, các câu hỏi trong đó sẽ được hỏi lại."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แชตจะบันทึกไว้ในโทรศัพท์นี้เท่านั้นและไม่ถูกส่งไปที่ใด การเปิดแชตจะถามคำถามในนั้นอีกครั้ง"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការជជែកត្រូវបានរក្សាទុកតែនៅលើទូរសព្ទនេះប៉ុណ្ណោះ ហើយមិនដែលផ្ញើទៅកន្លែងណាទេ។ ការបើកមួយនឹងសួរសំណួររបស់វាម្ដងទៀត។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "سۆھبەتلەر پەقەت مۇشۇ تېلېفوندا ساقلىنىدۇ، ھېچ يەرگە يوللانمايدۇ. بىرىنى ئاچسىڭىز، ئۇنىڭدىكى سوئاللار قايتا سورىلىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "گفتوگۆکان تەنها لەسەر ئەم مۆبایلە پاشەکەوت دەکرێن و بۆ هیچ شوێنێک نانێردرێن. کردنەوەی یەکێکیان پرسیارەکانی دووبارە دەکاتەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Razgovori se čuvaju samo na ovom telefonu i nikad se nigdje ne šalju. Kad otvorite razgovor, njegova pitanja se postavljaju ponovo."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Разговори се чувају само на овом телефону и никад се никуда не шаљу. Кад отворите разговор, његова питања се постављају поново."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Разговорите се зачувуваат само на овој телефон и никогаш не се испраќаат никаде. Кога ќе отворите разговор, неговите прашања се поставуваат повторно."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csevegések csak ezen a telefonon tárolódnak, és sehová nem kerülnek elküldésre. Ha megnyitsz egyet, a kérdései újra elhangzanak."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats worden alleen op deze telefoon bewaard en nergens naartoe gestuurd. Als je er een opent, worden de vragen opnieuw gesteld."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჩატები მხოლოდ ამ ტელეფონზე ინახება და არსად იგზავნება. ჩატის გახსნისას მისი კითხვები ხელახლა დაისმება."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "කතාබස් සුරැකෙන්නේ මෙම දුරකථනයේ පමණක් වන අතර කොතැනකටවත් නොයවයි. එකක් විවෘත කළ විට එහි ප්‍රශ්න නැවත අසයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చాట్‌లు ఈ ఫోన్‌లో మాత్రమే సేవ్ అవుతాయి, ఎక్కడికీ పంపబడవు. ఒకదాన్ని తెరిస్తే దాని ప్రశ్నలు మళ్లీ అడగబడతాయి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಚಾಟ್‌ಗಳನ್ನು ಈ ಫೋನ್‌ನಲ್ಲಿ ಮಾತ್ರ ಉಳಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಎಲ್ಲಿಗೂ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ. ಒಂದನ್ನು ತೆರೆದರೆ ಅದರ ಪ್ರಶ್ನೆಗಳನ್ನು ಮತ್ತೆ ಕೇಳಲಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ചാറ്റുകൾ ഈ ഫോണിൽ മാത്രമേ സേവ് ചെയ്യൂ, എവിടേക്കും അയയ്ക്കില്ല. ഒന്ന് തുറന്നാൽ അതിലെ ചോദ്യങ്ങൾ വീണ്ടും ചോദിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चॅट्स फक्त याच फोनवर सेव्ह होतात आणि कुठेही पाठवल्या जात नाहीत. एखादी चॅट उघडल्यावर तिचे प्रश्न पुन्हा विचारले जातात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ચૅટ ફક્ત આ જ ફોન પર સેવ થાય છે અને ક્યાંય મોકલાતી નથી. કોઈ ચૅટ ખોલવાથી તેના સવાલો ફરી પૂછાય છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਗੱਲਬਾਤਾਂ ਸਿਰਫ਼ ਇਸੇ ਫ਼ੋਨ ’ਤੇ ਸੰਭਾਲੀਆਂ ਜਾਂਦੀਆਂ ਹਨ ਅਤੇ ਕਿਤੇ ਨਹੀਂ ਭੇਜੀਆਂ ਜਾਂਦੀਆਂ। ਕੋਈ ਗੱਲਬਾਤ ਖੋਲ੍ਹਣ ’ਤੇ ਉਸ ਦੇ ਸਵਾਲ ਦੁਬਾਰਾ ਪੁੱਛੇ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "চেটবোৰ কেৱল এই ফোনতে ছেভ হয় আৰু কেতিয়াও ক'তো পঠিওৱা নহয়। এটা চেট খুলিলে তাৰ প্ৰশ্নবোৰ পুনৰ সোধা হয়।"
          }
        }
      }
    },
    "choose_city_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times are calculated on your phone. Pick a city or use your location. No internet needed."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب المواقيت على هاتفك. اختر مدينة أو استخدم موقعك، دون الحاجة إلى الإنترنت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات آپ کے فون پر ہی شمار ہوتے ہیں۔ شہر منتخب کریں یا اپنا مقام استعمال کریں، انٹرنیٹ کی ضرورت نہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitler telefonunuzda hesaplanır. Bir şehir seçin veya konumunuzu kullanın. İnternet gerekmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jadwal salat dihitung di ponsel Anda. Pilih kota atau gunakan lokasi Anda. Tanpa internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horaires sont calculés sur votre téléphone. Choisissez une ville ou utilisez votre position. Sans internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los horarios se calculan en tu teléfono. Elige una ciudad o usa tu ubicación. Sin internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время намазов рассчитывается на телефоне. Выберите город или используйте геолокацию. Интернет не нужен."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজের সময় আপনার ফোনেই হিসাব করা হয়। একটি শহর বেছে নিন বা আপনার লোকেশন ব্যবহার করুন। ইন্টারনেট লাগবে না।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات نماز روی گوشی شما محاسبه می‌شود. یک شهر انتخاب کنید یا از موقعیت خود استفاده کنید. اینترنت لازم نیست."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات نماز روی موبایل شما محاسبه می‌شود. یک شهر انتخاب کنید یا از موقعیت خود استفاده کنید. انترنت لازم نیست."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拜时间在你的手机上计算。选择一个城市或使用你的位置，无需联网。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमाज़ के समय आपके फ़ोन पर ही निकाले जाते हैं। कोई शहर चुनें या अपनी लोकेशन इस्तेमाल करें। इंटरनेट की ज़रूरत नहीं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os horários de oração são calculados no seu celular. Escolha uma cidade ou use sua localização. Não precisa de internet."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana lissafin lokutan sallah a wayarku. Zaɓi gari ko yi amfani da wurinku. Babu buƙatar intanet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyakati za sala zinahesabiwa kwenye simu yako. Chagua mji au tumia mahali ulipo. Huhitaji intaneti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinakalkula ang mga oras ng dasal sa iyong telepono. Pumili ng lungsod o gamitin ang iyong lokasyon. Hindi kailangan ng internet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ cầu nguyện được tính ngay trên điện thoại. Hãy chọn một thành phố hoặc dùng vị trí của bạn. Không cần internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาละหมาดคำนวณบนโทรศัพท์ของคุณ เลือกเมืองหรือใช้ตำแหน่งของคุณ ไม่ต้องใช้อินเทอร์เน็ต"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ោងសឡាតត្រូវបានគណនានៅលើទូរសព្ទរបស់អ្នក។ ជ្រើសរើសទីក្រុង ឬប្រើទីតាំងរបស់អ្នក។ មិនត្រូវការអ៊ីនធឺណិតទេ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ناماز ۋاقىتلىرى تېلېفونىڭىزدا ھېسابلىنىدۇ. بىر شەھەر تاللاڭ ياكى ئورنىڭىزنى ئىشلىتىڭ. تور كېرەك ئەمەس."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کاتەکانی نوێژ لەسەر مۆبایلەکەت هەژمار دەکرێن. شارێک هەڵبژێرە یان شوێنەکەت بەکاربهێنە. پێویستت بە ئینتەرنێت نییە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaska vremena se izračunavaju na telefonu. Odaberite grad ili koristite svoju lokaciju. Internet nije potreban."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Намаска времена се израчунавају на телефону. Изаберите град или користите своју локацију. Интернет није потребан."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Времињата за намаз се пресметуваат на телефонот. Изберете град или користете ја вашата локација. Не е потребен интернет."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az imaidőket a telefonod számolja ki. Válassz egy várost, vagy használd a helyzetedet. Nem kell hozzá internet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebedstijden worden op je telefoon berekend. Kies een stad of gebruik je locatie. Geen internet nodig."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლოცვის დროები თქვენს ტელეფონზე გამოითვლება. აირჩიეთ ქალაქი ან გამოიყენეთ თქვენი მდებარეობა. ინტერნეტი არ არის საჭირო."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සලාත වේලාවන් ඔබේ දුරකථනයේම ගණනය කෙරේ. නගරයක් තෝරන්න හෝ ඔබේ ස්ථානය භාවිත කරන්න. අන්තර්ජාලය අවශ්‍ය නැත."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నమాజ్ సమయాలు మీ ఫోన్‌లోనే లెక్కించబడతాయి. ఒక నగరాన్ని ఎంచుకోండి లేదా మీ లొకేషన్ ఉపయోగించండి. ఇంటర్నెట్ అవసరం లేదు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಮಾಜ್ ಸಮಯಗಳನ್ನು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲೇ ಲೆಕ್ಕಹಾಕಲಾಗುತ್ತದೆ. ಒಂದು ನಗರವನ್ನು ಆಯ್ಕೆಮಾಡಿ ಅಥವಾ ನಿಮ್ಮ ಸ್ಥಳವನ್ನು ಬಳಸಿ. ಇಂಟರ್ನೆಟ್ ಬೇಕಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നമസ്കാര സമയങ്ങൾ നിങ്ങളുടെ ഫോണിൽ തന്നെ കണക്കാക്കുന്നു. ഒരു നഗരം തിരഞ്ഞെടുക്കുക അല്ലെങ്കിൽ നിങ്ങളുടെ ലൊക്കേഷൻ ഉപയോഗിക്കുക. ഇന്റർനെറ്റ് ആവശ്യമില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नमाजच्या वेळा तुमच्या फोनवरच मोजल्या जातात. एखादे शहर निवडा किंवा तुमचे लोकेशन वापरा. इंटरनेटची गरज नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નમાઝના સમય તમારા ફોન પર જ ગણાય છે. કોઈ શહેર પસંદ કરો અથવા તમારું લોકેશન વાપરો. ઇન્ટરનેટની જરૂર નથી."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਮਾਜ਼ ਦੇ ਵਕਤ ਤੁਹਾਡੇ ਫ਼ੋਨ ’ਤੇ ਹੀ ਗਿਣੇ ਜਾਂਦੇ ਹਨ। ਕੋਈ ਸ਼ਹਿਰ ਚੁਣੋ ਜਾਂ ਆਪਣਾ ਟਿਕਾਣਾ ਵਰਤੋ। ਇੰਟਰਨੈੱਟ ਦੀ ਲੋੜ ਨਹੀਂ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজৰ সময় আপোনাৰ ফোনতে গণনা কৰা হয়। এখন চহৰ বাছক বা আপোনাৰ অৱস্থান ব্যৱহাৰ কৰক। ইণ্টাৰনেটৰ প্ৰয়োজন নাই।"
          }
        }
      }
    },

          "stringUnit": {
            "state": "translated",
            "value": "लोकेशन की अनुमति बंद है। आप सेटिंग्स में इसे चालू कर सकते हैं या कोई शहर चुन सकते हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à localização está desativado. Você pode permiti-lo em Configurações ou escolher uma cidade."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An kashe damar shiga wuri. Kuna iya ba da izini a Saituna ko zaɓi gari."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufikiaji wa mahali umezimwa. Unaweza kuuruhusu kwenye Mipangilio au kuchagua mji."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang access sa lokasyon. Maaari mo itong payagan sa Mga Setting o pumili ng lungsod."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập vị trí đang tắt. Bạn có thể cho phép trong Cài đặt hoặc chọn một thành phố."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเข้าถึงตำแหน่งปิดอยู่ คุณอนุญาตได้ในการตั้งค่าหรือเลือกเมือง"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចូលប្រើទីតាំងត្រូវបានបិទ។ អ្នកអាចអនុញ្ញាតវានៅក្នុងការកំណត់ ឬជ្រើសរើសទីក្រុង។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئورۇن ئىجازىتى تاقاق. تەڭشەكتە ئىجازەت بەرسىڭىز ياكى بىر شەھەر تاللىسىڭىز بولىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دەستگەیشتن بە شوێن کوژاوەتەوە. دەتوانیت لە ڕێکخستنەکان ڕێگەی پێ بدەیت یان شارێک هەڵبژێریت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pristup lokaciji je isključen. Možete ga dozvoliti u postavkama ili odabrati grad."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Приступ локацији је искључен. Можете га дозволити у подешавањима или изабрати град."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пристапот до локацијата е исклучен. Можете да го дозволите во поставките или да изберете град."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A helyhozzáférés ki van kapcsolva. Engedélyezheted a Beállításokban, vagy választhatsz várost."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Locatietoegang staat uit. Je kunt het toestaan in Instellingen of een stad kiezen."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მდებარეობაზე წვდომა გამორთულია. შეგიძლიათ დაუშვათ პარამეტრებში ან აირჩიოთ ქალაქი."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ස්ථාන ප්‍රවේශය අක්‍රියයි. ඔබට සැකසීම්වල එයට ඉඩ දිය හැක හෝ නගරයක් තෝරා ගත හැක."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లొకేషన్ యాక్సెస్ ఆఫ్‌లో ఉంది. మీరు సెట్టింగ్‌లలో అనుమతించవచ్చు లేదా నగరాన్ని ఎంచుకోవచ్చు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಳ ಪ್ರವೇಶ ಆಫ್ ಆಗಿದೆ. ನೀವು ಅದನ್ನು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಅನುಮತಿಸಬಹುದು ಅಥವಾ ನಗರವನ್ನು ಆಯ್ಕೆಮಾಡಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൊക്കേഷൻ ആക്സസ് ഓഫാണ്. നിങ്ങൾക്ക് ക്രമീകരണങ്ങളിൽ അത് അനുവദിക്കാം അല്ലെങ്കിൽ ഒരു നഗരം തിരഞ്ഞെടുക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकेशन ॲक्सेस बंद आहे. तुम्ही तो सेटिंग्जमध्ये चालू करू शकता किंवा एखादे शहर निवडू शकता."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લોકેશનની ઍક્સેસ બંધ છે. તમે સેટિંગ્સમાં તેને ચાલુ કરી શકો છો અથવા કોઈ શહેર પસંદ કરી શકો છો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਟਿਕਾਣੇ ਦੀ ਪਹੁੰਚ ਬੰਦ ਹੈ। ਤੁਸੀਂ ਸੈਟਿੰਗਾਂ ਵਿੱਚ ਇਜਾਜ਼ਤ ਦੇ ਸਕਦੇ ਹੋ ਜਾਂ ਕੋਈ ਸ਼ਹਿਰ ਚੁਣ ਸਕਦੇ ਹੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "অৱস্থানৰ অনুমতি অফ আছে। আপুনি ছেটিংছত ইয়াক অন কৰিব পাৰে বা এখন চহৰ বাছিব পাৰে।"
          }
        }
      }
    },

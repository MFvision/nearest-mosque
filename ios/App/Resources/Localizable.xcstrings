    "onb_welcome_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prayer times, the Qibla, nearby mosques and answers from trusted sources, all on your phone and working offline."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مواقيت الصلاة والقبلة وأقرب المساجد وإجابات من مصادر موثوقة، كلها على هاتفك وتعمل دون إنترنت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز کے اوقات، قبلہ، قریبی مساجد اور معتبر ذرائع سے جوابات، سب آپ کے فون پر اور بغیر انٹرنیٹ کے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz vakitleri, kıble, yakındaki camiler ve güvenilir kaynaklardan cevaplar; hepsi telefonunuzda ve çevrimdışı çalışır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu salat, kiblat, masjid terdekat, dan jawaban dari sumber tepercaya, semuanya di ponsel Anda dan bisa tanpa internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Horaires de prière, qibla, mosquées proches et réponses tirées de sources fiables, sur votre téléphone et hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horarios de oración, la alquibla, mezquitas cercanas y respuestas de fuentes fiables, en tu teléfono y sin conexión."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время намазов, кибла, мечети поблизости и ответы из надёжных источников — всё на вашем телефоне и без интернета."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজের সময়, কিবলা, কাছের মসজিদ এবং বিশ্বস্ত উৎস থেকে উত্তর, সবকিছু আপনার ফোনে এবং অফলাইনে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات نماز، قبله، مسجدهای نزدیک و پاسخ از منابع معتبر، همه روی گوشی شما و بدون اینترنت."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات نماز، قبله، مساجد نزدیک و پاسخ از منابع معتبر، همه روی موبایل شما و بدون انترنت."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "礼拜时间、朝向、附近的清真寺以及来自可靠来源的回答，全部在你的手机上，离线可用。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नमाज़ के समय, क़िबला, आसपास की मस्जिदें और भरोसेमंद स्रोतों से जवाब, सब आपके फ़ोन पर और ऑफ़लाइन।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Horários de oração, a Qibla, mesquitas próximas e respostas de fontes confiáveis, tudo no seu celular e funcionando offline."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokutan sallah, Alƙibla, masallatan da ke kusa da amsoshi daga majiyoyi amintattu, duk a wayarku kuma suna aiki ba tare da intanet ba."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyakati za sala, Kibla, misikiti iliyo karibu na majibu kutoka vyanzo vinavyoaminika, vyote kwenye simu yako na vinafanya kazi bila intaneti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga oras ng dasal, ang Qibla, mga kalapit na masjid at mga sagot mula sa mapagkakatiwalaang sanggunian, lahat nasa iyong telepono at gumagana offline."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ cầu nguyện, hướng Qibla, thánh đường gần đó và câu trả lời từ các nguồn đáng tin cậy, tất cả trên điện thoại của bạn và hoạt động ngoại tuyến."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาละหมาด กิบลัต มัสยิดใกล้เคียง และคำตอบจากแหล่งที่เชื่อถือได้ ทั้งหมดอยู่ในโทรศัพท์ของคุณและใช้งานออฟไลน์ได้"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ោងសឡាត គិបឡាត់ ម៉ាស្ជិតក្បែរៗ និងចម្លើយពីប្រភពដែលគួរឱ្យទុកចិត្ត ទាំងអស់នៅលើទូរសព្ទរបស់អ្នក ហើយដំណើរការក្រៅបណ្ដាញ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ناماز ۋاقىتلىرى، قىبلە، يېقىن ئەتراپتىكى مەسچىتلەر ۋە ئىشەنچلىك مەنبەلەردىن جاۋابلار، ھەممىسى تېلېفونىڭىزدا، تورسىز ئىشلەيدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کاتەکانی نوێژ، قیبلە، مزگەوتە نزیکەکان و وەڵام لە سەرچاوە متمانەپێکراوەکانەوە، هەمووی لەسەر مۆبایلەکەت و بێ ئینتەرنێت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaska vremena, kibla, džamije u blizini i odgovori iz pouzdanih izvora, sve na vašem telefonu i bez interneta."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Намаска времена, кибла, џамије у близини и одговори из поузданих извора, све на вашем телефону и без интернета."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Времиња за намаз, киблата, џамии во близина и одговори од доверливи извори, сè на вашиот телефон и без интернет."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaidők, kibla, közeli mecsetek és megbízható forrásokból származó válaszok, mind a telefonodon, internet nélkül is."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebedstijden, de qibla, moskeeën in de buurt en antwoorden uit betrouwbare bronnen, allemaal op je telefoon en offline."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლოცვის დროები, ყიბლა, ახლომდებარე მეჩეთები და პასუხები სანდო წყაროებიდან — ყველაფერი თქვენს ტელეფონზე და ოფლაინ."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සලාත වේලාවන්, කිබ්ලා, අසල පල්ලි සහ විශ්වාසදායී මූලාශ්‍රවලින් පිළිතුරු, සියල්ල ඔබේ දුරකථනයේ, නොබැඳිවද ක්‍රියා කරයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నమాజ్ సమయాలు, ఖిబ్లా, దగ్గరి మసీదులు, నమ్మకమైన మూలాల నుండి సమాధానాలు, అన్నీ మీ ఫోన్‌లో, ఆఫ్‌లైన్‌లో పనిచేస్తాయి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಮಾಜ್ ಸಮಯಗಳು, ಕಿಬ್ಲಾ, ಹತ್ತಿರದ ಮಸೀದಿಗಳು ಮತ್ತು ವಿಶ್ವಾಸಾರ್ಹ ಮೂಲಗಳಿಂದ ಉತ್ತರಗಳು, ಎಲ್ಲವೂ ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ, ಆಫ್‌ಲೈನ್‌ನಲ್ಲೂ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നമസ്കാര സമയങ്ങൾ, ഖിബ്‌ല, അടുത്തുള്ള പള്ളികൾ, വിശ്വസനീയ ഉറവിടങ്ങളിൽ നിന്നുള്ള ഉത്തരങ്ങൾ, എല്ലാം നിങ്ങളുടെ ഫോണിൽ, ഓഫ്‌ലൈനായും പ്രവർത്തിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नमाजच्या वेळा, किब्ला, जवळच्या मशिदी आणि विश्वासार्ह स्रोतांमधून उत्तरे, सर्व काही तुमच्या फोनवर आणि ऑफलाइन."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નમાઝના સમય, કિબ્લા, નજીકની મસ્જિદો અને વિશ્વસનીય સ્રોતોમાંથી જવાબો, બધું તમારા ફોન પર અને ઑફલાઇન."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਮਾਜ਼ ਦੇ ਵਕਤ, ਕਿਬਲਾ, ਨੇੜਲੀਆਂ ਮਸਜਿਦਾਂ ਅਤੇ ਭਰੋਸੇਯੋਗ ਸਰੋਤਾਂ ਤੋਂ ਜਵਾਬ, ਸਭ ਤੁਹਾਡੇ ਫ਼ੋਨ ’ਤੇ ਅਤੇ ਆਫ਼ਲਾਈਨ ਕੰਮ ਕਰਦੇ ਹਨ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজৰ সময়, কিবলা, ওচৰৰ মছজিদ আৰু বিশ্বাসযোগ্য উৎসৰ পৰা উত্তৰ, সকলো আপোনাৰ ফোনত আৰু অফলাইনত।"
          }
        }
      }
    },

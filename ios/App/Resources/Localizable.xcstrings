    "intent_open_prayer_times_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Near Mosque on today's prayer times."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح تطبيق أقرب مسجد على مواقيت صلاة اليوم."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریبی مسجد ایپ کو آج کے نماز کے اوقات پر کھولتا ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque’u bugünün namaz vakitlerinde açar."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Near Mosque pada jadwal salat hari ini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Near Mosque sur les horaires de prière du jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Near Mosque en los horarios de oración de hoy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Near Mosque на сегодняшнем расписании молитв."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque আজকের নামাজের সময়ে খোলে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامهٔ نزدیک‌ترین مسجد را روی اوقات نماز امروز باز می‌کند."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامهٔ نزدیک‌ترین مسجد را روی اوقات نماز امروز باز می‌کند."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在今天的礼拜时间页面打开 Near Mosque。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque को आज के नमाज़ के समय पर खोलता है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Near Mosque nos horários de oração de hoje."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana buɗe Near Mosque a kan lokutan sallah na yau."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hufungua Near Mosque kwenye nyakati za sala za leo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binubuksan ang Near Mosque sa oras ng salah ngayong araw."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Near Mosque ở giờ cầu nguyện hôm nay."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Near Mosque ที่เวลาละหมาดของวันนี้"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើក Near Mosque នៅម៉ោងសឡាតថ្ងៃនេះ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "«ئەڭ يېقىن مەسچىت» نى بۈگۈنكى ناماز ۋاقىتلىرىدا ئاچىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەپی نزیکترین مزگەوت لەسەر کاتەکانی نوێژی ئەمڕۆ دەکاتەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara Near Mosque na današnjoj vaktiji."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвара Near Mosque на данашњим временима молитве."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Го отвора Near Mosque на денешните времиња за молитва."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja az Near Mosque alkalmazást a mai imaidőknél."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Near Mosque op de gebedstijden van vandaag."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ხსნის Near Mosque-ს დღევანდელი ლოცვის დროზე."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque අද සලාත් වේලාවන්හි විවෘත කරයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque ను ఈరోజు నమాజ్ సమయాల వద్ద తెరుస్తుంది."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque ಅನ್ನು ಇಂದಿನ ನಮಾಜ್ ಸಮಯಗಳಲ್ಲಿ ತೆರೆಯುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque ഇന്നത്തെ നമസ്കാര സമയങ്ങളിൽ തുറക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque आजच्या नमाजाच्या वेळांवर उघडते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque ને આજના નમાઝના સમય પર ખોલે છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque ਨੂੰ ਅੱਜ ਦੇ ਨਮਾਜ਼ ਦੇ ਸਮਿਆਂ ’ਤੇ ਖੋਲ੍ਹਦਾ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "Near Mosque আজিৰ নামাজৰ সময়ত খোলে।"
          }
        }
      }
    },

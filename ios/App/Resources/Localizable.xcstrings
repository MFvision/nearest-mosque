    "library_downloads_empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books you open are kept here for reading offline."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتب التي تفتحها تُحفظ هنا لقراءتها دون إنترنت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو کتابیں آپ کھولتے ہیں وہ آف لائن پڑھنے کے لیے یہاں رہتی ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açtığınız kitaplar çevrimdışı okumak için burada tutulur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku yang Anda buka disimpan di sini untuk dibaca offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les livres ouverts sont gardés ici pour une lecture hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los libros que abres se guardan aquí para leer sin conexión."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытые книги хранятся здесь для чтения без интернета."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার খোলা বইগুলো অফলাইনে পড়ার জন্য এখানে রাখা হয়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کتاب‌هایی که باز می‌کنید برای خواندن آفلاین اینجا نگه داشته می‌شوند."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "کتاب‌هایی که باز می‌کنید برای خواندن آفلاین اینجا نگه داشته می‌شوند."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打开的书籍会保存在这里，供离线阅读。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी खोली गई किताबें ऑफ़लाइन पढ़ने के लिए यहाँ रखी जाती हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os livros que você abre ficam aqui para ler offline."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Littattafan da kuka buɗe ana ajiye su a nan don karantawa ba tare da intanet ba."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitabu unavyofungua vinawekwa hapa ili usome bila intaneti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dito itinatago ang mga aklat na binubuksan mo para mabasa offline."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sách bạn mở được giữ ở đây để đọc ngoại tuyến."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หนังสือที่คุณเปิดจะเก็บไว้ที่นี่เพื่ออ่านแบบออฟไลน์"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សៀវភៅដែលអ្នកបើកត្រូវបានរក្សាទុកនៅទីនេះ សម្រាប់អានក្រៅបណ្ដាញ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "سىز ئاچقان كىتابلار تورسىز ئوقۇش ئۈچۈن بۇ يەردە ساقلىنىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەو کتێبانەی دەیانکەیتەوە لێرە دەمێننەوە بۆ خوێندنەوەی ئۆفلاین."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Knjige koje otvorite čuvaju se ovdje za čitanje bez interneta."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Књиге које отворите чувају се овде за читање ван мреже."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Книгите што ги отворате се чуваат овде за читање без интернет."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megnyitott könyveid itt maradnak offline olvasásra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boeken die je opent worden hier bewaard om offline te lezen."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენ მიერ გახსნილი წიგნები აქ ინახება ოფლაინ წასაკითხად."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ විවෘත කරන පොත් නොබැඳිව කියවීම සඳහා මෙහි තබා ගැනේ."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు తెరిచే పుస్తకాలు ఆఫ్‌లైన్ పఠనం కోసం ఇక్కడ ఉంచబడతాయి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ತೆರೆಯುವ ಪುಸ್ತಕಗಳನ್ನು ಆಫ್‌ಲೈನ್ ಓದುವಿಕೆಗಾಗಿ ಇಲ್ಲಿ ಇರಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തുറക്കുന്ന പുസ്തകങ്ങൾ ഓഫ്‌ലൈൻ വായനയ്ക്കായി ഇവിടെ സൂക്ഷിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही उघडलेली पुस्तके ऑफलाइन वाचण्यासाठी इथे ठेवली जातात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ખોલેલાં પુસ્તકો ઑફલાઇન વાંચવા માટે અહીં રખાય છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੋ ਕਿਤਾਬਾਂ ਤੁਸੀਂ ਖੋਲ੍ਹਦੇ ਹੋ ਉਹ ਆਫ਼ਲਾਈਨ ਪੜ੍ਹਨ ਲਈ ਇੱਥੇ ਰਹਿੰਦੀਆਂ ਹਨ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপুনি খোলা কিতাপবোৰ অফলাইনত পঢ়িবলৈ ইয়াত ৰখা হয়।"
          }
        }
      }
    },

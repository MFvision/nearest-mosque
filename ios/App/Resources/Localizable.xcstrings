    "cloud_ai_off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. Questions never leave your phone."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوقف. لا تغادر أسئلتك هاتفك."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بند۔ سوالات آپ کے فون سے باہر نہیں جاتے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı. Sorular telefonunuzdan çıkmaz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mati. Pertanyaan tidak pernah keluar dari ponsel Anda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivée. Vos questions ne quittent jamais le téléphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivada. Tus preguntas nunca salen del teléfono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключен. Вопросы не покидают ваш телефон."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বন্ধ। প্রশ্ন কখনো আপনার ফোনের বাইরে যায় না।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش. سؤال‌ها هرگز از گوشی شما خارج نمی‌شوند."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش. سوال‌ها هرگز از موبایل شما خارج نمی‌شوند."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已关闭。问题绝不会离开你的手机。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद। सवाल कभी आपके फ़ोन से बाहर नहीं जाते।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativada. As perguntas nunca saem do seu celular."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "A kashe. Tambayoyi ba sa barin wayarku."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imezimwa. Maswali hayatoki kamwe kwenye simu yako."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off. Hindi kailanman lumalabas sa iyong telepono ang mga tanong."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt. Câu hỏi không bao giờ rời khỏi điện thoại của bạn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิด คำถามไม่เคยออกจากโทรศัพท์ของคุณ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បិទ។ សំណួរមិនដែលចាកចេញពីទូរសព្ទរបស់អ្នកទេ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "تاقاق. سوئاللار ھەرگىز تېلېفونىڭىزدىن چىقمايدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ناچالاک. پرسیارەکان هەرگیز لە مۆبایلەکەت دەرناچن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključeno. Pitanja nikad ne napuštaju vaš telefon."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Искључено. Питања никада не напуштају ваш телефон."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Исклучено. Прашањата никогаш не го напуштаат вашиот телефон."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kikapcsolva. A kérdések soha nem hagyják el a telefonodat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit. Vragen verlaten je telefoon nooit."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "გამორთულია. კითხვები არასოდეს ტოვებს თქვენს ტელეფონს."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "අක්‍රියයි. ප්‍රශ්න කිසි විටෙක ඔබේ දුරකථනයෙන් පිටතට නොයයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆఫ్. ప్రశ్నలు మీ ఫోన్ నుండి ఎప్పుడూ బయటకు వెళ్లవు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಫ್. ಪ್ರಶ್ನೆಗಳು ಎಂದಿಗೂ ನಿಮ್ಮ ಫೋನ್‌ನಿಂದ ಹೊರಗೆ ಹೋಗುವುದಿಲ್ಲ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഓഫ്. ചോദ്യങ്ങൾ ഒരിക്കലും നിങ്ങളുടെ ഫോണിൽ നിന്ന് പുറത്തുപോകില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद. प्रश्न कधीही तुमच्या फोनबाहेर जात नाहीत."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "બંધ. સવાલો ક્યારેય તમારા ફોનની બહાર જતા નથી."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਬੰਦ। ਸਵਾਲ ਕਦੇ ਵੀ ਤੁਹਾਡੇ ਫ਼ੋਨ ਤੋਂ ਬਾਹਰ ਨਹੀਂ ਜਾਂਦੇ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "অফ। প্ৰশ্নবোৰ কেতিয়াও আপোনাৰ ফোনৰ বাহিৰলৈ নাযায়।"
          }
        }
      }
    },

        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಸ್ಥಳ ಪತ್ತೆಯಾಗಲಿಲ್ಲ. ಹೊರಗೆ ಹೋಗಿ ಅಥವಾ ನಗರವನ್ನು ಆಯ್ಕೆಮಾಡಿ."

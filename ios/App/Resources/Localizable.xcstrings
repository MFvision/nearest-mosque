    "content_done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed. Ask now answers from it too."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم التثبيت. أصبح «اسأل» يجيب منه أيضًا."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انسٹال ہو گیا۔ اب “پوچھیں” اس سے بھی جواب دیتا ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüklendi. “Sor” artık buradan da yanıt veriyor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terpasang. Kini “Tanya” juga menjawab dari konten ini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installé. « Demander » répond désormais aussi à partir de ce contenu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalado. Ahora «Preguntar» también responde con este contenido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установлено. Теперь «Спросить» отвечает и по этим материалам."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনস্টল হয়েছে। এখন “প্রশ্ন করুন” এটি থেকেও উত্তর দেয়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نصب شد. اکنون «بپرسید» از این محتوا هم پاسخ می‌دهد."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "نصب شد. حالا «بپرسید» از این محتوا هم جواب می‌دهد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装。“提问”现在也会依据这些内容作答。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉल हो गया। अब “पूछें” इससे भी जवाब देता है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalado. Agora o “Perguntar” também responde com base nele."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An saka. Yanzu “Tambaya” yana amsawa daga ciki ma."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imesakinishwa. Sasa “Uliza” hujibu pia kutoka kwake."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-install na. Sumasagot na rin mula rito ang “Magtanong.”"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã cài đặt. Giờ “Hỏi” cũng trả lời dựa trên nội dung này."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ติดตั้งแล้ว ตอนนี้ “ถาม” ตอบจากเนื้อหานี้ได้ด้วย"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានដំឡើងហើយ។ ឥឡូវ «សួរ» ក៏ឆ្លើយពីខ្លឹមសារនេះដែរ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئورنىتىلدى. ئەمدى «سوراش» بۇنىڭدىنمۇ جاۋاب بېرىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "دامەزرا. ئێستا «بپرسە» لەمەشەوە وەڵام دەداتەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalirano. „Pitaj“ sada odgovara i iz ovog sadržaja."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирано. „Питај“ сада одговара и из овог садржаја."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Инсталирано. „Прашај“ сега одговара и од оваа содржина."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Telepítve. A „Kérdezz” mostantól ebből is válaszol."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geïnstalleerd. ‘Vraag’ antwoordt nu ook hieruit."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დაინსტალირდა. ახლა „კითხვა“ ამ მასალიდანაც პასუხობს."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ස්ථාපනය විය. දැන් “අහන්න” මෙයින්ද පිළිතුරු දෙයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇన్‌స్టాల్ అయింది. ఇప్పుడు “అడగండి” దీని నుండి కూడా సమాధానం ఇస్తుంది."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇನ್‌ಸ್ಟಾಲ್ ಆಗಿದೆ. ಈಗ “ಕೇಳಿ” ಇದರಿಂದಲೂ ಉತ್ತರಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഇൻസ്റ്റാൾ ചെയ്തു. ഇനി “ചോദിക്കൂ” ഇതിൽ നിന്നും ഉത്തരം നൽകും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इन्स्टॉल झाले. आता “विचारा” यातूनही उत्तर देते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ઇન્સ્ટોલ થઈ ગયું. હવે “પૂછો” આમાંથી પણ જવાબ આપે છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇੰਸਟਾਲ ਹੋ ਗਿਆ। ਹੁਣ “ਪੁੱਛੋ” ਇਸ ਤੋਂ ਵੀ ਜਵਾਬ ਦਿੰਦਾ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "ইনষ্টল হ'ল। এতিয়া “সোধক”এ ইয়াৰ পৰাও উত্তৰ দিয়ে।"
          }
        }
      }
    },

    "library_card_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books, fatwas, lectures and the Quran: read, listen or watch offline."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتب وفتاوى ومحاضرات والقرآن: اقرأ أو استمع أو شاهد دون اتصال."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کتابیں، فتاویٰ، لیکچرز اور قرآن: آف لائن پڑھیں، سنیں یا دیکھیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplar, fetvalar, dersler ve Kur'an: çevrimdışı okuyun, dinleyin veya izleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku, fatwa, ceramah, dan Al-Qur'an: baca, dengarkan, atau tonton secara offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Livres, fatwas, conférences et Coran : lire, écouter ou regarder hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libros, fetuas, conferencias y el Corán: lea, escuche o vea sin conexión."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Книги, фетвы, лекции и Коран: читайте, слушайте и смотрите без интернета."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বই, ফতোয়া, বয়ান ও কুরআন: অফলাইনে পড়ুন, শুনুন বা দেখুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کتاب‌ها، فتواها، سخنرانی‌ها و قرآن: بدون اینترنت بخوانید، بشنوید یا تماشا کنید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "کتاب‌ها، فتواها، سخنرانی‌ها و قرآن: بدون انترنت بخوانید، بشنوید یا تماشا کنید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书籍、法特瓦、讲座和古兰经：离线阅读、收听或观看。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किताबें, फ़तवे, बयान और क़ुरआन: ऑफ़लाइन पढ़ें, सुनें या देखें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Livros, fatwas, palestras e o Alcorão: leia, ouça ou assista offline."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Littattafai, fatawoyi, laccoci da Alƙur'ani: karanta, saurara ko kalla ba tare da intanet ba."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitabu, fatwa, mihadhara na Qur'ani: soma, sikiliza au tazama bila intaneti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga aklat, fatwa, lektyur at ang Qur'an: magbasa, makinig o manood offline."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sách, fatwa, bài giảng và Qur’an: đọc, nghe hoặc xem ngoại tuyến."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หนังสือ ฟัตวา การบรรยาย และอัลกุรอาน: อ่าน ฟัง หรือดูแบบออฟไลน์"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សៀវភៅ ហ្វាតវ៉ា ការបង្រៀន និងគម្ពីរគូរ៉ាន៖ អាន ស្ដាប់ ឬមើលក្រៅបណ្ដាញ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "كىتاب، پەتىۋا، لېكسىيە ۋە قۇرئان: تورسىز ئوقۇڭ، ئاڭلاڭ ياكى كۆرۈڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کتێب، فەتوا، وانە و قورئان: بێ ئینتەرنێت بخوێنەرەوە، گوێ بگرە یان سەیر بکە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Knjige, fetve, predavanja i Kur'an: čitajte, slušajte ili gledajte bez interneta."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Књиге, фетве, предавања и Кур'ан: читајте, слушајте или гледајте ван мреже."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Книги, фетви, предавања и Куранот: читајте, слушајте или гледајте без интернет."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Könyvek, fatvák, előadások és a Korán: olvasd, hallgasd vagy nézd internet nélkül."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boeken, fatwa’s, lezingen en de Koran: lees, luister of kijk offline."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "წიგნები, ფეთვები, ლექციები და ყურანი: წაიკითხეთ, მოუსმინეთ ან უყურეთ ოფლაინ."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "පොත්, ෆත්වා, දේශන සහ කුර්ආනය: නොබැඳිව කියවන්න, අසන්න හෝ නරඹන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పుస్తకాలు, ఫత్వాలు, ప్రసంగాలు మరియు ఖురాన్: ఆఫ్‌లైన్‌లో చదవండి, వినండి లేదా చూడండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಪುಸ್ತಕಗಳು, ಫತ್ವಾಗಳು, ಉಪನ್ಯಾಸಗಳು ಮತ್ತು ಕುರ್‌ಆನ್: ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿ ಓದಿ, ಆಲಿಸಿ ಅಥವಾ ವೀಕ್ಷಿಸಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "പുസ്തകങ്ങൾ, ഫത്‌വകൾ, പ്രഭാഷണങ്ങൾ, ഖുർആൻ: ഓഫ്‌ലൈനായി വായിക്കുക, കേൾക്കുക, കാണുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "पुस्तके, फतवे, व्याख्याने आणि कुरआन: ऑफलाइन वाचा, ऐका किंवा पाहा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "પુસ્તકો, ફતવા, પ્રવચનો અને કુરઆન: ઑફલાઇન વાંચો, સાંભળો કે જુઓ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਤਾਬਾਂ, ਫ਼ਤਵੇ, ਲੈਕਚਰ ਅਤੇ ਕੁਰਆਨ: ਆਫ਼ਲਾਈਨ ਪੜ੍ਹੋ, ਸੁਣੋ ਜਾਂ ਵੇਖੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "কিতাপ, ফতোৱা, বক্তৃতা আৰু কোৰআন: অফলাইনত পঢ়ক, শুনক বা চাওক।"
          }
        }
      }
    },

        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकेशन मिळू शकले नाही. बाहेर जा किंवा एखादे शहर निवडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લોકેશન મળી શક્યું નહીં. બહાર જાઓ અથવા કોઈ શહેર પસંદ કરો."

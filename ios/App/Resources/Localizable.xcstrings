          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Littattafanku suna cikin Larabci da Turanci. Ɗaukar magana tana nan a harshenta na asali."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitabu vyako viko kwa Kiarabu na Kiingereza. Manukuu yanabaki katika lugha yake ya asili."

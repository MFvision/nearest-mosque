        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาละหมาดที่เปลี่ยนตามท้องฟ้า"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ោងសឡាតដែលដើរតាមមេឃ"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئاسمانغا ئەگىشىدىغان ناماز ۋاقىتلىرى"
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کاتەکانی نوێژ کە شوێن ئاسمان دەکەون"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaska vremena koja prate nebo"

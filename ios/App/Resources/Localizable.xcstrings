            "value": "ඉස්ලාම් ගැන ඕනෑම දෙයක් අහන්න"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇస్లాం గురించి ఏదైనా అడగండి"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಇಸ್ಲಾಮ್ ಬಗ್ಗೆ ಏನು ಬೇಕಾದರೂ ಕೇಳಿ"

    "widget_kind_mosque_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The nearest mosques, how far they are and which way."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقرب المساجد، وبُعدها، واتجاهها."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریب ترین مساجد، ان کا فاصلہ اور سمت۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En yakın camiler, uzaklıkları ve yönleri."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masjid-masjid terdekat, jaraknya, dan arahnya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mosquées les plus proches, leur distance et leur direction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mezquitas más cercanas, a qué distancia están y en qué dirección."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ближайшие мечети, расстояние до них и направление."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিকটতম মসজিদগুলো, সেগুলোর দূরত্ব ও দিক।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نزدیک‌ترین مسجدها، فاصله و جهت آن‌ها."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "نزدیک‌ترین مساجد، فاصله و جهت آن‌ها."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近的清真寺，有多远、在哪个方向。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे नज़दीकी मस्जिदें, उनकी दूरी और दिशा।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As mesquitas mais próximas, a que distância estão e em que direção."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Masallatai mafi kusa, nisansu da kuma inda suke."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Misikiti iliyo karibu zaidi, umbali wake na upande ilipo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang pinakamalalapit na masjid, gaano kalayo at saang direksyon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thánh đường gần nhất, khoảng cách và hướng đi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มัสยิดที่ใกล้ที่สุด ระยะทาง และทิศทาง"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ាស្ជិតជិតបំផុត ចម្ងាយ និងទិសដៅ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەڭ يېقىن مەسچىتلەر، ئۇلارنىڭ يىراقلىقى ۋە يۆنىلىشى."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "نزیکترین مزگەوتەکان، دووری و ئاراستەیان."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Najbliže džamije, koliko su udaljene i u kojem pravcu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Најближе џамије, колико су удаљене и у ком правцу."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Најблиските џамии, колку се оддалечени и во која насока."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A legközelebbi mecsetek, a távolságuk és az irányuk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dichtstbijzijnde moskeeën, hoe ver ze zijn en in welke richting."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "უახლოესი მეჩეთები, რა მანძილზეა და რა მიმართულებით."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ළඟම පල්ලි, ඒවාට ඇති දුර සහ දිශාව."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దగ్గరి మసీదులు, అవి ఎంత దూరంలో, ఏ దిశలో ఉన్నాయో."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಅತಿ ಹತ್ತಿರದ ಮಸೀದಿಗಳು, ಅವುಗಳ ದೂರ ಮತ್ತು ದಿಕ್ಕು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏറ്റവും അടുത്ത പള്ളികൾ, അവയിലേക്കുള്ള ദൂരവും ദിശയും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वात जवळच्या मशिदी, त्यांचे अंतर आणि दिशा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "સૌથી નજીકની મસ્જિદો, તેમનું અંતર અને દિશા."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਸਭ ਤੋਂ ਨੇੜਲੀਆਂ ਮਸਜਿਦਾਂ, ਉਨ੍ਹਾਂ ਦੀ ਦੂਰੀ ਅਤੇ ਦਿਸ਼ਾ।"
          }
        },
        "as": {

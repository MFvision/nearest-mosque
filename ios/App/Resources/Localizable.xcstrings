        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ కోసం డౌన్‌లోడ్ చేసిన డేటాలో ఈ ప్రదేశం నుండి %2$@ లోపు మసీదులు లేవు. డేటా అసంపూర్ణంగా ఉండవచ్చు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ಗಾಗಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಡೇಟಾದಲ್ಲಿ ಈ ಸ್ಥಳದಿಂದ %2$@ ಒಳಗೆ ಯಾವುದೇ ಮಸೀದಿಗಳಿಲ್ಲ. ಡೇಟಾ ಅಪೂರ್ಣವಾಗಿರಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@-നായി ഡൗൺലോഡ് ചെയ്ത ഡാറ്റയിൽ ഈ സ്ഥലത്തുനിന്ന് %2$@-നുള്ളിൽ പള്ളികളൊന്നുമില്ല. ഡാറ്റ അപൂർണ്ണമായിരിക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ च्या डाउनलोड केलेल्या डेटामध्ये या ठिकाणापासून %2$@ च्या आत कोणतीही मशीद नाही. डेटा अपूर्ण असू शकतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ના ડાઉનલોડ કરેલા ડેટામાં આ જગ્યાથી %2$@ ની અંદર કોઈ મસ્જિદ નથી. ડેટા અધૂરો હોઈ શકે છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ਦੇ ਡਾਊਨਲੋਡ ਕੀਤੇ ਡਾਟਾ ਵਿੱਚ ਇਸ ਥਾਂ ਤੋਂ %2$@ ਦੇ ਅੰਦਰ ਕੋਈ ਮਸਜਿਦ ਨਹੀਂ। ਡਾਟਾ ਅਧੂਰਾ ਹੋ ਸਕਦਾ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ৰ ডাউনলোড কৰা তথ্যত এই ঠাইৰ পৰা %2$@ৰ ভিতৰত কোনো মছজিদ নাই। তথ্য অসম্পূৰ্ণ হ'ব পাৰে।"
          }
        }
      }

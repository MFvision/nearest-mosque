    "confirm_time_zone_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This point is far from the cities we know, so we can’t be sure of its time zone. Prayer times will use %1$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه النقطة بعيدة عن المدن المعروفة لدينا، لذا لا نستطيع الجزم بمنطقتها الزمنية. ستُستخدم %1$@ للمواقيت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ مقام ہمارے معلوم شہروں سے دور ہے، اس لیے ٹائم زون یقینی نہیں۔ اوقات کے لیے %1$@ استعمال ہوگا۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu nokta bildiğimiz şehirlerden uzak, saat dilimi kesin değil. Vakitler için %1$@ kullanılacak."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Titik ini jauh dari kota yang kami kenal, jadi zona waktunya belum pasti. Jadwal akan memakai %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce point est loin des villes connues : son fuseau est incertain. Les horaires utiliseront %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este punto está lejos de las ciudades conocidas y su zona horaria es incierta. Se usará %1$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта точка далеко от известных нам городов, поэтому мы не уверены в её часовом поясе. Время намазов будет рассчитано по %1$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই জায়গাটি আমাদের জানা শহরগুলো থেকে দূরে, তাই এর টাইম জোন সম্পর্কে আমরা নিশ্চিত হতে পারছি না। নামাজের সময় %1$@ অনুযায়ী হবে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نقطه از شهرهایی که می‌شناسیم دور است، پس از منطقه زمانی آن مطمئن نیستیم. اوقات نماز با %1$@ محاسبه می‌شود."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "این نقطه از شهرهایی که می‌شناسیم دور است، پس از منطقه زمانی آن مطمئن نیستیم. اوقات نماز با %1$@ محاسبه می‌شود."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此地点离我们已知的城市较远，无法确定其时区。礼拜时间将使用 %1$@。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह जगह हमारे जाने-पहचाने शहरों से दूर है, इसलिए हम इसके टाइम ज़ोन के बारे में पक्के नहीं हो सकते। नमाज़ के समय %1$@ के अनुसार होंगे।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ponto fica longe das cidades que conhecemos, então não temos certeza do fuso horário. Os horários de oração vão usar %1$@."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan wuri yana nesa da garuruwan da muka sani, don haka ba mu da tabbacin yankin lokacinsa. Lokutan sallah za su yi amfani da %1$@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mahali hapa ni mbali na miji tunayoijua, kwa hivyo hatuna uhakika wa saa zake za eneo. Nyakati za sala zitatumia %1$@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Malayo ang puntong ito sa mga lungsod na alam namin, kaya hindi kami sigurado sa time zone nito. Gagamitin ng mga oras ng dasal ang %1$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm này ở xa các thành phố chúng tôi biết, nên không thể chắc chắn về múi giờ. Giờ cầu nguyện sẽ dùng %1$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จุดนี้อยู่ไกลจากเมืองที่เรารู้จัก จึงไม่แน่ใจเรื่องเขตเวลา เวลาละหมาดจะใช้ %1$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចំណុចនេះនៅឆ្ងាយពីទីក្រុងដែលយើងស្គាល់ ដូច្នេះយើងមិនអាចប្រាកដអំពីល្វែងម៉ោងរបស់វាបានទេ។ ម៉ោងសឡាតនឹងប្រើ %1$@។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ نۇقتا بىز بىلىدىغان شەھەرلەردىن يىراق، شۇڭا ئۇنىڭ ۋاقىت رايونىغا جەزم قىلالمايمىز. ناماز ۋاقىتلىرى %1$@ نى ئىشلىتىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم خاڵە لەو شارانەی دەیانناسین دوورە، بۆیە دڵنیا نین لە ناوچەی کاتەکەی. کاتەکانی نوێژ %1$@ بەکاردەهێنن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ova tačka je daleko od gradova koje poznajemo, pa ne možemo biti sigurni u njenu vremensku zonu. Namaska vremena će koristiti %1$@."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ова тачка је далеко од градова које познајемо, па не можемо бити сигурни у њену временску зону. Намаска времена ће користити %1$@."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оваа точка е далеку од градовите што ги знаеме, па не можеме да бидеме сигурни во нејзината временска зона. Времињата за намаз ќе користат %1$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez a pont messze van az általunk ismert városoktól, ezért nem lehetünk biztosak az időzónájában. Az imaidők a(z) %1$@ időzónát használják."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit punt ligt ver van de steden die we kennen, dus we weten de tijdzone niet zeker. De gebedstijden gebruiken %1$@."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ეს წერტილი შორსაა ჩვენთვის ცნობილი ქალაქებისგან, ამიტომ მისი სასაათო სარტყელი ზუსტად ვერ განისაზღვრება. ლოცვის დროებისთვის გამოყენებული იქნება %1$@."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම ස්ථානය අප දන්නා නගරවලින් දුරයි, එබැවින් එහි වේලා කලාපය ගැන අපට විශ්වාස කළ නොහැක. සලාත වේලාවන් %1$@ භාවිත කරයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్రదేశం మాకు తెలిసిన నగరాలకు దూరంగా ఉంది, కాబట్టి దాని టైమ్ జోన్ గురించి ఖచ్చితంగా చెప్పలేం. నమాజ్ సమయాలు %1$@ ను ఉపయోగిస్తాయి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಸ್ಥಳವು ನಮಗೆ ತಿಳಿದಿರುವ ನಗರಗಳಿಂದ ದೂರದಲ್ಲಿದೆ, ಆದ್ದರಿಂದ ಅದರ ಸಮಯ ವಲಯದ ಬಗ್ಗೆ ಖಚಿತವಾಗಿ ಹೇಳಲಾಗದು. ನಮಾಜ್ ಸಮಯಗಳು %1$@ ಅನ್ನು ಬಳಸುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ സ്ഥലം ഞങ്ങൾക്ക് അറിയാവുന്ന നഗരങ്ങളിൽ നിന്ന് അകലെയാണ്, അതിനാൽ അതിന്റെ സമയ മേഖല ഉറപ്പിച്ച് പറയാനാവില്ല. നമസ്കാര സമയങ്ങൾ %1$@ ഉപയോഗിക്കും."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हे ठिकाण आम्हाला माहीत असलेल्या शहरांपासून दूर आहे, त्यामुळे त्याच्या टाइम झोनबद्दल आम्हाला खात्री नाही. नमाजच्या वेळा %1$@ नुसार असतील."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ જગ્યા અમે જાણીએ છીએ તે શહેરોથી દૂર છે, તેથી તેના ટાઇમ ઝોન વિશે અમને ખાતરી નથી. નમાઝના સમય %1$@ મુજબ રહેશે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਹ ਥਾਂ ਸਾਡੇ ਜਾਣੇ-ਪਛਾਣੇ ਸ਼ਹਿਰਾਂ ਤੋਂ ਦੂਰ ਹੈ, ਇਸ ਲਈ ਇਸ ਦੇ ਸਮਾਂ ਖੇਤਰ ਬਾਰੇ ਪੱਕਾ ਨਹੀਂ ਕਹਿ ਸਕਦੇ। ਨਮਾਜ਼ ਦੇ ਵਕਤ %1$@ ਵਰਤਣਗੇ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ঠাইখন আমি জনা চহৰবোৰৰ পৰা দূৰত, সেয়েহে ইয়াৰ সময় অঞ্চলৰ বিষয়ে আমি নিশ্চিত হ'ব নোৱাৰোঁ। নামাজৰ সময় %1$@ অনুসৰি হ'ব।"
          }
        }
      }
    },

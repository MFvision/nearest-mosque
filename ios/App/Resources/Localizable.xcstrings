        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ భాష కోసం లైబ్రరీని సిద్ధం చేస్తోంది…"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನಿಮ್ಮ ಭಾಷೆಗಾಗಿ ಗ್ರಂಥಾಲಯವನ್ನು ಸಿದ್ಧಪಡಿಸಲಾಗುತ್ತಿದೆ…"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങളുടെ ഭാഷയ്ക്കായി ലൈബ്രറി തയ്യാറാക്കുന്നു…"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या भाषेसाठी ग्रंथालय तयार करत आहोत…"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારી ભાષા માટે લાઇબ્રેરી તૈયાર કરી રહ્યા છીએ…"
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੀ ਭਾਸ਼ਾ ਲਈ ਲਾਇਬ੍ਰੇਰੀ ਤਿਆਰ ਕੀਤੀ ਜਾ ਰਹੀ ਹੈ…"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপোনাৰ ভাষাৰ বাবে লাইব্ৰেৰী সাজু কৰা হৈছে…"
          }
        }
      }
    },

        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨਮਾਜ਼ ਦੇ ਵਕਤਾਂ ਲਈ ਟਿਕਾਣਾ"
          }
        },
        "as": {
          "stringUnit": {

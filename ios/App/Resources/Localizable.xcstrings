    "region_not_downloaded_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mosque lists work offline for downloaded areas. On this phone: %1$@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قوائم المساجد تعمل دون إنترنت للمناطق المحمّلة. على هذا الهاتف: %1$@."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مساجد کی فہرست ڈاؤن لوڈ شدہ علاقوں میں آف لائن کام کرتی ہے۔ اس فون پر: %1$@۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cami listeleri indirilen bölgelerde çevrim dışı çalışır. Bu telefonda: %1$@."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar masjid berfungsi offline untuk wilayah yang diunduh. Di ponsel ini: %1$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les listes fonctionnent hors ligne pour les zones téléchargées. Sur ce téléphone : %1$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las listas funcionan sin conexión en zonas descargadas. En este teléfono: %1$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Списки мечетей работают офлайн для загруженных районов. На этом телефоне: %1$@."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডাউনলোড করা এলাকার জন্য মসজিদের তালিকা অফলাইনে চলে। এই ফোনে: %1$@।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست مسجدها برای مناطق دانلودشده بدون اینترنت کار می‌کند. روی این گوشی: %1$@."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست مساجد برای ساحات دانلودشده بدون انترنت کار می‌کند. روی این موبایل: %1$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载的地区可离线查看清真寺列表。此手机上：%1$@。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड किए गए इलाक़ों में मस्जिदों की सूची ऑफ़लाइन चलती है। इस फ़ोन पर: %1$@।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As listas de mesquitas funcionam offline nas áreas baixadas. Neste celular: %1$@."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Jerin masallatai yana aiki ba tare da intanet ba a yankunan da aka sauke. A wannan wayar: %1$@."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Orodha za misikiti zinafanya kazi bila intaneti kwa maeneo yaliyopakuliwa. Kwenye simu hii: %1$@."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagana offline ang mga listahan ng masjid para sa mga na-download na lugar. Sa teleponong ito: %1$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách thánh đường hoạt động ngoại tuyến cho các khu vực đã tải về. Trên điện thoại này: %1$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการมัสยิดใช้งานออฟไลน์ได้ในพื้นที่ที่ดาวน์โหลดแล้ว ในโทรศัพท์นี้: %1$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ជីម៉ាស្ជិតដំណើរការក្រៅបណ្ដាញសម្រាប់តំបន់ដែលបានទាញយក។ នៅលើទូរសព្ទនេះ៖ %1$@។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "مەسچىت تىزىملىكى چۈشۈرۈلگەن رايونلاردا تورسىز ئىشلەيدۇ. بۇ تېلېفوندا: %1$@."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لیستی مزگەوتەکان بۆ ناوچە داگیراوەکان بێ ئینتەرنێت کار دەکات. لەسەر ئەم مۆبایلە: %1$@."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste džamija rade bez interneta za preuzeta područja. Na ovom telefonu: %1$@."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Листе џамија раде ван мреже за преузете области. На овом телефону: %1$@."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Списоците на џамии работат без интернет за преземените подрачја. На овој телефон: %1$@."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A mecsetlisták a letöltött területeken internet nélkül is működnek. Ezen a telefonon: %1$@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moskeelijsten werken offline voor gedownloade gebieden. Op deze telefoon: %1$@."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მეჩეთების სიები ოფლაინ მუშაობს ჩამოტვირთულ ტერიტორიებზე. ამ ტელეფონზე: %1$@."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "බාගත කළ ප්‍රදේශ සඳහා පල්ලි ලැයිස්තු නොබැඳිව ක්‍රියා කරයි. මෙම දුරකථනයේ: %1$@."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "డౌన్‌లోడ్ చేసిన ప్రాంతాలకు మసీదుల జాబితాలు ఆఫ్‌లైన్‌లో పనిచేస్తాయి. ఈ ఫోన్‌లో: %1$@."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ಪ್ರದೇಶಗಳಿಗೆ ಮಸೀದಿ ಪಟ್ಟಿಗಳು ಆಫ್‌ಲೈನ್‌ನಲ್ಲಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ. ಈ ಫೋನ್‌ನಲ್ಲಿ: %1$@."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഡൗൺലോഡ് ചെയ്ത പ്രദേശങ്ങളിൽ പള്ളികളുടെ പട്ടിക ഓഫ്‌ലൈനായി പ്രവർത്തിക്കും. ഈ ഫോണിൽ: %1$@."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड केलेल्या भागांसाठी मशिदींची यादी ऑफलाइन चालते. या फोनवर: %1$@."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "ડાઉનલોડ કરેલા વિસ્તારો માટે મસ્જિદોની યાદી ઑફલાઇન ચાલે છે. આ ફોન પર: %1$@."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਮਸਜਿਦਾਂ ਦੀਆਂ ਸੂਚੀਆਂ ਡਾਊਨਲੋਡ ਕੀਤੇ ਖੇਤਰਾਂ ਲਈ ਆਫ਼ਲਾਈਨ ਕੰਮ ਕਰਦੀਆਂ ਹਨ। ਇਸ ਫ਼ੋਨ ’ਤੇ: %1$@।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "ডাউনলোড কৰা অঞ্চলৰ বাবে মছজিদৰ তালিকা অফলাইনত চলে। এই ফোনত: %1$@।"
          }
        }
      }
    },

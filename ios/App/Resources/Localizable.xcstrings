    "hijri_calendar_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hijri dates use the Umm al-Qura calendar. Local moon sighting can differ by a day."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التاريخ الهجري وفق تقويم أم القرى، وقد تختلف رؤية الهلال المحلية بيوم."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہجری تاریخ ام القریٰ کیلنڈر کے مطابق ہے؛ مقامی رؤیت میں ایک دن کا فرق ہو سکتا ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hicri tarihler Ümmü’l-Kurâ takvimine göredir; yerel hilal gözlemi bir gün farklı olabilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanggal Hijriah memakai kalender Umm al-Qura; rukyat lokal bisa berbeda sehari."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates hégiriennes selon le calendrier Umm al-Qura ; l’observation locale peut différer d’un jour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas hégiras usan el calendario Umm al-Qura; el avistamiento local puede variar un día."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Даты по хиджре даны по календарю Умм аль-Кура. Местное наблюдение луны может отличаться на день."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "হিজরি তারিখ উম্মুল কুরা ক্যালেন্ডার অনুযায়ী। স্থানীয় চাঁদ দেখার কারণে এক দিনের পার্থক্য হতে পারে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ‌های هجری قمری بر اساس تقویم ام‌القری است. رؤیت محلی ماه ممکن است یک روز تفاوت داشته باشد."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخ‌های هجری قمری بر اساس تقویم ام‌القری است. رؤیت محلی ماه ممکن است یک روز تفاوت داشته باشد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "希吉来历日期采用乌姆古拉历法。当地见月可能相差一天。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हिजरी तारीख़ें उम्मुल क़ुरा कैलेंडर के अनुसार हैं। स्थानीय चाँद दिखने से एक दिन का फ़र्क़ हो सकता है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas hijri usam o calendário Umm al-Qura. A observação local da lua pode variar em um dia."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwanakin Hijira suna amfani da kalandar Umm al-Qura. Ganin wata a yankinku zai iya bambanta da kwana ɗaya."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarehe za Hijria zinatumia kalenda ya Umm al-Qura. Kuandama kwa mwezi mahali ulipo kunaweza kutofautiana kwa siku moja."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagamit ang mga petsang Hijri ng kalendaryong Umm al-Qura. Maaaring magkaiba nang isang araw ang lokal na pagkakita sa buwan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngày Hijri theo lịch Umm al-Qura. Việc nhìn trăng tại địa phương có thể chênh một ngày."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วันที่ฮิจญ์เราะฮ์ใช้ปฏิทินอุมมุลกุรอ การดูเดือนในท้องถิ่นอาจต่างกันหนึ่งวัน"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "កាលបរិច្ឆេទហ៊ីជរ៉ះប្រើប្រតិទិន Umm al-Qura។ ការមើលព្រះចន្ទក្នុងតំបន់អាចខុសគ្នាមួយថ្ងៃ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ھىجرىيە چېسلالىرى ئۇممۇلقۇرا كالېندارى بويىچە. يەرلىك ئاي كۆرۈش بىر كۈن پەرقلىنىشى مۇمكىن."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ڕێکەوتە کۆچییەکان ڕۆژژمێری ئوم ئەلقورا بەکاردەهێنن. بینینی مانگ لە ناوچەکەت لەوانەیە ڕۆژێک جیاواز بێت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidžretski datumi prate kalendar Umm al-Kura. Lokalno viđenje mladog mjeseca može se razlikovati za jedan dan."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Хиџретски датуми прате календар Умм ал-Кура. Локално виђење младог месеца може се разликовати за један дан."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хиџретските датуми го следат календарот Умм ал-Кура. Локалното гледање на месечината може да се разликува за еден ден."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A hidzsra szerinti dátumok az Umm al-Kura naptárt követik. A helyi holdészlelés egy nappal eltérhet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hijri-data volgen de Umm al-Qura-kalender. Lokale maanwaarneming kan een dag verschillen."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ჰიჯრის თარიღები უმ ალ-ყურას კალენდარს ეყრდნობა. ადგილობრივი მთვარის დანახვა შეიძლება ერთი დღით განსხვავდებოდეს."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "හිජ්රි දින උම්මුල් කුරා දින දර්ශනය භාවිත කරයි. ප්‍රාදේශීය සඳ දර්ශනය අනුව එක් දිනක වෙනසක් විය හැක."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "హిజ్రీ తేదీలు ఉమ్ అల్-ఖురా క్యాలెండర్‌ను ఉపయోగిస్తాయి. స్థానిక నెలవంక దర్శనం వల్ల ఒక రోజు తేడా ఉండవచ్చు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹಿಜರಿ ದಿನಾಂಕಗಳು ಉಮ್ಮುಲ್ ಕುರಾ ಕ್ಯಾಲೆಂಡರ್ ಅನ್ನು ಬಳಸುತ್ತವೆ. ಸ್ಥಳೀಯ ಚಂದ್ರದರ್ಶನದಿಂದ ಒಂದು ದಿನದ ವ್ಯತ್ಯಾಸ ಇರಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഹിജ്റ തീയതികൾ ഉമ്മുൽ ഖുറാ കലണ്ടർ പ്രകാരമാണ്. പ്രാദേശിക മാസപ്പിറവി ദർശനത്തിൽ ഒരു ദിവസത്തെ വ്യത്യാസം വരാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "हिजरी तारखा उम्मुल कुरा कॅलेंडरनुसार आहेत. स्थानिक चंद्रदर्शनामुळे एका दिवसाचा फरक पडू शकतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "હિજરી તારીખો ઉમ્મુલ કુરા કૅલેન્ડર મુજબ છે. સ્થાનિક ચાંદ દેખાવાને કારણે એક દિવસનો ફરક પડી શકે છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਹਿਜਰੀ ਤਾਰੀਖ਼ਾਂ ਉੱਮ ਅਲ-ਕੁਰਾ ਕੈਲੰਡਰ ਮੁਤਾਬਕ ਹਨ। ਸਥਾਨਕ ਚੰਨ ਦੇ ਦੀਦਾਰ ਨਾਲ ਇੱਕ ਦਿਨ ਦਾ ਫ਼ਰਕ ਹੋ ਸਕਦਾ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "হিজৰী তাৰিখবোৰ উম্মুল কুৰা কেলেণ্ডাৰ অনুসৰি। স্থানীয়ভাৱে জোন দেখাৰ কাৰণে এদিনৰ পাৰ্থক্য হ'ব পাৰে।"
          }
        }
      }
    },

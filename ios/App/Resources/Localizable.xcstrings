        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes trechos são os que mais correspondem à sua pergunta. Leia-os no contexto antes de tirar uma conclusão."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Waɗannan nassoshi ne suka fi dacewa da tambayarku. Karanta su a mahallinsu kafin yanke hukunci."

        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$lld ৰ ভিতৰত পৃষ্ঠা %1$lld"
          }
        }
      }
    },
    "onb_prayer_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Times are calculated on your phone for where you are. The sky changes with each prayer and a countdown shows what comes next."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحسب المواقيت على هاتفك لموقعك. تتغير السماء مع كل صلاة، ويعرض العدّ التنازلي الصلاة القادمة."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات آپ کے مقام کے لیے آپ کے فون پر حساب ہوتے ہیں۔ ہر نماز کے ساتھ آسمان بدلتا ہے اور الٹی گنتی اگلی نماز دکھاتی ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakitler bulunduğunuz yer için telefonunuzda hesaplanır. Gökyüzü her namazla değişir, geri sayım sıradakini gösterir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu dihitung di ponsel untuk lokasi Anda. Langit berubah di setiap waktu salat dan hitung mundur menunjukkan salat berikutnya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horaires sont calculés sur votre téléphone pour l’endroit où vous êtes. Le ciel change à chaque prière et un compte à rebours annonce la suivante."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los horarios se calculan en tu teléfono para donde estás. El cielo cambia con cada oración y una cuenta atrás muestra la siguiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время рассчитывается на телефоне для того места, где вы находитесь. Небо меняется с каждым намазом, а обратный отсчёт показывает, что дальше."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যেখানে আছেন সে অনুযায়ী সময় আপনার ফোনেই হিসাব হয়। প্রতিটি নামাজের সাথে আকাশ বদলায় এবং কাউন্টডাউন দেখায় এরপর কী।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات برای جایی که هستید روی گوشی شما محاسبه می‌شود. آسمان با هر نماز تغییر می‌کند و شمارش معکوس نشان می‌دهد بعدی چیست."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات برای جایی که هستید روی موبایل شما محاسبه می‌شود. آسمان با هر نماز تغییر می‌کند و شمارش معکوس نشان می‌دهد بعدی چیست."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你所在的位置在手机上计算时间。天空随每次礼拜而变化，倒计时显示下一次礼拜。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय आपकी जगह के हिसाब से आपके फ़ोन पर निकाले जाते हैं। हर नमाज़ के साथ आसमान बदलता है और उलटी गिनती बताती है कि आगे क्या है।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os horários são calculados no seu celular para onde você está. O céu muda a cada oração e uma contagem regressiva mostra o que vem a seguir."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana lissafin lokuta a wayarku don wurin da kuke. Sararin sama yana canzawa da kowace sallah kuma ƙidaya tana nuna abin da ke tafe."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyakati zinahesabiwa kwenye simu yako kwa mahali ulipo. Anga hubadilika kwa kila sala na hesabu ya kurudi nyuma inaonyesha kinachofuata."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinakalkula ang mga oras sa iyong telepono para sa kinaroroonan mo. Nagbabago ang langit sa bawat dasal at may countdown na nagpapakita ng susunod."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ được tính trên điện thoại cho nơi bạn đang ở. Bầu trời thay đổi theo từng giờ cầu nguyện và đồng hồ đếm ngược cho biết giờ tiếp theo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวลาคำนวณบนโทรศัพท์ของคุณตามที่ที่คุณอยู่ ท้องฟ้าเปลี่ยนไปตามแต่ละเวลาละหมาด และการนับถอยหลังบอกเวลาถัดไป"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ោងត្រូវបានគណនានៅលើទូរសព្ទរបស់អ្នក សម្រាប់កន្លែងដែលអ្នកនៅ។ មេឃប្រែប្រួលតាមសឡាតនីមួយៗ ហើយការរាប់ថយក្រោយបង្ហាញអ្វីដែលនឹងមកដល់បន្ទាប់។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ۋاقىتلار تېلېفونىڭىزدا سىز تۇرغان جاي ئۈچۈن ھېسابلىنىدۇ. ئاسمان ھەر نامازدا ئۆزگىرىدۇ، تەتۈر ساناق كېيىنكىسىنى كۆرسىتىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "کاتەکان بۆ ئەو شوێنەی لێیت لەسەر مۆبایلەکەت هەژمار دەکرێن. ئاسمان لەگەڵ هەر نوێژێک دەگۆڕێت و ژمێرەری پێچەوانە پیشانی دەدات دواتر چی دێت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vremena se izračunavaju na vašem telefonu za mjesto gdje ste. Nebo se mijenja sa svakim namazom, a odbrojavanje pokazuje šta slijedi."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Времена се израчунавају на вашем телефону за место где сте. Небо се мења са сваким намазом, а одбројавање показује шта следи."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Времињата се пресметуваат на вашиот телефон за местото каде што сте. Небото се менува со секој намаз, а одбројувањето покажува што следи."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az időpontokat a telefonod számolja ki arra a helyre, ahol vagy. Az ég minden imával változik, a visszaszámláló pedig mutatja, mi következik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijden worden op je telefoon berekend voor de plek waar je bent. De hemel verandert bij elk gebed en een aftelling toont wat er hierna komt."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "დროები თქვენს ტელეფონზე გამოითვლება იმ ადგილისთვის, სადაც ხართ. ცა ყოველ ლოცვასთან ერთად იცვლება, ხოლო უკუთვლა გიჩვენებთ, რა არის შემდეგი."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ සිටින ස්ථානයට වේලාවන් ඔබේ දුරකථනයේම ගණනය කෙරේ. එක් එක් සලාතය සමඟ අහස වෙනස් වන අතර ඊළඟට එන්නේ කුමක්දැයි ගණන් කිරීමක් පෙන්වයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఉన్న ప్రదేశానికి సమయాలు మీ ఫోన్‌లోనే లెక్కించబడతాయి. ప్రతి నమాజ్‌తో ఆకాశం మారుతుంది, తర్వాత ఏది రాబోతుందో కౌంట్‌డౌన్ చూపిస్తుంది."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ಇರುವ ಸ್ಥಳಕ್ಕೆ ಸಮಯಗಳನ್ನು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲೇ ಲೆಕ್ಕಹಾಕಲಾಗುತ್ತದೆ. ಪ್ರತಿ ನಮಾಜ್‌ನೊಂದಿಗೆ ಆಕಾಶ ಬದಲಾಗುತ್ತದೆ ಮತ್ತು ಮುಂದೇನು ಎಂಬುದನ್ನು ಕ್ಷಣಗಣನೆ ತೋರಿಸುತ್ತದೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ ഉള്ള സ്ഥലത്തിനായി സമയങ്ങൾ നിങ്ങളുടെ ഫോണിൽ കണക്കാക്കുന്നു. ഓരോ നമസ്കാരത്തിനൊപ്പവും ആകാശം മാറുന്നു, അടുത്തത് എന്തെന്ന് കൗണ്ട്ഡൗൺ കാണിക്കുന്നു."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही जिथे आहात त्यानुसार वेळा तुमच्या फोनवर मोजल्या जातात. प्रत्येक नमाजसोबत आकाश बदलते आणि काउंटडाउन पुढे काय आहे ते दाखवतो."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે જ્યાં છો તે મુજબ સમય તમારા ફોન પર ગણાય છે. દરેક નમાઝ સાથે આકાશ બદલાય છે અને કાઉન્ટડાઉન બતાવે છે કે આગળ શું છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਵਕਤ ਤੁਹਾਡੀ ਥਾਂ ਲਈ ਤੁਹਾਡੇ ਫ਼ੋਨ ’ਤੇ ਗਿਣੇ ਜਾਂਦੇ ਹਨ। ਹਰ ਨਮਾਜ਼ ਨਾਲ ਅਸਮਾਨ ਬਦਲਦਾ ਹੈ ਅਤੇ ਉਲਟੀ ਗਿਣਤੀ ਦੱਸਦੀ ਹੈ ਕਿ ਅੱਗੇ ਕੀ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপুনি য'ত আছে সেই অনুসৰি সময় আপোনাৰ ফোনতে গণনা কৰা হয়। প্ৰতিটো নামাজৰ লগে লগে আকাশ সলনি হয় আৰু কাউণ্টডাউনে পিছত কি আহিছে দেখুৱায়।"
          }
        }
      }
    },

        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൈവ് കോമ്പസ് ഇല്ല: സ്വർണ്ണ ബിന്ദു വടക്കിൽ നിന്ന് ഖിബ്‌ല കാണിക്കുന്നു"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव्ह होकायंत्र नाही: सोनेरी ठिपका उत्तरेपासून किब्ला दाखवतो"

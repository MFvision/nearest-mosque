    "library_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From IslamHouse.com and Shaykh Ibn Baz’s official website. Items open inside the app; downloading a book needs internet the first time."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من مكتبة دار الإسلام IslamHouse.com والموقع الرسمي لسماحة الشيخ ابن باز. تُفتح المواد داخل التطبيق، ويحتاج تنزيل الكتاب أول مرة إلى إنترنت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com اور شیخ ابن باز کی آفیشل ویب سائٹ سے۔ مواد ایپ کے اندر کھلتا ہے؛ کتاب پہلی بار ڈاؤن لوڈ کرنے کے لیے انٹرنیٹ درکار ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com ve Şeyh İbn Baz’ın resmî sitesinden. İçerikler uygulamada açılır; bir kitabı ilk kez indirmek için internet gerekir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari IslamHouse.com dan situs resmi Syekh Ibnu Baz. Materi dibuka di dalam aplikasi; unduhan buku pertama memerlukan internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’IslamHouse.com et du site officiel du cheikh Ibn Baz. Les contenus s’ouvrent dans l’app ; le premier téléchargement d’un livre nécessite internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De IslamHouse.com y del sitio oficial del jeque Ibn Baz. El contenido se abre en la app; la primera descarga de un libro necesita internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Из IslamHouse.com и официального сайта шейха Ибн База. Материалы открываются в приложении; для первой загрузки книги нужен интернет."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com এবং শায়খ ইবনে বাযের অফিশিয়াল ওয়েবসাইট থেকে। লেখাগুলো অ্যাপের ভেতরেই খোলে; কোনো বই প্রথমবার ডাউনলোড করতে ইন্টারনেট লাগে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از IslamHouse.com و وب‌سایت رسمی شیخ ابن باز. موارد داخل برنامه باز می‌شوند؛ دانلود کتاب بار اول به اینترنت نیاز دارد."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "از IslamHouse.com و ویب‌سایت رسمی شیخ ابن باز. موارد داخل برنامه باز می‌شوند؛ دانلود کتاب بار اول به انترنت نیاز دارد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 IslamHouse.com 和谢赫 Ibn Baz 的官方网站。内容在应用内打开；首次下载书籍需要联网。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com और शैख़ इब्न बाज़ की आधिकारिक वेबसाइट से। चीज़ें ऐप के अंदर खुलती हैं; किताब पहली बार डाउनलोड करने के लिए इंटरनेट चाहिए।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Da IslamHouse.com e do site oficial do Sheikh Ibn Baz. Os itens abrem dentro do app; baixar um livro precisa de internet na primeira vez."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Daga IslamHouse.com da shafin yanar gizo na hukuma na Shaikh Ibn Baz. Abubuwa suna buɗewa a cikin manhajar; sauke littafi yana buƙatar intanet a karon farko."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutoka IslamHouse.com na tovuti rasmi ya Sheikh Ibn Baz. Vipengee vinafunguka ndani ya programu; kupakua kitabu kunahitaji intaneti mara ya kwanza."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mula sa IslamHouse.com at sa opisyal na website ni Shaykh Ibn Baz. Bumubukas ang mga item sa loob ng app; kailangan ng internet sa unang pag-download ng aklat."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Từ IslamHouse.com và trang web chính thức của Sheikh Ibn Baz. Các mục mở ngay trong ứng dụng; tải một cuốn sách lần đầu cần internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จาก IslamHouse.com และเว็บไซต์ทางการของเชค Ibn Baz รายการต่างๆ เปิดในแอป การดาวน์โหลดหนังสือครั้งแรกต้องใช้อินเทอร์เน็ต"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពី IslamHouse.com និងគេហទំព័រផ្លូវការរបស់ ស្ហេក Ibn Baz។ ធាតុបើកនៅក្នុងកម្មវិធី ការទាញយកសៀវភៅត្រូវការអ៊ីនធឺណិតនៅលើកដំបូង។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com ۋە شەيخ ئىبن بازنىڭ رەسمىي تور بېكىتىدىن. مەزمۇنلار ئەپ ئىچىدە ئېچىلىدۇ؛ كىتابنى تۇنجى قېتىم چۈشۈرۈشتە تور كېرەك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لە IslamHouse.com و ماڵپەڕی فەرمی شێخ ئیبن باز. بابەتەکان لەناو ئەپەکەدا دەکرێنەوە؛ داگرتنی کتێب بۆ یەکەم جار پێویستی بە ئینتەرنێتە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "S IslamHouse.com i zvanične stranice šejha Ibn Baza. Sadržaji se otvaraju u aplikaciji; za prvo preuzimanje knjige potreban je internet."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Са IslamHouse.com и званичног сајта шејха Ибн База. Садржаји се отварају у апликацији; за прво преузимање књиге потребан је интернет."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Од IslamHouse.com и официјалната веб-страница на шеикот Ибн Баз. Материјалите се отвораат во апликацијата; за прво преземање на книга е потребен интернет."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az IslamHouse.com-ról és Ibn Baz sejk hivatalos weboldaláról. Az anyagok az alkalmazásban nyílnak meg; egy könyv első letöltéséhez internet kell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van IslamHouse.com en de officiële website van sjeik Ibn Baz. Items openen in de app; een boek downloaden vereist de eerste keer internet."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com-იდან და შეიხ Ibn Baz-ის ოფიციალური ვებსაიტიდან. მასალები აპის შიგნით იხსნება; წიგნის პირველად ჩამოტვირთვას ინტერნეტი სჭირდება."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com සහ ෂෙයික් Ibn Baz ගේ නිල වෙබ් අඩවියෙන්. අයිතම යෙදුම තුළම විවෘත වේ; පොතක් පළමු වරට බාගත කිරීමට අන්තර්ජාලය අවශ්‍යයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com మరియు షేఖ్ Ibn Baz అధికారిక వెబ్‌సైట్ నుండి. అంశాలు యాప్‌లోనే తెరుచుకుంటాయి; పుస్తకాన్ని మొదటిసారి డౌన్‌లోడ్ చేయడానికి ఇంటర్నెట్ అవసరం."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com ಮತ್ತು ಶೈಖ್ Ibn Baz ಅವರ ಅಧಿಕೃತ ವೆಬ್‌ಸೈಟ್‌ನಿಂದ. ಅಂಶಗಳು ಆ್ಯಪ್‌ನೊಳಗೇ ತೆರೆಯುತ್ತವೆ; ಪುಸ್ತಕವನ್ನು ಮೊದಲ ಬಾರಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಇಂಟರ್ನೆಟ್ ಬೇಕು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com, ശൈഖ് Ibn Baz-ന്റെ ഔദ്യോഗിക വെബ്സൈറ്റ് എന്നിവയിൽ നിന്ന്. ഇനങ്ങൾ ആപ്പിനുള്ളിൽ തുറക്കും; ഒരു പുസ്തകം ആദ്യമായി ഡൗൺലോഡ് ചെയ്യാൻ ഇന്റർനെറ്റ് വേണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com आणि शेख इब्न बाज यांच्या अधिकृत वेबसाइटवरून. साहित्य ॲपमध्येच उघडते; पुस्तक पहिल्यांदा डाउनलोड करण्यासाठी इंटरनेट लागते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com અને શેખ ઇબ્ન બાઝની સત્તાવાર વેબસાઇટ પરથી. સામગ્રી ઍપની અંદર ખૂલે છે; પુસ્તક પહેલી વાર ડાઉનલોડ કરવા માટે ઇન્ટરનેટ જોઈએ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com ਅਤੇ ਸ਼ੇਖ਼ Ibn Baz ਦੀ ਅਧਿਕਾਰਤ ਵੈੱਬਸਾਈਟ ਤੋਂ। ਸਮੱਗਰੀ ਐਪ ਦੇ ਅੰਦਰ ਖੁੱਲ੍ਹਦੀ ਹੈ; ਕਿਤਾਬ ਪਹਿਲੀ ਵਾਰ ਡਾਊਨਲੋਡ ਕਰਨ ਲਈ ਇੰਟਰਨੈੱਟ ਚਾਹੀਦਾ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "IslamHouse.com আৰু শ্বেইখ ইবনে বাজৰ চৰকাৰী ৱেবছাইটৰ পৰা। সমলবোৰ এপৰ ভিতৰতে খোল খায়; কিতাপ প্ৰথমবাৰ ডাউনলোড কৰিবলৈ ইণ্টাৰনেট লাগে।"
          }
        }
      }
    },
    "library_offline_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books you open are saved on this phone and open again without internet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكتب التي تفتحها تُحفظ على هذا الجهاز وتُفتح لاحقًا دون إنترنت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جو کتابیں آپ کھولتے ہیں وہ اسی فون پر محفوظ رہتی ہیں اور بعد میں انٹرنیٹ کے بغیر کھلتی ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açtığınız kitaplar bu telefona kaydedilir ve sonra internetsiz açılır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buku yang Anda buka disimpan di ponsel ini dan bisa dibuka lagi tanpa internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les livres ouverts sont enregistrés sur ce téléphone et se rouvrent hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los libros que abres se guardan en este teléfono y se vuelven a abrir sin internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытые книги сохраняются на этом телефоне и открываются снова без интернета."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার খোলা বইগুলো এই ফোনে সেভ হয় এবং ইন্টারনেট ছাড়াই আবার খোলে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کتاب‌هایی که باز می‌کنید روی این گوشی ذخیره می‌شوند و بدون اینترنت دوباره باز می‌شوند."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "کتاب‌هایی که باز می‌کنید روی این موبایل ذخیره می‌شوند و بدون انترنت دوباره باز می‌شوند."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打开的书籍会保存在此手机上，无需联网即可再次打开。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी खोली गई किताबें इस फ़ोन पर सेव हो जाती हैं और बिना इंटरनेट के फिर खुलती हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os livros que você abre ficam salvos neste celular e abrem de novo sem internet."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Littattafan da kuka buɗe ana ajiye su a wannan wayar kuma suna sake buɗewa ba tare da intanet ba."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Vitabu unavyofungua vinahifadhiwa kwenye simu hii na vinafunguka tena bila intaneti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga aklat na binubuksan mo ay nai-save sa teleponong ito at bumubukas muli nang walang internet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sách bạn mở được lưu trên điện thoại này và có thể mở lại mà không cần internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หนังสือที่คุณเปิดจะถูกบันทึกไว้ในโทรศัพท์นี้และเปิดซ้ำได้โดยไม่ต้องใช้อินเทอร์เน็ต"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សៀវភៅដែលអ្នកបើកត្រូវបានរក្សាទុកនៅលើទូរសព្ទនេះ ហើយបើកម្ដងទៀតបានដោយគ្មានអ៊ីនធឺណិត។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "سىز ئاچقان كىتابلار بۇ تېلېفوندا ساقلىنىدۇ ۋە تورسىزمۇ قايتا ئېچىلىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەو کتێبانەی دەیانکەیتەوە لەسەر ئەم مۆبایلە پاشەکەوت دەکرێن و بێ ئینتەرنێت دووبارە دەکرێنەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Knjige koje otvorite čuvaju se na ovom telefonu i ponovo se otvaraju bez interneta."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Књиге које отворите чувају се на овом телефону и поново се отварају без интернета."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Книгите што ги отворате се зачувуваат на овој телефон и повторно се отвораат без интернет."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A megnyitott könyvek a telefonon maradnak, és internet nélkül is újra megnyithatók."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Boeken die je opent worden op deze telefoon bewaard en openen weer zonder internet."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "თქვენ მიერ გახსნილი წიგნები ამ ტელეფონზე ინახება და ინტერნეტის გარეშეც გაიხსნება."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඔබ විවෘත කරන පොත් මෙම දුරකථනයේ සුරැකෙන අතර අන්තර්ජාලය නොමැතිව නැවත විවෘත වේ."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు తెరిచే పుస్తకాలు ఈ ఫోన్‌లో సేవ్ అవుతాయి, ఇంటర్నెట్ లేకుండా మళ్లీ తెరుచుకుంటాయి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ನೀವು ತೆರೆಯುವ ಪುಸ್ತಕಗಳು ಈ ಫೋನ್‌ನಲ್ಲಿ ಉಳಿಸಲ್ಪಡುತ್ತವೆ ಮತ್ತು ಇಂಟರ್ನೆಟ್ ಇಲ್ಲದೆ ಮತ್ತೆ ತೆರೆಯುತ್ತವೆ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "നിങ്ങൾ തുറക്കുന്ന പുസ്തകങ്ങൾ ഈ ഫോണിൽ സേവ് ചെയ്യപ്പെടും, ഇന്റർനെറ്റ് ഇല്ലാതെ വീണ്ടും തുറക്കാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही उघडलेली पुस्तके या फोनवर सेव्ह होतात आणि इंटरनेटशिवाय पुन्हा उघडतात."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમે ખોલેલાં પુસ્તકો આ ફોન પર સેવ થાય છે અને ઇન્ટરનેટ વગર ફરી ખૂલે છે."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਜੋ ਕਿਤਾਬਾਂ ਤੁਸੀਂ ਖੋਲ੍ਹਦੇ ਹੋ ਉਹ ਇਸ ਫ਼ੋਨ ’ਤੇ ਸੰਭਾਲੀਆਂ ਜਾਂਦੀਆਂ ਹਨ ਅਤੇ ਇੰਟਰਨੈੱਟ ਤੋਂ ਬਿਨਾਂ ਦੁਬਾਰਾ ਖੁੱਲ੍ਹਦੀਆਂ ਹਨ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপুনি খোলা কিতাপবোৰ এই ফোনত ছেভ হয় আৰু ইণ্টাৰনেট অবিহনে পুনৰ খোল খায়।"
          }
        }
      }
    },

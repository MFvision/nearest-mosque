    "qibla_no_sensor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No live compass available. Face %1$@° clockwise from north."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر بوصلة حيّة. اتجه %1$@° باتجاه عقارب الساعة من الشمال."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زندہ قطب نما دستیاب نہیں۔ شمال سے گھڑی کی سمت %1$@° رخ کریں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı pusula yok. Kuzeyden saat yönünde %1$@° dönün."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompas langsung tidak tersedia. Hadap %1$@° searah jarum jam dari utara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de boussole en direct. Orientez-vous à %1$@° dans le sens horaire depuis le nord."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay brújula en vivo. Oriéntate %1$@° en sentido horario desde el norte."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Компас недоступен. Повернитесь на %1$@° по часовой стрелке от севера."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ কম্পাস নেই। উত্তর থেকে ঘড়ির কাঁটার দিকে %1$@° মুখ করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قطب‌نمای زنده در دسترس نیست. %1$@° از شمال در جهت عقربه‌های ساعت بایستید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "قطب‌نمای زنده در دسترس نیست. %1$@° از شمال در جهت عقربه‌های ساعت بایستید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可用的实时指南针。请从北方顺时针转 %1$@°。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव कम्पास उपलब्ध नहीं। उत्तर से घड़ी की दिशा में %1$@° की ओर रुख़ करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bússola ao vivo indisponível. Volte-se %1$@° no sentido horário a partir do norte."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu kamfas mai aiki kai tsaye. Fuskanci %1$@° bisa jujjuyawar agogo daga arewa."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna dira hai. Elekea %1$@° kwa mwelekeo wa saa kutoka kaskazini."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang live na compass. Humarap nang %1$@° pakanan mula sa hilaga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có la bàn trực tiếp. Hãy quay %1$@° theo chiều kim đồng hồ từ hướng bắc."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเข็มทิศแบบเรียลไทม์ ให้หันไป %1$@° ตามเข็มนาฬิกาจากทิศเหนือ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានត្រីវិស័យផ្ទាល់ទេ។ សូមបែរ %1$@° តាមទិសទ្រនិចនាឡិកាពីទិសខាងជើង។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "جانلىق كومپاس يوق. شىمالدىن سائەت ئىسترېلكىسى يۆنىلىشى بويىچە %1$@° تەرەپكە يۈزلىنىڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "قیبلەنمای ڕاستەوخۆ بەردەست نییە. %1$@° لە باکوورەوە بە ئاراستەی میلی کاتژمێر ڕوو بکە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompas uživo nije dostupan. Okrenite se %1$@° u smjeru kazaljke na satu od sjevera."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Компас уживо није доступан. Окрените се %1$@° у смеру казаљке на сату од севера."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нема компас во живо. Свртете се %1$@° во насока на стрелките на часовникот од север."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs élő iránytű. Fordulj északtól az óramutató járásával megegyezően %1$@°-ot."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen live kompas beschikbaar. Richt je %1$@° met de klok mee vanaf het noorden."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ცოცხალი კომპასი მიუწვდომელია. მიბრუნდით %1$@°-ით საათის ისრის მიმართულებით ჩრდილოეთიდან."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "සජීවී මාලිමාවක් නැත. උතුරේ සිට දක්ෂිණාවර්තව %1$@° දෙසට මුහුණලන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "లైవ్ దిక్సూచి అందుబాటులో లేదు. ఉత్తరం నుండి సవ్యదిశలో %1$@° వైపు తిరగండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲೈವ್ ದಿಕ್ಸೂಚಿ ಲಭ್ಯವಿಲ್ಲ. ಉತ್ತರದಿಂದ ಪ್ರದಕ್ಷಿಣಾಕಾರವಾಗಿ %1$@° ಕಡೆಗೆ ಮುಖ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ലൈവ് കോമ്പസ് ലഭ്യമല്ല. വടക്കിൽ നിന്ന് ഘടികാരദിശയിൽ %1$@° നേരെ തിരിയുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव्ह होकायंत्र उपलब्ध नाही. उत्तरेपासून घड्याळाच्या दिशेने %1$@° कडे तोंड करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "લાઇવ હોકાયંત્ર ઉપલબ્ધ નથી. ઉત્તરથી ઘડિયાળની દિશામાં %1$@° તરફ મોં કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਲਾਈਵ ਕੰਪਾਸ ਉਪਲਬਧ ਨਹੀਂ। ਉੱਤਰ ਤੋਂ ਘੜੀ ਦੀ ਦਿਸ਼ਾ ਵਿੱਚ %1$@° ਵੱਲ ਮੂੰਹ ਕਰੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ কম্পাছ উপলব্ধ নহয়। উত্তৰৰ পৰা ঘড়ীৰ কাঁটাৰ দিশত %1$@°লৈ মুখ কৰক।"
          }
        }
      }
    },

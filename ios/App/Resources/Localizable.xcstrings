        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಲೈವ್ ದಿಕ್ಸೂಚಿ ಇಲ್ಲ: ಚಿನ್ನದ ಚುಕ್ಕೆ ಉತ್ತರದಿಂದ ಕಿಬ್ಲಾವನ್ನು ತೋರಿಸುತ್ತದೆ"

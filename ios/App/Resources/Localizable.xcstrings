    "library_saved_empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the bookmark on any item to keep it here."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على علامة الحفظ في أي مادة لتجدها هنا."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی بھی مواد پر بک مارک دبائیں تاکہ وہ یہاں محفوظ رہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir öğeyi burada tutmak için yer işaretine dokunun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk penanda pada materi apa pun untuk menyimpannya di sini."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le signet d’un contenu pour le garder ici."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca el marcador de cualquier contenido para guardarlo aquí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на закладку у любого материала, чтобы сохранить его здесь."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোনো লেখা এখানে রাখতে তার বুকমার্কে ট্যাপ করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی نشانک هر مورد بزنید تا اینجا نگه داشته شود."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "روی نشانک هر مورد بزنید تا اینجا نگه داشته شود."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按任意内容上的书签，即可将其保存在这里。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी चीज़ को यहाँ रखने के लिए उसके बुकमार्क पर टैप करें।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no marcador de qualquer item para guardá-lo aqui."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Taɓa alamar ajiya a kan kowane abu don ajiye shi a nan."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa alama ya kuhifadhi kwenye kipengee chochote ili kukiweka hapa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang bookmark sa anumang item para itago ito rito."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào dấu trang trên bất kỳ mục nào để giữ nó ở đây."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะที่บุ๊กมาร์กของรายการใดก็ได้เพื่อเก็บไว้ที่นี่"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចុចចំណាំលើធាតុណាមួយ ដើម្បីរក្សាវាទុកនៅទីនេះ។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "ھەر قانداق مەزمۇننىڭ خەتكۈچىنى چېكىپ ئۇنى بۇ يەردە ساقلاڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "لەسەر نیشانەی هەر بابەتێک دەست بدە بۆ ئەوەی لێرە بمێنێتەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite oznaku na bilo kojem sadržaju da ga sačuvate ovdje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Додирните обележивач на било ком садржају да га сачувате овде."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допрете го обележувачот на кој било материјал за да го чувате овде."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppints bármelyik anyag könyvjelzőjére, hogy itt megőrizd."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de bladwijzer bij een item om het hier te bewaren."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "შეეხეთ სანიშნეს ნებისმიერ მასალაზე, რომ აქ შეინახოთ."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ඕනෑම අයිතමයක් මෙහි තබා ගැනීමට එහි පිටු සලකුණ තට්ටු කරන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఏదైనా అంశాన్ని ఇక్కడ ఉంచడానికి దానిపై ఉన్న బుక్‌మార్క్‌ను నొక్కండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಯಾವುದೇ ಅಂಶವನ್ನು ಇಲ್ಲಿ ಇರಿಸಲು ಅದರ ಬುಕ್‌ಮಾರ್ಕ್ ಅನ್ನು ಟ್ಯಾಪ್ ಮಾಡಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഏത് ഇനവും ഇവിടെ സൂക്ഷിക്കാൻ അതിലെ ബുക്ക്മാർക്കിൽ ടാപ്പ് ചെയ്യുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणतेही साहित्य इथे ठेवण्यासाठी त्याच्या बुकमार्कवर टॅप करा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "કોઈ પણ સામગ્રી અહીં રાખવા માટે તેના બુકમાર્ક પર ટૅપ કરો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਕਿਸੇ ਵੀ ਚੀਜ਼ ਨੂੰ ਇੱਥੇ ਰੱਖਣ ਲਈ ਉਸ ਦੇ ਬੁੱਕਮਾਰਕ ’ਤੇ ਟੈਪ ਕਰੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "যিকোনো সমল ইয়াত ৰাখিবলৈ তাৰ বুকমাৰ্কত টেপ কৰক।"
          }
        }
      }
    },

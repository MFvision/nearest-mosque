        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo aqui funciona sem internet."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duk abin da ke nan yana aiki ba tare da intanet ba."

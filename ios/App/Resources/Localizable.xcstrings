    "method_suggested": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggested for this region. You can change it."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقترحة لهذه المنطقة، ويمكنك تغييرها."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس علاقے کے لیے تجویز کردہ، آپ بدل سکتے ہیں۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bölge için önerilir. Değiştirebilirsiniz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disarankan untuk wilayah ini. Anda dapat mengubahnya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggérée pour cette région. Vous pouvez la changer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerido para esta región. Puedes cambiarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рекомендуется для этого региона. Можно изменить."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অঞ্চলের জন্য প্রস্তাবিত। আপনি এটি বদলাতে পারেন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشنهادی برای این منطقه. می‌توانید آن را تغییر دهید."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشنهادی برای این ساحه. می‌توانید آن را تغییر دهید."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此地区推荐，你可以更改。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस क्षेत्र के लिए सुझाया गया। आप इसे बदल सकते हैं।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerido para esta região. Você pode alterá-lo."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An ba da shawarar ta ga wannan yanki. Kuna iya canza ta."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Inapendekezwa kwa eneo hili. Unaweza kuibadilisha."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iminumungkahi para sa rehiyong ito. Maaari mo itong baguhin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được đề xuất cho khu vực này. Bạn có thể thay đổi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แนะนำสำหรับภูมิภาคนี้ คุณเปลี่ยนได้"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានណែនាំសម្រាប់តំបន់នេះ។ អ្នកអាចប្ដូរវាបាន។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ رايونغا تەۋسىيە قىلىنغان. ئۆزگەرتسىڭىز بولىدۇ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "پێشنیارکراوە بۆ ئەم ناوچەیە. دەتوانیت بیگۆڕیت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Predloženo za ovu regiju. Možete je promijeniti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложено за овај регион. Можете га променити."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложено за овој регион. Можете да го промените."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez a régióhoz javasolt. Módosíthatod."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanbevolen voor deze regio. Je kunt het wijzigen."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "რეკომენდებულია ამ რეგიონისთვის. შეგიძლიათ შეცვალოთ."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මෙම කලාපයට යෝජිතයි. ඔබට එය වෙනස් කළ හැක."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ప్రాంతానికి సూచించబడింది. మీరు దీన్ని మార్చవచ్చు."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಈ ಪ್ರದೇಶಕ್ಕೆ ಸೂಚಿಸಲಾಗಿದೆ. ನೀವು ಇದನ್ನು ಬದಲಿಸಬಹುದು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ഈ പ്രദേശത്തിന് നിർദ്ദേശിച്ചത്. നിങ്ങൾക്ക് ഇത് മാറ്റാം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या प्रदेशासाठी सुचवलेली. तुम्ही ती बदलू शकता."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આ પ્રદેશ માટે સૂચવેલ. તમે તેને બદલી શકો છો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਇਸ ਖੇਤਰ ਲਈ ਸੁਝਾਇਆ ਗਿਆ। ਤੁਸੀਂ ਇਸ ਨੂੰ ਬਦਲ ਸਕਦੇ ਹੋ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অঞ্চলৰ বাবে পৰামৰ্শ দিয়া। আপুনি ইয়াক সলনি কৰিব পাৰে।"
          }
        }
      }
    },

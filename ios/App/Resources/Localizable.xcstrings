            "value": "നിങ്ങളിൽ നിന്ന് 25 കി.മീ. ഉള്ളിൽ രേഖപ്പെടുത്തിയ പള്ളിയില്ല."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्यापासून 25 किमीमध्ये कोणतीही मशीद नोंदलेली नाही."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "તમારાથી 25 કિમીમાં કોઈ મસ્જિદ નોંધાયેલી નથી."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਤੁਹਾਡੇ ਤੋਂ 25 ਕਿਮੀ ਅੰਦਰ ਕੋਈ ਮਸਜਿਦ ਦਰਜ ਨਹੀਂ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "আপোনাৰ 25 কিমিৰ ভিতৰত কোনো মছজিদ নথিভুক্ত নাই।"
          }
        }
      }
    },
    "siri_nearest_open_app": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Near Mosque once so it can find mosques near you."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح تطبيق أقرب مسجد مرة ليجد المساجد القريبة منك."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک بار قریبی مسجد کھولیں تاکہ یہ آپ کے قریب مساجد تلاش کر سکے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yakınınızdaki camileri bulabilmesi için Near Mosque’u bir kez açın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Near Mosque sekali agar dapat menemukan masjid di dekat Anda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Near Mosque une fois pour qu’elle trouve les mosquées proches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Near Mosque una vez para que encuentre las mezquitas cercanas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Near Mosque один раз, чтобы найти мечети рядом."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাছের মসজিদ খুঁজতে একবার Near Mosque খুলুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک بار نزدیک‌ترین مسجد را باز کنید تا مسجدهای نزدیک شما را پیدا کند."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "یک بار نزدیک‌ترین مسجد را باز کنید تا مسجدهای نزدیک شما را پیدا کند."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先打开一次 Near Mosque，以便查找附近的清真寺。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार Near Mosque खोलें ताकि यह आपके पास की मस्जिदें ढूँढ सके।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Near Mosque uma vez para encontrar mesquitas perto de você."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bude Near Mosque sau ɗaya don ya nemo masallatai kusa da ku."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua Near Mosque mara moja ili ipate misikiti iliyo karibu nawe."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang Near Mosque nang isang beses para mahanap ang mga masjid malapit sa iyo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy mở Near Mosque một lần để ứng dụng tìm nhà thờ Hồi giáo gần bạn."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Near Mosque หนึ่งครั้งเพื่อค้นหามัสยิดใกล้คุณ"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បើក Near Mosque ម្ដង ដើម្បីស្វែងរកវិហារឥស្លាមនៅជិតអ្នក។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "يېقىندىكى مەسچىتلەرنى تېپىش ئۈچۈن ئەڭ يېقىن مەسچىت نى بىر قېتىم ئېچىڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "جارێک نزیکترین مزگەوت بکەرەوە بۆ ئەوەی مزگەوتە نزیکەکان بدۆزێتەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite Near Mosque jednom da pronađe džamije u blizini."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворите Near Mosque једном да пронађе џамије у близини."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворете го Near Mosque еднаш за да ги најде блиските џамии."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg egyszer a Near Mosque-ot, hogy megtalálja a közeli mecseteket."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Near Mosque één keer zodat het moskeeën bij u kan vinden."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ერთხელ გახსენით Near Mosque, რომ ახლომდებარე მეჩეთები იპოვოს."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "ළඟ පල්ලි සොයා ගැනීමට Near Mosque එක් වරක් විවෘත කරන්න."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దగ్గరి మసీదులు కనుగొనడానికి Near Mosque ను ఒకసారి తెరవండి."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಹತ್ತಿರದ ಮಸೀದಿಗಳನ್ನು ಹುಡುಕಲು Near Mosque ಅನ್ನು ಒಮ್ಮೆ ತೆರೆಯಿರಿ."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "അടുത്തുള്ള പള്ളികൾ കണ്ടെത്താൻ Near Mosque ഒരിക്കൽ തുറക്കുക."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जवळच्या मशिदी शोधण्यासाठी Near Mosque एकदा उघडा."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "નજીકની મસ્જિદો શોધવા માટે Near Mosque એક વાર ખોલો."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਨੇੜਲੀਆਂ ਮਸਜਿਦਾਂ ਲੱਭਣ ਲਈ ਇੱਕ ਵਾਰ Near Mosque ਖੋਲ੍ਹੋ।"

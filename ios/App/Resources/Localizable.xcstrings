        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потсетниците се поставени за следните %1$lld дена. Отворајте ја апликацијата од време на време за да продолжат."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emlékeztetők a következő %1$lld napra vannak beállítva. Időnként nyisd meg az alkalmazást, hogy folytatódjanak."

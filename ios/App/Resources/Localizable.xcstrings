        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những đoạn này khớp nhất với câu hỏi của bạn. Hãy đọc chúng trong ngữ cảnh trước khi rút ra kết luận."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความเหล่านี้ตรงกับคำถามของคุณมากที่สุด อ่านในบริบทก่อนสรุป"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អត្ថបទទាំងនេះត្រូវនឹងសំណួររបស់អ្នកជាងគេ។ សូមអានវាក្នុងបរិបទ មុននឹងសន្និដ្ឋាន។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "بۇ ئۈزۈندىلەر سوئالىڭىزغا ئەڭ ماس كېلىدۇ. خۇلاسە چىقىرىشتىن بۇرۇن ئۇلارنى ئەسلى مەزمۇنىدا ئوقۇڭ."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ئەم دەقانە زۆرترین گونجانیان لەگەڵ پرسیارەکەت هەیە. پێش گەیشتن بە ئەنجام، لە شوێنی خۆیاندا بیانخوێنەرەوە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovi odlomci najbolje odgovaraju vašem pitanju. Pročitajte ih u kontekstu prije nego što donesete zaključak."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ови одломци најбоље одговарају вашем питању. Прочитајте их у контексту пре него што донесете закључак."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Овие одломки најдобро одговараат на вашето прашање. Прочитајте ги во контекст пред да донесете заклучок."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezek a részletek felelnek meg leginkább a kérdésednek. Mielőtt következtetést vonsz le, olvasd el őket a szövegkörnyezetükben."
          }

    "external_maps_note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Directions open in your maps app. Turn-by-turn needs that app and usually internet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح الاتجاهات في تطبيق الخرائط، والملاحة خطوة بخطوة تحتاج ذلك التطبيق وغالبًا الإنترنت."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "راستہ آپ کی میپس ایپ میں کھلے گا۔ قدم بہ قدم رہنمائی کے لیے وہ ایپ اور عموماً انٹرنیٹ درکار ہے۔"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yol tarifi harita uygulamanızda açılır. Adım adım yönlendirme o uygulamayı ve genellikle internet gerektirir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Petunjuk arah terbuka di aplikasi peta Anda. Navigasi belokan perlu aplikasi itu dan biasanya internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’itinéraire s’ouvre dans votre app de cartes, qui demande souvent internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las indicaciones se abren en tu app de mapas, que suele necesitar internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Маршрут откроется в приложении карт. Для пошаговой навигации нужно это приложение и обычно интернет."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পথনির্দেশ আপনার ম্যাপ অ্যাপে খোলে। ধাপে ধাপে নির্দেশনার জন্য সেই অ্যাপ এবং সাধারণত ইন্টারনেট লাগে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسیریابی در برنامه نقشه شما باز می‌شود. راهنمای گام‌به‌گام به آن برنامه و معمولاً اینترنت نیاز دارد."
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "مسیریابی در برنامه نقشه شما باز می‌شود. راهنمای گام‌به‌گام به آن برنامه و معمولاً انترنت نیاز دارد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路线会在你的地图应用中打开。逐向导航需要该应用，通常也需要联网。"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रास्ता आपके मैप ऐप में खुलता है। मोड़-दर-मोड़ निर्देशों के लिए वह ऐप और आम तौर पर इंटरनेट चाहिए।"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As rotas abrem no seu app de mapas. A navegação passo a passo precisa desse app e, geralmente, de internet."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwatance suna buɗewa a manhajar taswirarku. Jagora mataki-mataki yana buƙatar wannan manhaja kuma yawanci intanet."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maelekezo yanafunguka kwenye programu yako ya ramani. Maelekezo ya hatua kwa hatua yanahitaji programu hiyo na kwa kawaida intaneti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bubukas ang direksyon sa iyong maps app. Kailangan ng app na iyon at kadalasan ng internet para sa turn-by-turn."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ đường sẽ mở trong ứng dụng bản đồ của bạn. Dẫn đường từng chặng cần ứng dụng đó và thường cần internet."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นทางจะเปิดในแอปแผนที่ของคุณ การนำทางทีละขั้นต้องใช้แอปนั้นและมักต้องใช้อินเทอร์เน็ต"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ផ្លូវទៅនឹងបើកនៅក្នុងកម្មវិធីផែនទីរបស់អ្នក។ ការណែនាំផ្លូវមួយជំហានម្ដងៗត្រូវការកម្មវិធីនោះ ហើយជាធម្មតាត្រូវការអ៊ីនធឺណិត។"
          }
        },
        "ug": {
          "stringUnit": {
            "state": "translated",
            "value": "يول كۆرسىتىش خەرىتە ئەپىڭىزدە ئېچىلىدۇ. قەدەممۇقەدەم يول باشلاش ئۈچۈن شۇ ئەپ ۋە ئادەتتە تور كېرەك."
          }
        },
        "ckb": {
          "stringUnit": {
            "state": "translated",
            "value": "ڕێنمایی ڕێگا لە ئەپی نەخشەکەتدا دەکرێتەوە. ڕێنمایی هەنگاو بە هەنگاو پێویستی بەو ئەپە و زۆربەی کات ئینتەرنێت هەیە."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upute se otvaraju u aplikaciji za mape. Navigacija korak po korak zahtijeva tu aplikaciju i obično internet."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Упутства се отварају у апликацији за мапе. Навигација корак по корак захтева ту апликацију и обично интернет."
          }
        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Насоките се отвораат во вашата апликација за мапи. За навигација чекор по чекор е потребна таа апликација и обично интернет."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az útvonal a térképalkalmazásodban nyílik meg. A részletes navigációhoz az az alkalmazás és általában internet kell."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De route opent in je kaarten-app. Stapsgewijze navigatie vereist die app en meestal internet."
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "მარშრუტი გაიხსნება თქვენს რუკების აპში. ნაბიჯ-ნაბიჯ ნავიგაციას ეს აპი და, როგორც წესი, ინტერნეტი სჭირდება."
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "මඟ ඔබේ සිතියම් යෙදුමේ විවෘත වේ. පියවරෙන් පියවර මඟ පෙන්වීමට එම යෙදුම සහ සාමාන්‍යයෙන් අන්තර්ජාලය අවශ්‍යයි."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దారి మీ మ్యాప్స్ యాప్‌లో తెరుచుకుంటుంది. మలుపు-మలుపు నావిగేషన్‌కు ఆ యాప్, సాధారణంగా ఇంటర్నెట్ అవసరం."
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ದಾರಿ ನಿಮ್ಮ ನಕ್ಷೆ ಆ್ಯಪ್‌ನಲ್ಲಿ ತೆರೆಯುತ್ತದೆ. ತಿರುವು-ತಿರುವಿನ ಮಾರ್ಗದರ್ಶನಕ್ಕೆ ಆ ಆ್ಯಪ್ ಮತ್ತು ಸಾಮಾನ್ಯವಾಗಿ ಇಂಟರ್ನೆಟ್ ಬೇಕು."
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "വഴി നിങ്ങളുടെ മാപ്പ് ആപ്പിൽ തുറക്കും. ടേൺ-ബൈ-ടേൺ നിർദ്ദേശങ്ങൾക്ക് ആ ആപ്പും സാധാരണയായി ഇന്റർനെറ്റും വേണം."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "रस्ता तुमच्या मॅप ॲपमध्ये उघडतो. वळणानुसार मार्गदर्शनासाठी ते ॲप आणि सहसा इंटरनेट लागते."
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "રસ્તો તમારી મેપ ઍપમાં ખૂલે છે. વળાંક-દર-વળાંક માર્ગદર્શન માટે તે ઍપ અને સામાન્ય રીતે ઇન્ટરનેટ જોઈએ."
          }
        },
        "pa": {
          "stringUnit": {
            "state": "translated",
            "value": "ਰਸਤਾ ਤੁਹਾਡੀ ਨਕਸ਼ਾ ਐਪ ਵਿੱਚ ਖੁੱਲ੍ਹੇਗਾ। ਮੋੜ-ਦਰ-ਮੋੜ ਰਹਿਨੁਮਾਈ ਲਈ ਉਹ ਐਪ ਅਤੇ ਆਮ ਤੌਰ ’ਤੇ ਇੰਟਰਨੈੱਟ ਚਾਹੀਦਾ ਹੈ।"
          }
        },
        "as": {
          "stringUnit": {
            "state": "translated",
            "value": "পথ নিৰ্দেশনা আপোনাৰ মেপ এপত খোল খায়। খোজে খোজে নিৰ্দেশনাৰ বাবে সেই এপ আৰু সাধাৰণতে ইণ্টাৰনেট লাগে।"
          }
        }
      }
    },
    "fajr_ends_at_sunrise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fajr time ends at sunrise, %1$@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتهي وقت الفجر عند الشروق، %1$@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فجر کا وقت طلوعِ آفتاب پر ختم، %1$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmsak vakti güneş doğunca biter, %1$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu Subuh berakhir saat terbit, %1$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps du Fajr finit au lever du soleil, %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de Fajr termina al amanecer, %1$@"

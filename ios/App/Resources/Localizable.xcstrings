        },
        "mk": {
          "stringUnit": {
            "state": "translated",
            "value": "Времиња за намаз што го следат небото"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az eget követő imaidők"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebedstijden die de hemel volgen"
          }
        },
        "ka": {
          "stringUnit": {
            "state": "translated",
            "value": "ლოცვის დროები, რომლებიც ცას მიჰყვება"
          }
        },
        "si": {
          "stringUnit": {
            "state": "translated",
            "value": "අහස අනුගමනය කරන සලාත වේලාවන්"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆకాశాన్ని అనుసరించే నమాజ్ సమయాలు"
          }
        },
        "kn": {
          "stringUnit": {
            "state": "translated",
            "value": "ಆಕಾಶವನ್ನು ಅನುಸರಿಸುವ ನಮಾಜ್ ಸಮಯಗಳು"
          }
        },
        "ml": {
          "stringUnit": {
            "state": "translated",
            "value": "ആകാശത്തെ പിന്തുടരുന്ന നമസ്കാര സമയങ്ങൾ"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आकाशासोबत चालणाऱ्या नमाजच्या वेळा"
          }
        },
        "gu": {
          "stringUnit": {
            "state": "translated",
            "value": "આકાશ સાથે ચાલતા નમાઝના સમય"

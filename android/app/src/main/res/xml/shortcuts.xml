<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: open the Qibla, Ask AI or Nearest Mosque directly. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="qibla" android:enabled="true" android:icon="@drawable/ic_tab_prayer"
        android:shortcutShortLabel="@string/qibla">
        <intent android:action="android.intent.action.VIEW" android:data="nearmosque://qibla"
            android:targetPackage="sa.zood.nearmosque" android:targetClass="sa.zood.nearmosque.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="mosques" android:enabled="true" android:icon="@drawable/ic_tab_mosque"
        android:shortcutShortLabel="@string/tab_mosques">
        <intent android:action="android.intent.action.VIEW" android:data="nearmosque://mosques"
            android:targetPackage="sa.zood.nearmosque" android:targetClass="sa.zood.nearmosque.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="ask" android:enabled="true" android:icon="@drawable/ic_sparkle"
        android:shortcutShortLabel="@string/tab_ask">
        <intent android:action="android.intent.action.VIEW" android:data="nearmosque://ask"
            android:targetPackage="sa.zood.nearmosque" android:targetClass="sa.zood.nearmosque.MainActivity" />
    </shortcut>
</shortcuts>

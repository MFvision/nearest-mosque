<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup: nothing from the database or app files (settings with the chosen location, downloads, saved
     chats). Moving to a new phone of your own (device transfer) brings the settings and downloads along, but not the
     database or saved Ask chats. Built-in packs are reinstalled on first launch. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <!-- Saved Ask chats stay on this phone. -->
        <exclude domain="file" path="chats.json" />
    </device-transfer>
</data-extraction-rules>

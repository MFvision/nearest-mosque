<?xml version="1.0" encoding="utf-8"?>
<!-- Countdown bar of the widgets (track and fill). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="#33FFFFFF" /><corners android:radius="4dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <clip><shape><solid android:color="#FFD4A843" /><corners android:radius="4dp" /></shape></clip>
    </item>
</layer-list>

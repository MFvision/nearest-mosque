<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NMWidgetText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">#FF1F3B57</item>
    </style>
    <style name="NMWidgetText.City">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="NMWidgetText.Name">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="NMWidgetText.Time">
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="NMWidgetText.Countdown">
        <item name="android:textSize">17sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="NMWidgetRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
    <style name="NMWidgetText.RowName">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">13sp</item>
    </style>
    <style name="NMWidgetText.RowTime">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="NMWidgetRow.Large">
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>
    <style name="NMWidgetText.RowName.Large">
        <item name="android:textSize">15sp</item>
    </style>
    <style name="NMWidgetText.RowTime.Large">
        <item name="android:textSize">15sp</item>
    </style>
    <style name="NMWidgetText.RingName">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="NMWidgetText.RingTime">
        <item name="android:textSize">36sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="NMWidgetText.TimeMedium" parent="NMWidgetText.Time">
        <item name="android:textSize">26sp</item>
    </style>
    <style name="NMWidgetText.Small">
        <item name="android:textSize">11sp</item>
    </style>
    <style name="NMWidgetText.Date">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="NMWidgetText.Big">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="NMWidgetText.Chip">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
    </style>
    <style name="NMWidgetText.TileName">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="NMWidgetText.TileTime">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="NMWidgetText.TileMark">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
